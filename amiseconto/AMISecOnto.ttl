@prefix : <http://www.semanticweb.org/AMISecOnto#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/AMISecOnto#> .

<http://www.semanticweb.org/AMISecOnto> rdf:type owl:Ontology ;
                                         owl:imports <https://raw.githubusercontent.com/bohlourenco/AMISecOnto/refs/heads/main/amiseconto/AMISecOnto-alignments.ttl> ;
                                         dct:created "2025-10-01"^^xsd:date ;
                                         dct:creator [ rdf:type <http://xmlns.com/foaf/0.1/Person> ;
                                                       rdfs:seeAlso <https://orcid.org/0009-0005-9077-2040> ;
                                                       <http://xmlns.com/foaf/0.1/name> "Bruno Lourenço"
                                                     ] ,
                                                     [ rdf:type <http://xmlns.com/foaf/0.1/Person> ;
                                                       rdfs:seeAlso <https://orcid.org/0000-0001-6074-3074> ;
                                                       <http://xmlns.com/foaf/0.1/name> "Cátia Vaz"
                                                     ] ,
                                                     [ rdf:type <http://xmlns.com/foaf/0.1/Person> ;
                                                       rdfs:seeAlso <https://orcid.org/0000-0003-4852-1641> ;
                                                       <http://xmlns.com/foaf/0.1/name> "Alexandre P. Francisco"
                                                     ] ,
                                                     [ rdf:type <http://xmlns.com/foaf/0.1/Person> ;
                                                       rdfs:seeAlso <https://orcid.org/0000-0002-4049-1954> ;
                                                       <http://xmlns.com/foaf/0.1/name> "Pedro Adão"
                                                     ] ,
                                                     [ rdf:type <http://xmlns.com/foaf/0.1/Person> ;
                                                       rdfs:seeAlso <https://orcid.org/0000-0001-6091-2624> ;
                                                       <http://xmlns.com/foaf/0.1/name> "Antonio Goncalves"
                                                     ] ,
                                                     [ rdf:type <http://xmlns.com/foaf/0.1/Person> ;
                                                       rdfs:seeAlso <https://orcid.org/0000-0001-7153-6716> ;
                                                       <http://xmlns.com/foaf/0.1/name> "Mario Marques"
                                                     ] ,
                                                     [ rdf:type <http://xmlns.com/foaf/0.1/Person> ;
                                                       rdfs:seeAlso <https://orcid.org/0000-0002-6612-9013> ;
                                                       <http://xmlns.com/foaf/0.1/name> "João F. Ferreira"
                                                     ] ;
                                         dct:license <https://creativecommons.org/licenses/by/4.0/> ;
                                         dct:modified "2026-05-05"^^xsd:date ;
                                         dct:publisher <https://tecnico.ulisboa.pt/pt/> ;
                                         dct:version "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dct:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dct:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dct:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dct:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
dct:publisher rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/version
dct:version rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
<http://xmlns.com/foaf/0.1/name> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/AMISecOnto#affectsSystem
:affectsSystem rdf:type owl:ObjectProperty ;
               rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
               rdfs:range <http://www.semanticweb.org/AMISecOnto/System> ;
               rdfs:comment "Relates a Vulnerability to a Software System that it affects, based on vulnerabilities identified in artifacts that represent the system."@en ;
               rdfs:label "affects system"@en .


###  http://www.semanticweb.org/AMISecOnto#belongsToLog
:belongsToLog rdf:type owl:ObjectProperty ;
              rdfs:domain :RiskAssessment ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :Log
                                         <http://www.semanticweb.org/AMISecOnto/LogEvent>
                                       )
                         ] ;
              rdfs:comment "Relates a log event to the log in which it is recorded."@en ;
              rdfs:label "belongs to log"@en .


###  http://www.semanticweb.org/AMISecOnto#belongsToModule
:belongsToModule rdf:type owl:ObjectProperty ;
                 rdfs:domain <http://www.semanticweb.org/AMISecOnto/Dependency> ;
                 rdfs:range :Module ;
                 rdfs:comment "Relates a dependency (e.g., package, library, or component) to the module it is part of."@en ;
                 rdfs:label "belongs to module"@en .


###  http://www.semanticweb.org/AMISecOnto#belongsToRequest
:belongsToRequest rdf:type owl:ObjectProperty ;
                  rdfs:domain <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent> ;
                  rdfs:range :Request ;
                  rdfs:comment "Relates an application log event to the request that triggered or is associated with the event, representing the operational context in which the event occurred."@en ;
                  rdfs:label "belongs to request"@en .


###  http://www.semanticweb.org/AMISecOnto#configuredFor
:configuredFor rdf:type owl:ObjectProperty ;
               rdfs:domain <http://www.semanticweb.org/AMISecOnto/BuildConfiguration> ;
               rdfs:range <http://www.semanticweb.org/AMISecOnto/System> ;
               rdfs:comment "Specifies the system to which the configuration applies"@en ;
               rdfs:label "configured for"@en .


###  http://www.semanticweb.org/AMISecOnto#considers
:considers rdf:type owl:ObjectProperty ;
           rdfs:domain :RiskAssessment ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Threat
                                      <http://www.semanticweb.org/AMISecOnto/Vulnerability>
                                    )
                      ] ;
           rdfs:comment """Relates an assessment or analytical process to the entities it takes into account during evaluation. In cybersecurity, this property is typically used to link a RiskAssessment to relevant factors such as threats, vulnerabilities, assets, or contextual conditions that influence the determination of risk.

In the context of NIS2 compliance, considers ensures that risk assessments are comprehensive and account for all relevant elements required for effective risk management and resilience of network and information systems."""@en ;
           rdfs:label "considers"@en .


###  http://www.semanticweb.org/AMISecOnto#containsEvent
:containsEvent rdf:type owl:ObjectProperty ;
               rdfs:domain :Log ;
               rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
               rdfs:comment "Indicates that a log includes one or more log events, representing recorded activities or occurrences within a system for monitoring, auditing, and analysis."@en ;
               rdfs:label "contains event"@en .


###  http://www.semanticweb.org/AMISecOnto#correlatedWith
:correlatedWith rdf:type owl:ObjectProperty ;
                rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                rdfs:comment "Relates a Log Event to another Log Event that is contextually, temporally, or causally associated with it."@en ;
                rdfs:label "correlated with" .


###  http://www.semanticweb.org/AMISecOnto#declaresDependency
:declaresDependency rdf:type owl:ObjectProperty ;
                    rdfs:domain <http://www.semanticweb.org/AMISecOnto/Application> ;
                    rdfs:range <http://www.semanticweb.org/AMISecOnto/Dependency> ;
                    rdfs:comment "Relates an application to a dependency that it explicitly declares as required for its execution, build, or functionality."@en ;
                    rdfs:label "declares dependency"@en .


###  http://www.semanticweb.org/AMISecOnto#evidenceByLogEvent
:evidenceByLogEvent rdf:type owl:ObjectProperty ;
                    rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                    rdfs:range <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                    rdfs:comment "This property links a LogEvent to a Vulnerability when the log event provides evidence that the vulnerability exists, was exploited, or is related to suspicious behavior."@en ;
                    rdfs:label "has evidence by log event"@en .


###  http://www.semanticweb.org/AMISecOnto#executedInEnvironment
:executedInEnvironment rdf:type owl:ObjectProperty ;
                       rdfs:domain <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent> ;
                       rdfs:range :Environment ;
                       rdfs:comment "Relates an application log event to the environment in which the associated application execution occurred, such as an operating system, runtime environment, container, or computing platform."@en ;
                       rdfs:label "executed in environment"@en .


###  http://www.semanticweb.org/AMISecOnto#generates
:generates rdf:type owl:ObjectProperty ;
           rdfs:domain :Logger ;
           rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
           rdfs:comment "Relates a Logger to the LogEvent instances it produces during system execution. This property captures the generation of log records as a result of logging activities"@en ;
           rdfs:label "generates"@en .


###  http://www.semanticweb.org/AMISecOnto#hasClass
:hasClass rdf:type owl:ObjectProperty ;
          rdfs:domain :PackageLibrary ;
          rdfs:range :ClassSource ;
          rdfs:comment "Relates a package or software entity to its classification category within the ontology."@en ;
          rdfs:label "has class"@en .


###  http://www.semanticweb.org/AMISecOnto#hasConfiguration
:hasConfiguration rdf:type owl:ObjectProperty ;
                  rdfs:domain :Environment ;
                  rdfs:range <http://www.semanticweb.org/AMISecOnto/BuildConfiguration> ;
                  rdfs:comment "Links an environment to the configuration settings applied to it"@en ;
                  rdfs:label "has configuration"@en .


###  http://www.semanticweb.org/AMISecOnto#hasCurrentLogEvent
:hasCurrentLogEvent rdf:type owl:ObjectProperty ;
                    rdfs:domain :Log ;
                    rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                    rdfs:comment "Relates a Log to the LogEvent that is temporally the most recent and represents the current state of the log at the time of observation. This property identifies the active or latest event within the log’s event sequence."@en ;
                    rdfs:label "has current log event"@en .


###  http://www.semanticweb.org/AMISecOnto#hasFirstLogEvent
:hasFirstLogEvent rdf:type owl:ObjectProperty ;
                  rdfs:domain :Log ;
                  rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                  rdfs:comment "Relates a Log to the LogEvent that is temporally the earliest in its sequence. This property identifies the initial event recorded for the log, marking the starting point of the event timeline."@en ;
                  rdfs:label "has first log event"@en .


###  http://www.semanticweb.org/AMISecOnto#hasLog
:hasLog rdf:type owl:ObjectProperty ;
        rdfs:domain :Environment ;
        rdfs:range :Log ;
        rdfs:comment "Associates an environment with logs generated within it."@en ;
        rdfs:label "has log"@en .


###  http://www.semanticweb.org/AMISecOnto#hasLogger
:hasLogger rdf:type owl:ObjectProperty ;
           rdfs:domain :ClassSource ;
           rdfs:range :Logger ;
           rdfs:comment "Relates a software/system entity to the logger it uses to generate or manage log records"@en ;
           rdfs:label "has logger"@en .


###  http://www.semanticweb.org/AMISecOnto#hasNextCorrelatedEvent
:hasNextCorrelatedEvent rdf:type owl:ObjectProperty ;
                        rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                        rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                        rdfs:comment "Indicates that the current event is linked to a subsequent event that is contextually, causally, or temporally related."@en ;
                        rdfs:label "has next correlated event"@en .


###  http://www.semanticweb.org/AMISecOnto#hasOperatingSystem
:hasOperatingSystem rdf:type owl:ObjectProperty ;
                    rdfs:domain <http://www.semanticweb.org/AMISecOnto/System> ;
                    rdfs:range :OperatingSystem ;
                    rdfs:comment "Relates a system to the operating system it runs on or is configured with."@en ;
                    rdfs:label "has operating system"@en .


###  http://www.semanticweb.org/AMISecOnto#hasOutcome
:hasOutcome rdf:type owl:ObjectProperty ;
            rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
            rdfs:range :Outcome ;
            rdfs:comment "Relates a process, action, or event to the outcome that results from its execution."@en ;
            rdfs:label "has outcome"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPreviousCorrelatedEvent
:hasPreviousCorrelatedEvent rdf:type owl:ObjectProperty ;
                            rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                            rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                            rdfs:comment "Indicates that the current event is linked to an earlier event that is contextually, causally, or temporally related."@en ;
                            rdfs:label "has previous correlated event"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSource
:hasSource rdf:type owl:ObjectProperty ;
           rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :ClassSource
                                      :Process
                                      <http://www.semanticweb.org/AMISecOnto/Dependency>
                                    )
                      ] ;
           rdfs:comment "Relates a log event to the entity that generated or originated the event, such as a software component, process, dependency, or other source within the system."@en ;
           rdfs:label "has source"@en .


###  http://www.semanticweb.org/AMISecOnto#hosts
:hosts rdf:type owl:ObjectProperty ;
       rdfs:domain :Environment ;
       rdfs:range <http://www.semanticweb.org/AMISecOnto/System> ;
       rdfs:comment "The environment in which systems are deployed and executed"@en ;
       rdfs:label "hosts"@en .


###  http://www.semanticweb.org/AMISecOnto#identifies
:identifies rdf:type owl:ObjectProperty ;
            rdfs:domain :RiskAssessment ;
            rdfs:range :Risk ;
            rdfs:comment """Relates an assessment, analysis, or detection process to the entities it discovers, determines, or recognizes. In cybersecurity contexts, this property is typically used to link a RiskAssessment to the risks, threats, or vulnerabilities it uncovers during evaluation.
Within NIS2 compliance, identifies supports traceability and accountability by explicitly capturing which risks or issues have been recognized as part of risk management and security assessment processes."""@en ;
            rdfs:label "identifies"@en .


###  http://www.semanticweb.org/AMISecOnto#installedOn
:installedOn rdf:type owl:ObjectProperty ;
             rdfs:domain <http://www.semanticweb.org/AMISecOnto/SystemPackage> ;
             rdfs:range <http://www.semanticweb.org/AMISecOnto/System> ;
             rdfs:comment "Indicates that a software component, package, or application is installed on a specific system or host, supporting analysis of deployment context and vulnerability exposure."@en ;
             rdfs:label "installed on"@en .


###  http://www.semanticweb.org/AMISecOnto#isObservedInProject
:isObservedInProject rdf:type owl:ObjectProperty ;
                     rdfs:domain <http://www.semanticweb.org/AMISecOnto/Application> ;
                     rdfs:range <http://www.semanticweb.org/AMISecOnto/Project> ;
                     rdfs:comment "Relates an application to a project in which the application has been identified, used, or observed as a component, dependency, or deployed software artifact."@en ;
                     rdfs:label "is observed in project"@en .


###  http://www.semanticweb.org/AMISecOnto#mapsTo
:mapsTo rdf:type owl:ObjectProperty ;
        rdfs:domain <http://www.semanticweb.org/AMISecOnto/Dependency> ;
        rdfs:range <http://www.semanticweb.org/AMISecOnto/Product> ;
        rdfs:comment "Relates a dependency entity to the product it corresponds to or is resolved as, indicating that the dependency maps to a specific product representation."@en ;
        rdfs:label "maps to"@en .


###  http://www.semanticweb.org/AMISecOnto#mitigates
:mitigates rdf:type owl:ObjectProperty ;
           rdfs:domain :SecurityControl ;
           rdfs:range :Risk ;
           rdfs:label "mitigates"@en .


###  http://www.semanticweb.org/AMISecOnto#performedByUser
:performedByUser rdf:type owl:ObjectProperty ;
                 rdfs:domain :Request ;
                 rdfs:range <http://www.semanticweb.org/AMISecOnto/User> ;
                 rdfs:comment "Identifies the user responsible for initiating a request, enabling attribution of actions for auditing, monitoring, and security analysis."@en ;
                 rdfs:label "performed by user"@en .


###  http://www.semanticweb.org/AMISecOnto#producedBy
:producedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Log ;
            rdfs:range <http://www.semanticweb.org/AMISecOnto/System> ;
            rdfs:comment "Relates a log artifact to the system that generated or produced the log during its operation."@en ;
            rdfs:label "produced by"@en .


###  http://www.semanticweb.org/AMISecOnto#producesRiskLevel
:producesRiskLevel rdf:type owl:ObjectProperty ;
                   rdfs:domain :RiskAssessment ;
                   rdfs:range :RiskLevel ;
                   rdfs:comment """Relates a Risk or RiskAssessment to its corresponding RiskLevel, representing the evaluated severity or magnitude of the risk. This property captures the outcome of risk evaluation processes, supporting prioritization, mitigation planning, and decision-making.

In the context of NIS2 compliance, hasRiskLevel enables organizations to classify risks according to their severity and determine appropriate technical and organizational measures to ensure cybersecurity resilience."""@en ;
                   rdfs:label "produces risk level"@en .


###  http://www.semanticweb.org/AMISecOnto#recommends
:recommends rdf:type owl:ObjectProperty ;
            rdfs:domain :RiskAssessment ;
            rdfs:range :SecurityControl ;
            rdfs:comment """Relates an assessment, analysis, or decision-making process to the actions, controls, or measures it proposes for implementation. In cybersecurity, this property is typically used to link a RiskAssessment to SecurityControl instances that are suggested to mitigate identified risks.

In the context of NIS2 compliance, recommends supports the obligation to implement appropriate and proportionate technical and organizational measures by explicitly capturing which controls are advised as part of risk management processes."""@en ;
            rdfs:label "recommends" .


###  http://www.semanticweb.org/AMISecOnto#relatedToProduct
:relatedToProduct rdf:type owl:ObjectProperty ;
                  rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                  rdfs:range <http://www.semanticweb.org/AMISecOnto/Product> ;
                  rdfs:comment "Associates a Vulnerability with a Product that it impacts, derived from CPE information that specifies the affected platforms, software, or configurations."@en ;
                  rdfs:label "related to product"@en .


###  http://www.semanticweb.org/AMISecOnto#relatedToVulnerability
:relatedToVulnerability rdf:type owl:ObjectProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( <http://www.semanticweb.org/AMISecOnto/LogEvent>
                                                    <http://www.semanticweb.org/AMISecOnto/SoftwareComponent>
                                                  )
                                    ] ;
                        rdfs:range <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                        rdfs:comment "Relates an entity such as a Log Event, Package, Artifact, or Software System to a Vulnerability that it is associated with, affected by, or provides evidence for."@en ;
                        rdfs:label "related to vulnerability"@en .


###  http://www.semanticweb.org/AMISecOnto#storedOn
:storedOn rdf:type owl:ObjectProperty ;
          rdfs:domain :Log ;
          rdfs:range <http://www.semanticweb.org/AMISecOnto/System> ;
          rdfs:comment "Relates a log artifact to the system where the log is stored or maintained."@en ;
          rdfs:label "stored on"@en .


###  http://www.semanticweb.org/AMISecOnto#updatedBy
:updatedBy rdf:type owl:ObjectProperty ;
           rdfs:domain :RiskAssessment ;
           rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
           rdfs:comment "Relates an entity to the agent that performed its most recent modification or update, supporting traceability and change auditing in security and system management contexts."@en ;
           rdfs:label "updated by"@en .


###  http://www.semanticweb.org/AMISecOnto#usedIn
:usedIn rdf:type owl:ObjectProperty ;
        rdfs:domain <http://www.semanticweb.org/AMISecOnto/BuildConfiguration> ;
        rdfs:range :Environment ;
        rdfs:label "used in"@en .


###  http://www.semanticweb.org/AMISecOnto#usesEvidence
:usesEvidence rdf:type owl:ObjectProperty ;
              rdfs:domain :RiskAssessment ;
              rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
              rdfs:comment """Relates an assessment, analysis, or decision-making process to the data, observations, or artifacts it relies on as supporting evidence. In cybersecurity, this property is typically used to link a RiskAssessment to log events, monitoring data, alerts, or other sources that inform the evaluation of risk.

In the context of NIS2 compliance, usesEvidence supports traceability, accountability, and auditability by explicitly capturing the evidentiary basis used in risk management and security assessment processes."""@en ;
              rdfs:label "uses evidence"@en .


###  http://www.semanticweb.org/AMISecOnto/affectsCPE
<http://www.semanticweb.org/AMISecOnto/affectsCPE> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                   rdfs:range <http://www.semanticweb.org/AMISecOnto/CPE> ;
                                                   rdfs:comment "Links a vulnerability to a Common Platform Enumeration (CPE) entry that identifies an affected platform, including vendor, product, and applicable version scope." ;
                                                   rdfs:label "affects CPE"@en .


###  http://www.semanticweb.org/AMISecOnto/belongsToPackage
<http://www.semanticweb.org/AMISecOnto/belongsToPackage> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                         rdfs:range <http://www.semanticweb.org/AMISecOnto/SystemPackage> ;
                                                         rdfs:comment "Associates an Artifact with a Package that groups or contains it, representing its packaging or distribution context."@en ;
                                                         rdfs:label "belongs to package"@en .


###  http://www.semanticweb.org/AMISecOnto/builds
<http://www.semanticweb.org/AMISecOnto/builds> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://www.semanticweb.org/AMISecOnto/BuildProcess> ;
                                               rdfs:range <http://www.semanticweb.org/AMISecOnto/Project> ;
                                               rdfs:comment "Relates a build process to the project that is being processed and transformed into one or more artifacts."@en ;
                                               rdfs:label "builds"@en .


###  http://www.semanticweb.org/AMISecOnto/consistsOf
<http://www.semanticweb.org/AMISecOnto/consistsOf> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.semanticweb.org/AMISecOnto/BuildProcess> ;
                                                   rdfs:range <http://www.semanticweb.org/AMISecOnto/BuildStep> ;
                                                   rdfs:comment "Relates a build process to the build steps that compose it. These steps represent the ordered or logical activities carried out during the lifecycle."@en ;
                                                   rdfs:label "consists of"@en .


###  http://www.semanticweb.org/AMISecOnto/containsPackage
<http://www.semanticweb.org/AMISecOnto/containsPackage> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain :Module ;
                                                        rdfs:range :PackageLibrary ;
                                                        rdfs:comment "Relates a Software Bill of Material to a Package that it includes as part of its listed components."@en ;
                                                        rdfs:label "contains package"@en .


###  http://www.semanticweb.org/AMISecOnto/dependsOn
<http://www.semanticweb.org/AMISecOnto/dependsOn> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://www.semanticweb.org/AMISecOnto/SoftwareComponent> ;
                                                  rdfs:range <http://www.semanticweb.org/AMISecOnto/SoftwareComponent> ;
                                                  rdfs:comment "Associates a Package with a Library on which it relies, representing a dependency relationship necessary for its operation or implementation."@en ;
                                                  rdfs:label "depends on"@en .


###  http://www.semanticweb.org/AMISecOnto/describes
<http://www.semanticweb.org/AMISecOnto/describes> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://www.semanticweb.org/AMISecOnto/SoftwareBillsOfMaterial> ;
                                                  rdfs:range [ rdf:type owl:Class ;
                                                               owl:unionOf ( <http://www.semanticweb.org/AMISecOnto/Application>
                                                                             <http://www.semanticweb.org/AMISecOnto/SoftwareComponent>
                                                                           )
                                                             ] ;
                                                  rdfs:comment "Relates a Software Bill of Material to a Software System that it describes by enumerating its constituent software elements."@en ;
                                                  rdfs:label "describes"@en .


###  http://www.semanticweb.org/AMISecOnto/executes
<http://www.semanticweb.org/AMISecOnto/executes> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://www.semanticweb.org/AMISecOnto/DependencyManagementTool> ;
                                                 rdfs:range <http://www.semanticweb.org/AMISecOnto/BuildProcess> ;
                                                 rdfs:comment "Relates a build tool to the build process it performs. For example, Maven executes a build process based on the project’s pom.xml and associated settings."@en ;
                                                 rdfs:label "executes"@en .


###  http://www.semanticweb.org/AMISecOnto/exposes
<http://www.semanticweb.org/AMISecOnto/exposes> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://www.semanticweb.org/AMISecOnto/SoftwareComponent> ;
                                                rdfs:range <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                rdfs:comment "Associates a Software Component with a Vulnerability that is present in, affects, or can be exploited through the component."@en ;
                                                rdfs:label "exposes"@en .


###  http://www.semanticweb.org/AMISecOnto/hasCVSSMetric
<http://www.semanticweb.org/AMISecOnto/hasCVSSMetric> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                      rdfs:range <http://www.semanticweb.org/AMISecOnto/CVSSMetric> ;
                                                      rdfs:comment "Relates a vulnerability instance to its corresponding CVSS metric."@en ;
                                                      rdfs:label "has CVSS metric"@en .


###  http://www.semanticweb.org/AMISecOnto/hasConfiguration
<http://www.semanticweb.org/AMISecOnto/hasConfiguration> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://www.semanticweb.org/AMISecOnto/Project> ;
                                                         rdfs:range <http://www.semanticweb.org/AMISecOnto/BuildConfiguration> ;
                                                         rdfs:comment "Associates a Project with a Build Configuration that defines how the project is structured, built, or managed through configuration settings and parameters."@en ,
                                                                      "Relates a project to the build configuration that specifies how it should be built, including dependencies, plugins, repositories, profiles, and packaging instructions."@en ;
                                                         rdfs:label "has configuration"@en .


###  http://www.semanticweb.org/AMISecOnto/hasDirectDependency
<http://www.semanticweb.org/AMISecOnto/hasDirectDependency> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                            rdfs:range <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                            rdfs:comment "Relates an Artifact to another Artifact on which it directly depends, representing an immediate dependency without intermediate components."@en ;
                                                            rdfs:label "has direct dependency"@en .


###  http://www.semanticweb.org/AMISecOnto/hasIndicator
<http://www.semanticweb.org/AMISecOnto/hasIndicator> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                                                     rdfs:range <http://www.semanticweb.org/AMISecOnto/Indicator> ;
                                                     rdfs:comment "Associates a Security Log Event with an Indicator, such as a pattern, signature, or observable attribute, that helps identify, describe, or detect the event."@en ;
                                                     rdfs:label "has indicator"@en .


###  http://www.semanticweb.org/AMISecOnto/hasNextLogEvent
<http://www.semanticweb.org/AMISecOnto/hasNextLogEvent> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                                                        rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                                                        rdfs:comment "Relates a Log Event to the Log Event that occurs immediately after it in a sequence."@en ;
                                                        rdfs:label "has next log event"@en .


###  http://www.semanticweb.org/AMISecOnto/hasPackage
<http://www.semanticweb.org/AMISecOnto/hasPackage> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                                                   rdfs:range <http://www.semanticweb.org/AMISecOnto/SoftwareComponent> ;
                                                   rdfs:comment "Relates a Security Log Event to a Package that is involved in, referenced by, or affected by the event."@en ;
                                                   rdfs:label "has package"@en .


###  http://www.semanticweb.org/AMISecOnto/hasPreviousLogEvent
<http://www.semanticweb.org/AMISecOnto/hasPreviousLogEvent> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain :Log ;
                                                            rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                                                            rdfs:comment "Relates a Log Event to the Log Event that occurred immediately before it in a sequence."@en ;
                                                            rdfs:label "has previous log event"@en .


###  http://www.semanticweb.org/AMISecOnto/hasProduct
<http://www.semanticweb.org/AMISecOnto/hasProduct> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain [ rdf:type owl:Class ;
                                                                 owl:unionOf ( <http://www.semanticweb.org/AMISecOnto/CPE>
                                                                               <http://www.semanticweb.org/AMISecOnto/Vendor>
                                                                             )
                                                               ] ;
                                                   rdfs:range <http://www.semanticweb.org/AMISecOnto/Product> ;
                                                   rdfs:comment "Associates a Vendor with a Product that it creates, maintains, or makes available as part of its offerings."@en ,
                                                                "Links a CPE entry or affected platform description to the product that is impacted by a vulnerability."@en ;
                                                   rdfs:label "has product"@en .


###  http://www.semanticweb.org/AMISecOnto/hasReference
<http://www.semanticweb.org/AMISecOnto/hasReference> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                     rdfs:range <http://www.semanticweb.org/AMISecOnto/Reference> ;
                                                     rdfs:comment "Relates a Vulnerability to an external Reference that provides additional information, such as advisories, reports, or documentation."@en ;
                                                     rdfs:label "has reference"@en .


###  http://www.semanticweb.org/AMISecOnto/hasRootArtifact
<http://www.semanticweb.org/AMISecOnto/hasRootArtifact> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <http://www.semanticweb.org/AMISecOnto/Project> ;
                                                        rdfs:range <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                        rdfs:comment "Relates an Application to its primary Artifact that serves as the main or entry-point component of the application."@en ;
                                                        rdfs:label "has root artifact"@en .


###  http://www.semanticweb.org/AMISecOnto/hasTransitiveDependency
<http://www.semanticweb.org/AMISecOnto/hasTransitiveDependency> rdf:type owl:ObjectProperty ;
                                                                rdfs:domain <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                                rdfs:range <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                                rdfs:comment "Relates an Artifact to another Artifact on which it depends indirectly through one or more intermediate dependencies."@en ;
                                                                rdfs:label "has transitive dependency"@en .


###  http://www.semanticweb.org/AMISecOnto/hasUser
<http://www.semanticweb.org/AMISecOnto/hasUser> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                                                rdfs:range <http://www.semanticweb.org/AMISecOnto/User> ;
                                                rdfs:comment "Relates a LogEvent to a User associated with or involved in that event."@en ;
                                                rdfs:label "has user"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVendor
<http://www.semanticweb.org/AMISecOnto/hasVendor> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://www.semanticweb.org/AMISecOnto/CPE> ;
                                                  rdfs:range <http://www.semanticweb.org/AMISecOnto/Vendor> ;
                                                  rdfs:comment "Links a product or CPE entry to the vendor, organization, or project responsible for developing, maintaining, or distributing it."@en ;
                                                  rdfs:label "has vendor"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionInterval
<http://www.semanticweb.org/AMISecOnto/hasVersionInterval> rdf:type owl:ObjectProperty ;
                                                           rdfs:domain <http://www.semanticweb.org/AMISecOnto/CPE> ;
                                                           rdfs:range <http://www.semanticweb.org/AMISecOnto/VersionInterval> ;
                                                           rdfs:comment "Links a CPE or affected platform entry to a version interval describing the bounded range of versions affected by a vulnerability."@en ;
                                                           rdfs:label "has version interval"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionMaxIncluding
<http://www.semanticweb.org/AMISecOnto/hasVersionMaxIncluding> rdf:type owl:ObjectProperty ;
                                                               rdfs:domain <http://www.semanticweb.org/AMISecOnto/VersionInterval> ;
                                                               rdfs:range <http://www.semanticweb.org/AMISecOnto/Version> ;
                                                               rdfs:comment "Relates a VersionInterval to the Version that represents the upper bound of the interval. The referenced version is included in the affected version range."@en ;
                                                               rdfs:label "has version max including"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionMinIncluding
<http://www.semanticweb.org/AMISecOnto/hasVersionMinIncluding> rdf:type owl:ObjectProperty ;
                                                               rdfs:domain <http://www.semanticweb.org/AMISecOnto/VersionInterval> ;
                                                               rdfs:range <http://www.semanticweb.org/AMISecOnto/Version> ;
                                                               rdfs:comment "Relates a VersionInterval to the Version that represents the lower bound of the interval. The referenced version is included in the affected version range."@en ;
                                                               rdfs:label "has version min including"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVulnerability
<http://www.semanticweb.org/AMISecOnto/hasVulnerability> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                         rdfs:range <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                         rdfs:comment "Associates an Artifact with a Vulnerability that is identified in or impacts the artifact, representing known security issues affecting it."@en ;
                                                         rdfs:label "has vulnerability"@en .


###  http://www.semanticweb.org/AMISecOnto/hasWeakness
<http://www.semanticweb.org/AMISecOnto/hasWeakness> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                    rdfs:range <http://www.semanticweb.org/AMISecOnto/Weakness> ;
                                                    rdfs:comment "Links a vulnerability to the underlying software or design weakness that caused it, typically represented using a taxonomy such as CWE."@en ;
                                                    rdfs:label "has weakness"@en .


###  http://www.semanticweb.org/AMISecOnto/isDescribedBySBOM
<http://www.semanticweb.org/AMISecOnto/isDescribedBySBOM> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <http://www.semanticweb.org/AMISecOnto/SoftwareComponent> ;
                                                          rdfs:range <http://www.semanticweb.org/AMISecOnto/SoftwareBillsOfMaterial> ;
                                                          rdfs:comment "Relates a software system to the project that defines, organizes, or documents how that system is built and structured. In Maven, a software system is typically described by one or more project definitions."@en ;
                                                          rdfs:label "is described by SBOM"@en .


###  http://www.semanticweb.org/AMISecOnto/isGeneratedFrom
<http://www.semanticweb.org/AMISecOnto/isGeneratedFrom> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                        rdfs:range <http://www.semanticweb.org/AMISecOnto/BuildProcess> ;
                                                        rdfs:comment "Associates an Artifact with the Build Process that produced it, indicating the origin of the artifact within the build workflow."@en ;
                                                        rdfs:label "is generated from"@en .


###  http://www.semanticweb.org/AMISecOnto/isObservedIn
<http://www.semanticweb.org/AMISecOnto/isObservedIn> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                     rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                                                     rdfs:comment "Associates a Vulnerability with a Log Event that provides evidence of its presence, exploitation, or detection within a system."@en ;
                                                     rdfs:label "is observed in"@en .


###  http://www.semanticweb.org/AMISecOnto/isSpecifiedBy
<http://www.semanticweb.org/AMISecOnto/isSpecifiedBy> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://www.semanticweb.org/AMISecOnto/Application> ;
                                                      rdfs:range <http://www.semanticweb.org/AMISecOnto/Project> ;
                                                      rdfs:comment "Relates a Software System with a Project that provides its specification, implementation, or structural definition."@en ;
                                                      rdfs:label "is specified by"@en .


###  http://www.semanticweb.org/AMISecOnto/managedBy
<http://www.semanticweb.org/AMISecOnto/managedBy> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://www.semanticweb.org/AMISecOnto/Application> ;
                                                  rdfs:range <http://www.semanticweb.org/AMISecOnto/DependencyManagementTool> ;
                                                  rdfs:comment "Relates an application or software component to the dependency management tool that controls its dependencies, versions, and build configuration, influencing its exposure to vulnerable libraries."@en ;
                                                  rdfs:label "managed by"@en .


###  http://www.semanticweb.org/AMISecOnto/produces
<http://www.semanticweb.org/AMISecOnto/produces> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://www.semanticweb.org/AMISecOnto/BuildProcess> ;
                                                 rdfs:range <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                 rdfs:comment "Relates a build process to the artifacts generated as outputs, such as compiled libraries, packaged applications, or metadata files."@en ;
                                                 rdfs:label "produces"@en .


###  http://www.semanticweb.org/AMISecOnto/registersLogEvent
<http://www.semanticweb.org/AMISecOnto/registersLogEvent> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <http://www.semanticweb.org/AMISecOnto/System> ;
                                                          rdfs:range <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                                                          rdfs:comment "Associates a System with a Log Event that it produces, capturing events recorded during execution, monitoring, or auditing activities."@en ;
                                                          rdfs:label "registers log event"@en .


###  http://www.semanticweb.org/AMISecOnto/represents
<http://www.semanticweb.org/AMISecOnto/represents> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.semanticweb.org/AMISecOnto/Artifact> ;
                                                   rdfs:range <http://www.semanticweb.org/AMISecOnto/Application> ;
                                                   rdfs:comment "Relates an Artifact to a Software System that it represents as a concrete implementation or instance."@en ,
                                                                "Relates an artifact to the software system it implements, packages, or delivers. For example, a generated JAR artifact may represent a module or the whole software system."@en ;
                                                   rdfs:label "represents"@en .


###  http://www.semanticweb.org/AMISecOnto/runsOn
<http://www.semanticweb.org/AMISecOnto/runsOn> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://www.semanticweb.org/AMISecOnto/Application> ;
                                               rdfs:range <http://www.semanticweb.org/AMISecOnto/System> ;
                                               rdfs:comment "Relates an application to the system on which it runs."@en ;
                                               rdfs:label "runs on"@en .


###  http://www.semanticweb.org/AMISecOnto/uses
<http://www.semanticweb.org/AMISecOnto/uses> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://www.semanticweb.org/AMISecOnto/BuildStep> ;
                                             rdfs:range <http://www.semanticweb.org/AMISecOnto/Dependency> ;
                                             rdfs:comment "Associates a Build Step with a Dependency required or consumed during the execution of that step, representing the dependency utilized in the build workflow."@en ;
                                             rdfs:label "uses"@en .


###  http://www.semanticweb.org/AMISecOnto/usesConfiguration
<http://www.semanticweb.org/AMISecOnto/usesConfiguration> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <http://www.semanticweb.org/AMISecOnto/BuildProcess> ;
                                                          rdfs:range <http://www.semanticweb.org/AMISecOnto/BuildConfiguration> ;
                                                          rdfs:comment "Relates a Build Process to a Build Configuration that defines the parameters, settings, and environment used during its execution."@en ;
                                                          rdfs:label "uses configuration"@en .


###  http://www.w3.org/2004/02/skos/core#affectsProduct
<http://www.w3.org/2004/02/skos/core#affectsProduct> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain :Risk ;
                                                     rdfs:range <http://www.semanticweb.org/AMISecOnto/Product> ;
                                                     rdfs:label "affects product"@en .


###  http://www.w3.org/2004/02/skos/core#hasRiskLevel
<http://www.w3.org/2004/02/skos/core#hasRiskLevel> rdf:type owl:ObjectProperty ;
                                                   rdfs:label "has risk level"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/AMISecOnto#hasAliveStatus
:hasAliveStatus rdf:type owl:DatatypeProperty ;
                rdfs:domain :CatalinaLogEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Interpreted liveness state of a cluster member referenced in a Catalina log event, indicating whether the member is alive, suspected, or has disappeared during cluster membership monitoring."@en ;
                rdfs:label "has alive status"@en .


###  http://www.semanticweb.org/AMISecOnto#hasAssessementDate
:hasAssessementDate rdf:type owl:DatatypeProperty ;
                    rdfs:domain :RiskAssessment ;
                    rdfs:range xsd:dateTime ;
                    rdfs:comment "Ensures accountability and chronological traceability of decisions."@en ;
                    rdfs:label "has assessement date"@en .


###  http://www.semanticweb.org/AMISecOnto#hasAuthenticationMethod
:hasAuthenticationMethod rdf:type owl:DatatypeProperty ;
                         rdfs:domain :SuLogEvent ;
                         rdfs:range xsd:string ;
                         rdfs:comment "The mechanism or module used to authenticate the su operation, such as \"su\", \"pam_unix\", or other PAM modules. Useful for cross-log correlation or detailed forensic analysis."@en ;
                         rdfs:label "has authentication method"@en .


###  http://www.semanticweb.org/AMISecOnto#hasCategory
:hasCategory rdf:type owl:DatatypeProperty ;
             rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
             rdfs:range xsd:string ;
             rdfs:comment "Specifies the category or classification of the log event, indicating the general type of activity, event, or subsystem to which the log entry belongs. This property helps group and organize log events based on their functional or semantic category." ;
             rdfs:label "has category"@en .


###  http://www.semanticweb.org/AMISecOnto#hasCommand
:hasCommand rdf:type owl:DatatypeProperty ;
            rdfs:domain :SudoLogEvent ;
            rdfs:range xsd:string ;
            rdfs:comment "The full command invoked using sudo, including arguments if present."@en ;
            rdfs:label "has command"@en .


###  http://www.semanticweb.org/AMISecOnto#hasCreationDate
:hasCreationDate rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Log ;
                 rdfs:range xsd:string ;
                 rdfs:comment "When log file was created."@en ;
                 rdfs:label "has creation date"@en .


###  http://www.semanticweb.org/AMISecOnto#hasEncoding
:hasEncoding rdf:type owl:DatatypeProperty ;
             rdfs:domain :Log ;
             rdfs:range xsd:string ;
             rdfs:comment "Character encoding format used in the log file."@en ;
             rdfs:label "has encoding"@en .


###  http://www.semanticweb.org/AMISecOnto#hasEventType
:hasEventType rdf:type owl:DatatypeProperty ;
              rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
              rdfs:range xsd:string ;
              rdfs:comment "Normalized or inferred category describing the nature of the Catalina log event, such as lifecycle, cluster, or exception-related activity."@en ;
              rdfs:label "has event type"@en .


###  http://www.semanticweb.org/AMISecOnto#hasExceptionMessage
:hasExceptionMessage rdf:type owl:DatatypeProperty ;
                     rdfs:domain <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent> ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Textual message describing the exception or error generated during the execution of an application event. This property captures the detailed message returned by the system or runtime when an exception occurs."@en ;
                     rdfs:label "has exception message"@en .


###  http://www.semanticweb.org/AMISecOnto#hasExceptionType
:hasExceptionType rdf:type owl:DatatypeProperty ;
                  rdfs:domain <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent> ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Indicates the type or class of exception raised during the execution of an application event. This property identifies the specific error category (e.g., NullPointerException, IOException, RuntimeError) associated with the logged event."@en ;
                  rdfs:label "has exception type"@en .


###  http://www.semanticweb.org/AMISecOnto#hasExecutable
:hasExecutable rdf:type owl:DatatypeProperty ;
               rdfs:domain :Audit_Log_Event ;
               rdfs:range xsd:string ;
               rdfs:comment "Path or name of the executable file responsible for generating the audited event."@en ;
               rdfs:label "has executable"@en .


###  http://www.semanticweb.org/AMISecOnto#hasFailureReason
:hasFailureReason rdf:type owl:DatatypeProperty ;
                  rdfs:domain :SuLogEvent ;
                  rdfs:range xsd:string ;
                  rdfs:comment "The result state of the su operation, such as \"success\", \"failure\", \"session opened\", or \"session closed\". Essential for interpreting whether the identity switch was attempted, granted, or terminated."@en ;
                  rdfs:label "has failure reason"@en .


###  http://www.semanticweb.org/AMISecOnto#hasFileName
:hasFileName rdf:type owl:DatatypeProperty ;
             rdfs:domain :Log ;
             rdfs:range xsd:string ;
             rdfs:comment "Indicates the name of the file in which the log entry or event was recorded. This property captures the file identifier without necessarily including the full file system path."@en ;
             rdfs:label "has file name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasFilePath
:hasFilePath rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Audit_Log_Event
                                         :Log
                                       )
                         ] ;
             rdfs:range xsd:string ;
             rdfs:comment "Specifies the full file system path to the log file where the event or record is stored. This property indicates the directory structure and location of the file within the system."@en ;
             rdfs:label "has file path"@en .


###  http://www.semanticweb.org/AMISecOnto#hasFileSize
:hasFileSize rdf:type owl:DatatypeProperty ;
             rdfs:domain :Log ;
             rdfs:range xsd:string ;
             rdfs:comment "Indicates the size of the log file in bytes. This property represents the amount of storage occupied by the file in the file system."@en ;
             rdfs:label "has file size"@en .


###  http://www.semanticweb.org/AMISecOnto#hasHostname
:hasHostname rdf:type owl:DatatypeProperty ;
             rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
             rdfs:range xsd:string ;
             rdfs:comment "Specifies the name of the host machine that generated or recorded the log event. This property identifies the system or device where the event originated."@en ;
             rdfs:label "has host name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasHttpStatusCode
:hasHttpStatusCode rdf:type owl:DatatypeProperty ;
                   rdfs:domain :AccessLogEvent ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Represents the HTTP response status code returned by the web server for a client request. The status code indicates the outcome of the request according to the HTTP protocol, such as successful processing, client errors, or server errors."@en ;
                   rdfs:label "has http status code"@en .


###  http://www.semanticweb.org/AMISecOnto#hasHttpVersion
:hasHttpVersion rdf:type owl:DatatypeProperty ;
                rdfs:domain :AccessLogEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Represents the version of the HTTP protocol used in the client request recorded in the log event. This property indicates the specific HTTP protocol version employed during the communication between the client and the web server."@en ;
                rdfs:label "has http version"@en .


###  http://www.semanticweb.org/AMISecOnto#hasLastModified
:hasLastModified rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Log ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Last update timestamp."@en ;
                 rdfs:label "has last modified"@en .


###  http://www.semanticweb.org/AMISecOnto#hasLineNumber
:hasLineNumber rdf:type owl:DatatypeProperty ;
               rdfs:domain :CatalinaLogEvent ;
               rdfs:range xsd:string ;
               rdfs:comment "Line number in source code."@en ;
               rdfs:label "has line number"@en .


###  http://www.semanticweb.org/AMISecOnto#hasLogFileName
:hasLogFileName rdf:type owl:DatatypeProperty ;
                rdfs:domain :ContainerLogEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Represents the name of the operating system log file from which the log event was obtained."@en ;
                rdfs:label "has OS log file name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasLogFilePath
:hasLogFilePath rdf:type owl:DatatypeProperty ;
                rdfs:domain :ContainerLogEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Specifies the filesystem path of the log file from which the log event was generated or extracted. This property identifies the location of the log source on the host system."@en ;
                rdfs:label "has log file path"@en .


###  http://www.semanticweb.org/AMISecOnto#hasLogLevel
:hasLogLevel rdf:type owl:DatatypeProperty ;
             rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
             rdfs:range xsd:string ;
             rdfs:comment "Represents the severity level of the log entry (e.g., DEBUG, INFO, WARN, ERROR)."@en ;
             rdfs:label "has log level"@en .


###  http://www.semanticweb.org/AMISecOnto#hasLoggerName
:hasLoggerName rdf:type owl:DatatypeProperty ;
               rdfs:domain :ContainerLogEvent ;
               rdfs:range xsd:string ;
               rdfs:comment "Specifies the name of the logger that generated the log event. The logger name typically identifies the application component, module, or class responsible for producing the log message."@en ;
               rdfs:label "has logger name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasMemberAddress
:hasMemberAddress rdf:type owl:DatatypeProperty ;
                  rdfs:domain :CatalinaLogEvent ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Stores the cluster member network address referenced in the event."@en ;
                  rdfs:label "has member address"@en .


###  http://www.semanticweb.org/AMISecOnto#hasMemberIP
:hasMemberIP rdf:type owl:DatatypeProperty ;
             rdfs:domain :ContainerLogEvent ;
             rdfs:range xsd:string ;
             rdfs:comment "Represents the IP address of the member or node within a containerized or distributed system that is associated with the log event."@en ;
             rdfs:label "has member IP"@en .


###  http://www.semanticweb.org/AMISecOnto#hasMemberId
:hasMemberId rdf:type owl:DatatypeProperty ;
             rdfs:domain :ContainerLogEvent ;
             rdfs:range xsd:integer ;
             rdfs:comment "Represents the unique identifier assigned to a member or node within a containerized or clustered environment associated with the log event."@en ;
             rdfs:label "has member ID"@en .


###  http://www.semanticweb.org/AMISecOnto#hasMemberPort
:hasMemberPort rdf:type owl:DatatypeProperty ;
               rdfs:domain :CatalinaLogEvent ;
               rdfs:range xsd:integer ;
               rdfs:comment "Represents the network port number associated with the member or node within a containerized or distributed system that generated or participated in the log event."@en ;
               rdfs:label "has member port"@en .


###  http://www.semanticweb.org/AMISecOnto#hasMembershipStatus
:hasMembershipStatus rdf:type owl:DatatypeProperty ;
                     rdfs:domain :ContainerLogEvent ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Interpreted membership status of the cluster member, such as disappeared, alive, or verifiedAlive."@en ;
                     rdfs:label "has menbership status"@en .


###  http://www.semanticweb.org/AMISecOnto#hasMessage
:hasMessage rdf:type owl:DatatypeProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :CatalinaLogEvent
                                        :FenixErrorLogEvent
                                      )
                        ] ;
            rdfs:range xsd:string ;
            rdfs:comment "Main textual content of a Catalina log event, describing the runtime action, status, or issue reported by the Tomcat container."@en ;
            rdfs:label "has message"@en .


###  http://www.semanticweb.org/AMISecOnto#hasOSLogType
:hasOSLogType rdf:type owl:DatatypeProperty ;
              rdfs:domain :ContainerLogEvent ;
              rdfs:range xsd:string ;
              rdfs:comment "Represents the category or classification of the operating system log associated with the log event."@en ;
              rdfs:label "has OS log type"@en .


###  http://www.semanticweb.org/AMISecOnto#hasOriginClass
:hasOriginClass rdf:type owl:DatatypeProperty ;
                rdfs:domain :ContainerLogEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Specifies the original class or source category from which an entity, event, or log entry is derived or classified."@en ;
                rdfs:label "has origin class"@en .


###  http://www.semanticweb.org/AMISecOnto#hasOriginFile
:hasOriginFile rdf:type owl:DatatypeProperty ;
               rdfs:domain :ContainerLogEvent ;
               rdfs:range xsd:string ;
               rdfs:comment "Represents the name of the source code file from which the log event originated"@en ;
               rdfs:label "has origin file"@en .


###  http://www.semanticweb.org/AMISecOnto#hasOriginLineNumber
:hasOriginLineNumber rdf:type owl:DatatypeProperty ;
                     rdfs:domain :ContainerLogEvent ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Represents the line number in the source code file where the logging statement that generated the log event was executed."@en ;
                     rdfs:label "has origin line number"@en .


###  http://www.semanticweb.org/AMISecOnto#hasOriginMethod
:hasOriginMethod rdf:type owl:DatatypeProperty ;
                 rdfs:domain :ContainerLogEvent ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Represents the name of the method or function in the application source code from which the log event originated."@en ;
                 rdfs:label "has origin method"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPackageAction
:hasPackageAction rdf:type owl:DatatypeProperty ;
                  rdfs:domain :InstalledPackageLogEvent ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Specifies the action performed on the package, such as installation, upgrade, removal, or configuration."@en ;
                  rdfs:label "has package action"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPackageArchitecture
:hasPackageArchitecture rdf:type owl:DatatypeProperty ;
                        rdfs:domain :InstalledPackageLogEvent ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Indicates the hardware architecture for which the package is built, such as amd64, i386, or arm64."@en ;
                        rdfs:label "has package architecture"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPackageInstallationState
:hasPackageInstallationState rdf:type owl:DatatypeProperty ;
                             rdfs:domain :InstalledPackageLogEvent ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Indicates the installation state of the package, such as installed, unpacked, configured, or removed."@en ;
                             rdfs:label "has package installation state"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPackageName
:hasPackageName rdf:type owl:DatatypeProperty ;
                rdfs:domain :InstalledPackageLogEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Specifies the name of the package involved in the package management event."@en ;
                rdfs:label "has package name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPackageNewVersion
:hasPackageNewVersion rdf:type owl:DatatypeProperty ;
                      rdfs:domain :InstalledPackageLogEvent ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Represents the new version of the package after an installation or upgrade operation."@en ;
                      rdfs:label "has package new version"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPackagePreviousVersion
:hasPackagePreviousVersion rdf:type owl:DatatypeProperty ;
                           rdfs:domain :InstalledPackageLogEvent ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Represents the version of the package prior to the current package version recorded in the event."@en ;
                           rdfs:label "has package previous version"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPackageStatus
:hasPackageStatus rdf:type owl:DatatypeProperty ;
                  rdfs:domain :InstalledPackageLogEvent ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Indicates the status of the package at the time of the logged event."@en ;
                  rdfs:label "has package status"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPackageVersion
:hasPackageVersion rdf:type owl:DatatypeProperty ;
                   rdfs:domain :InstalledPackageLogEvent ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Specifies the version of the package associated with the logged event."@en ;
                   rdfs:label "has package version"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPort
:hasPort rdf:type owl:DatatypeProperty ;
         rdfs:domain :SshLogEvent ;
         rdfs:range xsd:integer ;
         rdfs:comment "A network port number referenced in the log message."@en ;
         rdfs:label "has port"@en .


###  http://www.semanticweb.org/AMISecOnto#hasPriorityValue
:hasPriorityValue rdf:type owl:DatatypeProperty ;
                  rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "The PRI field is an integer that encodes both the Facility and Severity values, calculated as PRI = Facility × 8 + Severity."@en ;
                  rdfs:label "has priority level"@en .


###  http://www.semanticweb.org/AMISecOnto#hasProcessID
:hasProcessID rdf:type owl:DatatypeProperty ;
              rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
              rdfs:range xsd:integer ;
              rdfs:comment "The operating system identifier of the process that generated the audit event."@en ;
              rdfs:label "has process ID"@en .


###  http://www.semanticweb.org/AMISecOnto#hasProcessName
:hasProcessName rdf:type owl:DatatypeProperty ;
                rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                rdfs:range xsd:string ;
                rdfs:comment "The textual name of the process that emitted the log message."@en ;
                rdfs:label "has process name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasRawMessage
:hasRawMessage rdf:type owl:DatatypeProperty ;
               rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
               rdfs:range xsd:string ;
               rdfs:comment "Represents the original unprocessed log message as recorded in the log source. This property preserves the complete textual content of the log entry before any parsing, normalization, or semantic extraction."@en ;
               rdfs:label "has raw message"@en .


###  http://www.semanticweb.org/AMISecOnto#hasRequestURI
:hasRequestURI rdf:type owl:DatatypeProperty ;
               rdfs:domain :AccessLogEvent ;
               rdfs:range xsd:string ;
               rdfs:comment "Requested URI path. Example: /api/bennu-core/isAlive."@en ;
               rdfs:label "has request URI"@en .


###  http://www.semanticweb.org/AMISecOnto#hasResponseSizeBytes
:hasResponseSizeBytes rdf:type owl:DatatypeProperty ;
                      rdfs:domain :AccessLogEvent ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Size of the HTTP response body in bytes. Example: 5140."@en ;
                      rdfs:label "has response size bytes"@en .


###  http://www.semanticweb.org/AMISecOnto#hasRunAsUser
:hasRunAsUser rdf:type owl:DatatypeProperty ;
              rdfs:domain :SudoLogEvent ;
              rdfs:range xsd:string ;
              rdfs:comment "Indicates the user identity under which the command was executed after privilege."@en ;
              rdfs:label "has run has user"@en .


###  http://www.semanticweb.org/AMISecOnto#hasServletName
:hasServletName rdf:type owl:DatatypeProperty ;
                rdfs:domain :CatalinaLogEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Name of the servlet involved in the Catalina log event, particularly in HTTP request handling or servlet execution failures."@en ;
                rdfs:label "has servelet name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSessionID
:hasSessionID rdf:type owl:DatatypeProperty ;
              rdfs:domain :Audit_Log_Event ;
              rdfs:range xsd:string ;
              rdfs:comment "The identifier of the user session associated with the audit event. This value links multiple audit events generated during the same login session."@en ;
              rdfs:label "has session ID"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSessionStatus
:hasSessionStatus rdf:type owl:DatatypeProperty ;
                  rdfs:domain :AuthenticationLogEvent ;
                  rdfs:range xsd:string ;
                  rdfs:comment "The current state or outcome of a user session inferred from the log message (e.g., \"opened\", \"closed\", \"failed\", \"expired\")."@en ;
                  rdfs:label "has session status"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSeverityCode
:hasSeverityCode rdf:type owl:DatatypeProperty ;
                 rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Indicates the severity or importance level assigned to the log event."@en ;
                 rdfs:label "has severity level"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSourceClass
:hasSourceClass rdf:type owl:DatatypeProperty ;
                rdfs:domain :CatalinaLogEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Identifies the Java class responsible for generating the log event."@en ;
                rdfs:label "has source class"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSourceFile
:hasSourceFile rdf:type owl:DatatypeProperty ;
               rdfs:domain :CatalinaLogEvent ;
               rdfs:range xsd:string ;
               rdfs:comment "Specifies the source code file associated with the log event, typically extracted from a stack trace or debugging information."@en ;
               rdfs:label "has source file"@en .


###  http://www.semanticweb.org/AMISecOnto#hasStackTrace
:hasStackTrace rdf:type owl:DatatypeProperty ;
               rdfs:domain :ContainerLogEvent ;
               rdfs:range xsd:string ;
               rdfs:comment "Contains the stack trace generated during an exception or error, showing the sequence of method calls leading to the event."@en ;
               rdfs:label "has stack trace"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSuStatus
:hasSuStatus rdf:type owl:DatatypeProperty ;
             rdfs:domain :SuLogEvent ;
             rdfs:range xsd:string ;
             rdfs:comment "Indicates the result state of the su operation, such as \"success\", \"failure\", \"session opened\", or \"session closed\"."@en ;
             rdfs:label "has su status"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSuccessStatus
:hasSuccessStatus rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Audit_Log_Event ;
                  rdfs:range xsd:boolean ;
                  rdfs:comment "Indicates whether the audited system call executed successfully (true) or failed."@en ;
                  rdfs:label "has success status"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSudoStatus
:hasSudoStatus rdf:type owl:DatatypeProperty ;
               rdfs:domain :SudoLogEvent ;
               rdfs:range xsd:string ;
               rdfs:comment "The result of the sudo attempt (e.g., accepted, rejected, success, failure)."@en ;
               rdfs:label "has sudo status"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSyscallNumber
:hasSyscallNumber rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Audit_Log_Event ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Numeric identifier of the system call invoked by the process, corresponding to the system call table of the operating system architecture."@en ;
                  rdfs:label "has syscall number"@en .


###  http://www.semanticweb.org/AMISecOnto#hasTTY
:hasTTY rdf:type owl:DatatypeProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :SuLogEvent
                                    :SudoLogEvent
                                  )
                    ] ;
        rdfs:range xsd:string ;
        rdfs:comment "The terminal or pseudo-terminal (TTY/PTS) associated with the session during the su operation (e.g., \"pts/0\"). Useful for identifying interactive vs. non-interactive sessions and correlating with session logs."@en ;
        rdfs:label "has TTY"@en .


###  http://www.semanticweb.org/AMISecOnto#hasTargetUser
:hasTargetUser rdf:type owl:DatatypeProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :SshLogEvent
                                           :SuLog
                                         )
                           ] ;
               rdfs:range xsd:string ;
               rdfs:comment "User account that is the target or subject of the action recorded in the log message." ;
               rdfs:label "has target user"@en .


###  http://www.semanticweb.org/AMISecOnto#hasTextMessage
:hasTextMessage rdf:type owl:DatatypeProperty ;
                rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                rdfs:range xsd:string ;
                rdfs:comment "Captures the unstructured textual message generated by a system, application, or process, typically used for logging, debugging, or monitoring purposes."@en ;
                rdfs:label "has text message"@en .


###  http://www.semanticweb.org/AMISecOnto#hasThreatName
:hasThreatName rdf:type owl:DatatypeProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :CatalinaLogEvent
                                           :FenixErrorLogEvent
                                         )
                           ] ;
               rdfs:range xsd:string ;
               rdfs:comment "Specifies the name or identifier of the threat associated with the log event."@en ;
               rdfs:label "has threat name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasTopStackFrame
:hasTopStackFrame rdf:type owl:DatatypeProperty ;
                  rdfs:domain :CatalinaLogEvent ;
                  rdfs:range xsd:string ;
                  rdfs:comment "First stack frame in the trace, which often identifies the immediate failure point."@en ;
                  rdfs:label "has top stack frame"@en .


###  http://www.semanticweb.org/AMISecOnto#hasUdpPort
:hasUdpPort rdf:type owl:DatatypeProperty ;
            rdfs:domain :ContainerLogEvent ;
            rdfs:range xsd:integer ;
            rdfs:comment """Specifies the UDP port number associated with a Container Log Event. 
This property represents the destination or source UDP port recorded in the log entry and is expressed as an integer value according to standard network port numbering."""@en ;
            rdfs:label "has udp port"@en .


###  http://www.semanticweb.org/AMISecOnto#hasUserID
:hasUserID rdf:type owl:DatatypeProperty ;
           rdfs:domain :Audit_Log_Event ;
           rdfs:range xsd:integer ;
           rdfs:comment "Numeric identifier of the user account associated with the event, indicating which system user performed or initiated the action."@en ;
           rdfs:label "has user ID"@en .


###  http://www.semanticweb.org/AMISecOnto#hasUserName
:hasUserName rdf:type owl:DatatypeProperty ;
             rdfs:domain :AuthenticationLogEvent ;
             rdfs:range xsd:string ;
             rdfs:comment "Identifies the user who executed the sudo command. This is the original user before privilege escalation and corresponds to the account initiating the sudo action (e.g., alice, ubuntu, www-data)."@en ;
             rdfs:label "has user name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasVerificationStatus
:hasVerificationStatus rdf:type owl:DatatypeProperty ;
                       rdfs:domain :ContainerLogEvent ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Indicates the verification status of the log event or record. This property specifies whether the event has been validated, confirmed, or reviewed by the system or a security analysis process."@en ;
                       rdfs:label "has verification status"@en .


###  http://www.semanticweb.org/AMISecOnto#has_class_method
:has_class_method rdf:type owl:DatatypeProperty ;
                  rdfs:domain :CatalinaLogEvent ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Specifies the name of the source code method or function associated with the log event, if such information is available."@en ;
                  rdfs:label "has source method"@en .


###  http://www.semanticweb.org/AMISecOnto#has_http_method
:has_http_method rdf:type owl:DatatypeProperty ;
                 rdfs:domain :AccessLogEvent ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Represents the HTTP request method used by the client when making a request to the web server. This property identifies the type of operation requested according to the HTTP protocol."@en ;
                 rdfs:label "has http method"@en .


###  http://www.semanticweb.org/AMISecOnto#has_http_status_code
:has_http_status_code rdf:type owl:DatatypeProperty ;
                      rdfs:domain :AccessLogEvent ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Represents the HTTPS response status code returned by the web server for a client request transmitted over the HTTPS protocol. The status code indicates the outcome of the request according to the HTTP/HTTPS protocol specification, such as successful responses, client errors, or server errors."@en ;
                      rdfs:label "has https status code"@en .


###  http://www.semanticweb.org/AMISecOnto#has_referer
:has_referer rdf:type owl:DatatypeProperty ;
             rdfs:domain :AccessLogEvent ;
             rdfs:range xsd:string ;
             rdfs:comment "Represents the HTTP Referer header indicating the URI of the resource from which the request was initiated. It identifies the previous web page that linked to the requested resource in an access log event."@en ;
             rdfs:label "has referer"@en .


###  http://www.semanticweb.org/AMISecOnto#has_syslog_timestamp
:has_syslog_timestamp rdf:type owl:DatatypeProperty ;
                      rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                      rdfs:range xsd:dateTime ;
                      rdfs:comment "Represents the timestamp assigned by the syslog infrastructure when the log event was received or recorded."@en ;
                      rdfs:label "has syslog timestamp"@en .


###  http://www.semanticweb.org/AMISecOnto#has_user_agent
:has_user_agent rdf:type owl:DatatypeProperty ;
                rdfs:domain :AccessLogEvent ;
                rdfs:range xsd:string ;
                rdfs:comment "Specifies the HTTP User-Agent header value recorded in a log event, identifying the client application, browser, service, or tool that initiated the request."@en ;
                rdfs:label "has user agent"@en .


###  http://www.semanticweb.org/AMISecOnto#haslogger
:haslogger rdf:type owl:DatatypeProperty ;
           rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
           rdfs:range xsd:string ;
           rdfs:comment "Identifies the logger component or logging category used to generate the log event."@en ;
           rdfs:label "has logger"@en .


###  http://www.semanticweb.org/AMISecOnto/hasAuthenticatedUser
<http://www.semanticweb.org/AMISecOnto/hasAuthenticatedUser> rdf:type owl:DatatypeProperty ;
                                                             rdfs:domain <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent> ;
                                                             rdfs:range xsd:string ;
                                                             rdfs:comment "Links a request or session to the identity of an authenticated user, if authentication has occurred."@en ;
                                                             rdfs:label "has authenticated user"@en .


###  http://www.semanticweb.org/AMISecOnto/hasBaseScore
<http://www.semanticweb.org/AMISecOnto/hasBaseScore> rdf:type owl:DatatypeProperty ;
                                                     rdfs:domain <http://www.semanticweb.org/AMISecOnto/Severity> ;
                                                     rdfs:range xsd:decimal ;
                                                     rdfs:comment "Represents the numerical CVSS base score indicating the intrinsic severity of a vulnerability, typically ranging from 0.0 to 10.0."@en ;
                                                     rdfs:label "has base score"@en .


###  http://www.semanticweb.org/AMISecOnto/hasBaseSeverity
<http://www.semanticweb.org/AMISecOnto/hasBaseSeverity> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <http://www.semanticweb.org/AMISecOnto/Severity> ;
                                                        rdfs:range xsd:string ;
                                                        rdfs:comment "Indicates the qualitative severity level of a vulnerability derived from its CVSS Base Score. Typical values include None, Low, Medium, High, and Critical, representing the intrinsic impact of the vulnerability under standard conditions."@en ;
                                                        rdfs:label "has base severity"@en .


###  http://www.semanticweb.org/AMISecOnto/hasCVEId
<http://www.semanticweb.org/AMISecOnto/hasCVEId> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                 rdfs:range xsd:string ;
                                                 rdfs:comment "Identifies the unique Common Vulnerabilities and Exposures (CVE) identifier assigned to a vulnerability record. The identifier follows the standard CVE naming format (e.g., CVE-2025-12345) and is used to uniquely reference a vulnerability in public vulnerability databases."@en ;
                                                 rdfs:label "has CVE identifier"@en .


###  http://www.semanticweb.org/AMISecOnto/hasCVSSVersion
<http://www.semanticweb.org/AMISecOnto/hasCVSSVersion> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                       rdfs:range xsd:decimal ;
                                                       rdfs:comment "Specifies the version of the Common Vulnerability Scoring System (CVSS) used to calculate the vulnerability score (e.g., 2.0, 3.0, 3.1, 4.0)."@en ;
                                                       rdfs:label "has CVSS version"@en .


###  http://www.semanticweb.org/AMISecOnto/hasCVSScode
<http://www.semanticweb.org/AMISecOnto/hasCVSScode> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "Stores the CVSS vector string representing the detailed metrics used to calculate the vulnerability score."@en ;
                                                    rdfs:label "has CVSS code"@en .


###  http://www.semanticweb.org/AMISecOnto/hasClientIp
<http://www.semanticweb.org/AMISecOnto/hasClientIp> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain :AccessLogEvent ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "Captures the source IP address from which the request originated, useful for tracking, auditing, and intrusion detection."@en ;
                                                    rdfs:label "has client ip"@en .


###  http://www.semanticweb.org/AMISecOnto/hasDescription
<http://www.semanticweb.org/AMISecOnto/hasDescription> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                       rdfs:range xsd:string ;
                                                       rdfs:comment "Provides a textual description of the vulnerability, explaining the nature of the security issue, the affected components, and potential impacts such as unauthorized access, denial of service, or privilege escalation."@en ;
                                                       rdfs:label "has description"@en .


###  http://www.semanticweb.org/AMISecOnto/hasEventTimestamp
<http://www.semanticweb.org/AMISecOnto/hasEventTimestamp> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <http://www.semanticweb.org/AMISecOnto/LogEvent> ;
                                                          rdfs:range xsd:dateTime ;
                                                          rdfs:comment "Records the timestamp of the event, enabling temporal analysis, ordering of events, and correlation across logs."@en ;
                                                          rdfs:label "has event timestamp"@en .


###  http://www.semanticweb.org/AMISecOnto/hasIntervalLabel
<http://www.semanticweb.org/AMISecOnto/hasIntervalLabel> rdf:type owl:DatatypeProperty ;
                                                         rdfs:domain <http://www.semanticweb.org/AMISecOnto/VersionInterval> ;
                                                         rdfs:range xsd:string ;
                                                         rdfs:comment "Indicates the qualitative severity category derived from the CVSS base score (e.g., Low, Medium, High, Critical)."@en ;
                                                         rdfs:label "has interval label"@en .


###  http://www.semanticweb.org/AMISecOnto/hasPubDate
<http://www.semanticweb.org/AMISecOnto/hasPubDate> rdf:type owl:DatatypeProperty ;
                                                   rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                   rdfs:range xsd:dateTime ;
                                                   rdfs:comment "Specifies the date on which the vulnerability entry was officially published in a vulnerability database such as the National Vulnerability Database (NVD)."@en ;
                                                   rdfs:label "has publication date"@en .


###  http://www.semanticweb.org/AMISecOnto/hasReferenceURL
<http://www.semanticweb.org/AMISecOnto/hasReferenceURL> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                        rdfs:range xsd:string ;
                                                        rdfs:comment "Links to external resources related to the vulnerability, such as security advisories, vendor bulletins, patches, technical analyses, or vulnerability reports."@en ;
                                                        rdfs:label "has reference URL"@en .


###  http://www.semanticweb.org/AMISecOnto/hasRequestLine
<http://www.semanticweb.org/AMISecOnto/hasRequestLine> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain :AccessLogEvent ;
                                                       rdfs:range xsd:string ;
                                                       rdfs:comment "Contains the complete request line, including HTTP method, requested resource, and protocol version, providing detailed request context."@en ;
                                                       rdfs:label "has request line"@en .


###  http://www.semanticweb.org/AMISecOnto/hasRole
<http://www.semanticweb.org/AMISecOnto/hasRole> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <http://www.semanticweb.org/AMISecOnto/User> ;
                                                rdfs:range xsd:string ;
                                                rdfs:comment "Security role(s) assigned to the user (e.g., 'developer', 'admin', 'security-researcher', 'system-service'). Multiple roles per user allowed."@en ;
                                                rdfs:label "has role"@en .


###  http://www.semanticweb.org/AMISecOnto/hasSourceVulnerability
<http://www.semanticweb.org/AMISecOnto/hasSourceVulnerability> rdf:type owl:DatatypeProperty ;
                                                               rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                                               rdfs:range xsd:string ;
                                                               rdfs:comment "Identifies the organization or entity that reported, published, or maintains the vulnerability information, such as NVD, MITRE, or a specific vendor."@en ;
                                                               rdfs:label "has source vulnerability"@en .


###  http://www.semanticweb.org/AMISecOnto/hasStatusCode
<http://www.semanticweb.org/AMISecOnto/hasStatusCode> rdf:type owl:DatatypeProperty ;
                                                      rdfs:domain :AccessLogEvent ;
                                                      rdfs:range xsd:string ;
                                                      rdfs:comment "Encodes the outcome of the request using standard HTTP status codes (e.g., 200, 404, 500), supporting error analysis and monitoring."@en ;
                                                      rdfs:label "has status code"@en .


###  http://www.semanticweb.org/AMISecOnto/hasTag
<http://www.semanticweb.org/AMISecOnto/hasTag> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://www.semanticweb.org/AMISecOnto/Vulnerability> ;
                                               rdfs:range xsd:string ;
                                               rdfs:comment "Associates descriptive tags or keywords with the vulnerability to facilitate categorization, filtering, and analysis.  It serves as a shorthand method to provide contextual data regarding the CVE Record."@en ;
                                               rdfs:label "has tag"@en .


###  http://www.semanticweb.org/AMISecOnto/hasTargetHardware
<http://www.semanticweb.org/AMISecOnto/hasTargetHardware> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <http://www.semanticweb.org/AMISecOnto/VersionInterval> ;
                                                          rdfs:range xsd:string ;
                                                          rdfs:comment "Specifies the hardware platform, device type, or architecture affected by the vulnerability."@en ;
                                                          rdfs:label "has target hardware"@en .


###  http://www.semanticweb.org/AMISecOnto/hasUserEmail
<http://www.semanticweb.org/AMISecOnto/hasUserEmail> rdf:type owl:DatatypeProperty ;
                                                     rdfs:domain <http://www.semanticweb.org/AMISecOnto/User> ;
                                                     rdfs:range xsd:string ;
                                                     rdfs:comment "The email address of the user for contact and identity verification purposes."@en ;
                                                     rdfs:label "has user email"@en .


###  http://www.semanticweb.org/AMISecOnto/hasUserID
<http://www.semanticweb.org/AMISecOnto/hasUserID> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <http://www.semanticweb.org/AMISecOnto/User> ;
                                                  rdfs:range xsd:string ;
                                                  rdfs:comment "The system-internal unique identifier for the user (e.g., UID, GUID). Used for secure identification independent of username changes."@en ;
                                                  rdfs:label "has user ID"@en .


###  http://www.semanticweb.org/AMISecOnto/hasUsername
<http://www.semanticweb.org/AMISecOnto/hasUsername> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain <http://www.semanticweb.org/AMISecOnto/User> ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "The unique username identifier for the user within the system. Primary identifier for audit trail tracking."@en ;
                                                    rdfs:label "has username"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersion
<http://www.semanticweb.org/AMISecOnto/hasVersion> rdf:type owl:DatatypeProperty ;
                                                   rdfs:domain [ rdf:type owl:Class ;
                                                                 owl:unionOf ( <http://www.semanticweb.org/AMISecOnto/BuildConfiguration>
                                                                               <http://www.semanticweb.org/AMISecOnto/Dependency>
                                                                             )
                                                               ] ;
                                                   rdfs:range xsd:string ;
                                                   rdfs:comment "Specifies the version identifier of the software dependency or component. This property indicates the particular release or build of the dependency associated with the system or application."@en ;
                                                   rdfs:label "has version"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/AMISecOnto#AccessLog
:AccessLog rdf:type owl:Class ;
           rdfs:subClassOf :ApplicationLog ;
           rdfs:comment "Represents a log recording access events to systems, resources, or services, including information about who accessed what, when, and from where."@en ;
           rdfs:label "Access Log"@en .


###  http://www.semanticweb.org/AMISecOnto#AccessLogEvent
:AccessLogEvent rdf:type owl:Class ;
                rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasExceptionType ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasHttpStatusCode ;
                                  owl:someValuesFrom xsd:integer
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasHttpVersion ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasRawMessage ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasRequestURI ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasResponseSizeBytes ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :has_http_method ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :has_referer ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :has_user_agent ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasClientIp> ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasRequestLine> ;
                                  owl:someValuesFrom xsd:string
                                ] ;
                rdfs:comment "Log event that records an access request made by a client to a system resource or service. Access log events capture information such as client IP address, request method, requested URI, response status code, and response size, enabling monitoring, usage analysis, and security auditing."@en ;
                rdfs:label "Access Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#Activity
:Activity rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ;
          rdfs:comment "Represents processes and transformations that occur over time in the software supply chain. Aligned with PROV-O Activity to enable provenance tracking of build processes, deployments, and runtime events."@en ;
          rdfs:label "Activity"@en .


###  http://www.semanticweb.org/AMISecOnto#ApplicationLog
:ApplicationLog rdf:type owl:Class ;
                rdfs:subClassOf :Log ;
                rdfs:comment "Represents a log generated by an application or software service during its execution."@en ;
                rdfs:label "Application Log"@en .


###  http://www.semanticweb.org/AMISecOnto#AuditLog
:AuditLog rdf:type owl:Class ;
          rdfs:subClassOf :SecurityLog ;
          rdfs:comment "Represents logs used for auditing purposes, capturing security relevant events and activities to support compliance, traceability, and forensic analysis."@en ;
          rdfs:label "Audit Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Audit_Log_Event
:Audit_Log_Event rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/SecurityLogEvent> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasExecutable ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasFilePath ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasSessionID ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasSuccessStatus ;
                                   owl:someValuesFrom xsd:boolean
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasSyscallNumber ;
                                   owl:someValuesFrom xsd:integer
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasUserID ;
                                   owl:someValuesFrom xsd:integer
                                 ] ;
                 rdfs:comment "Log event generated by an auditing mechanism that records security-relevant activities performed on a system. Audit log events capture actions such as user authentication, command execution, privilege escalation, resource access, or configuration changes to support accountability, monitoring, and forensic analysis."@en ;
                 rdfs:label "Audit Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#AuthenticationLog
:AuthenticationLog rdf:type owl:Class ;
                   rdfs:subClassOf :SecurityLog ;
                   rdfs:comment "Captures events related to authentication processes, such as login attemps, successes, failures, and credential validation activities."@en ;
                   rdfs:label "Authentication Log"@en .


###  http://www.semanticweb.org/AMISecOnto#AuthenticationLogEvent
:AuthenticationLogEvent rdf:type owl:Class ;
                        rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/SecurityLogEvent> ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasSessionStatus ;
                                          owl:someValuesFrom xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasUserName ;
                                          owl:someValuesFrom xsd:string
                                        ] ;
                        rdfs:comment "Log event that records authentication-related activities within a system or service. These events capture attempts to verify the identity of users, applications, or services and may include successful or failed login attempts, authentication methods used, and associated user or session information."@en ;
                        rdfs:label "Authentication Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#CatalinaLog
:CatalinaLog rdf:type owl:Class ;
             rdfs:subClassOf :ContainerLog ;
             rdfs:comment "Represents container-level logging information produced by Tomcat's Catalina engine."@en ;
             rdfs:label "Catalina Log"@en .


###  http://www.semanticweb.org/AMISecOnto#CatalinaLogEvent
:CatalinaLogEvent rdf:type owl:Class ;
                  rdfs:subClassOf :ContainerLogEvent ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasEventType ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasMemberAddress ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasMembershipStatus ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasMessage ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasServletName ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasSourceClass ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasThreatName ;
                                    owl:someValuesFrom xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :has_class_method ;
                                    owl:someValuesFrom xsd:string
                                  ] ;
                  rdfs:comment "Log event generated by the Apache Tomcat Catalina engine, capturing runtime information, warnings, or errors during servlet container execution."@en ;
                  rdfs:label "Catalina Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#ClassSource
:ClassSource rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasLogger ;
                               owl:someValuesFrom :Logger
                             ] ;
             rdfs:comment "An implementation unit within a package that encapsulates attributes and methods and can generate runtime events."@en ;
             rdfs:label "Class Source"@en .


###  http://www.semanticweb.org/AMISecOnto#ContainerLog
:ContainerLog rdf:type owl:Class ;
              rdfs:subClassOf :ApplicationLog ;
              rdfs:comment "Represents logs generated by containerized environments, capturing runtime events, system outputs, and operational detalis of containers."@en ;
              rdfs:label "Container Log"@en .


###  http://www.semanticweb.org/AMISecOnto#ContainerLogEvent
:ContainerLogEvent rdf:type owl:Class ;
                   rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent> ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasExceptionMessage ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasExceptionType ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasLineNumber ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasLogFileName ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasLogFilePath ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasLoggerName ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasMemberIP ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasMemberId ;
                                     owl:someValuesFrom xsd:integer
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasMembershipStatus ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasOSLogType ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasOriginClass ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasOriginFile ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasOriginLineNumber ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasOriginMethod ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasRawMessage ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasSeverityCode ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasSourceFile ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasTopStackFrame ;
                                     owl:someValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasUdpPort ;
                                     owl:someValuesFrom xsd:integer
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasVerificationStatus ;
                                     owl:someValuesFrom xsd:string
                                   ] ;
                   rdfs:comment "Log event generated by a containerized application or service running in a container environment such as Docker or Kubernetes. Container log events typically capture runtime information including application output, errors, system messages, and operational events associated with container execution and lifecycle." ;
                   rdfs:label "Container Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#Entity
:Entity rdf:type owl:Class ;
        rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
        rdfs:comment "Represents physical, digital, or abstract things with fixed aspects in the software supply chain. Includes artifacts, packages, dependencies, and configurations. Aligned with PROV-O Entity for provenance and traceability across the three pillars: supply chain, vulnerabilities, and runtime."@en ;
        rdfs:label "Entity"@en .


###  http://www.semanticweb.org/AMISecOnto#Environment
:Environment rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasConfiguration ;
                               owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/BuildConfiguration>
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasLog ;
                               owl:someValuesFrom :Log
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hosts ;
                               owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/System>
                             ] ;
             rdfs:comment "Represents the context or setting in which a system, application, or component is deployed and operates, including its underlying infrastructure, software stack, and configuration."@en ;
             rdfs:label "Environment"@en .


###  http://www.semanticweb.org/AMISecOnto#ErrorLog
:ErrorLog rdf:type owl:Class ;
          rdfs:subClassOf :ApplicationLog ;
          rdfs:comment "Contains records of application errors, including failure events, exceptions, and diagnostic information useful for troubleshooting and auditing."@en ;
          rdfs:label "Error Log"@en .


###  http://www.semanticweb.org/AMISecOnto#ErrorLogEvent
:ErrorLogEvent rdf:type owl:Class ;
               rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent> ;
               rdfs:comment "Log event that records an error, failure, or abnormal condition occurring within a system, application, or service. Error log events contain information about the error message, source component, stack trace, and contextual details that assist in diagnosing and troubleshooting operational or security issues." ;
               rdfs:label "Error Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#Failed
:Failed rdf:type owl:Class ;
        rdfs:subClassOf :Outcome ;
        rdfs:comment "Indicates that the activity did not complete successfully due to errors or undesired conditions."@en ;
        rdfs:label "Failed"@en .


###  http://www.semanticweb.org/AMISecOnto#FenixErrorLog
:FenixErrorLog rdf:type owl:Class ;
               rdfs:subClassOf :ErrorLog ;
               rdfs:comment "Log source containing records of errors and exceptions generated by the Fenix system, used for debugging, monitoring, and incident analysis."@en ;
               rdfs:label "Fenix Error Log"@en .


###  http://www.semanticweb.org/AMISecOnto#FenixErrorLogEvent
:FenixErrorLogEvent rdf:type owl:Class ;
                    rdfs:subClassOf :ErrorLogEvent ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasThreatName ;
                                      owl:someValuesFrom xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :haslogger ;
                                      owl:someValuesFrom xsd:string
                                    ] ;
                    rdfs:comment "Log event representing an error occurrence recorded by the Fenix system, capturing failures, exceptions, or abnormal behaviors during system operation."@en ;
                    rdfs:label "Fenix Error Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#InstalledPackageLogEvent
:InstalledPackageLogEvent rdf:type owl:Class ;
                          rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/SystemLogEvent> ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasPackageAction ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasPackageArchitecture ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasPackageInstallationState ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasPackageName ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasPackageNewVersion ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasPackagePreviousVersion ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasPackageStatus ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasPackageVersion ;
                                            owl:someValuesFrom xsd:string
                                          ] ;
                          rdfs:comment "Log event generated by a package management system that records operations performed on software packages. These events typically capture actions such as installation, removal, upgrade, configuration, and dependency processing, including information about the package name, version, architecture, and installation state."@en ;
                          rdfs:label "Package Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#Log
:Log rdf:type owl:Class ;
     rdfs:subClassOf :Activity ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :producedBy ;
                       owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/System>
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :storedOn ;
                       owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/System>
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasCurrentLogEvent ;
                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Log
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasFirstLogEvent ;
                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Log
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasCreationDate ;
                       owl:someValuesFrom xsd:string
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasEncoding ;
                       owl:someValuesFrom xsd:string
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasFileName ;
                       owl:someValuesFrom xsd:string
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasFilePath ;
                       owl:someValuesFrom xsd:string
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasFileSize ;
                       owl:someValuesFrom xsd:string
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasLastModified ;
                       owl:someValuesFrom xsd:string
                     ] ;
     rdfs:comment "A Log is a structured or unstructured record generated by systems, applications, or devices that captures events, activities, or states over time."@en ;
     rdfs:label "Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Logger
:Logger rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :generates ;
                          owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/LogEvent>
                        ] ;
        rdfs:comment "Represents a logging component responsible for recording events generated by classes during system execution."@en ;
        rdfs:label "Logger"@en .


###  http://www.semanticweb.org/AMISecOnto#Module
:Module rdf:type owl:Class ;
        rdfs:subClassOf :Entity ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://www.semanticweb.org/AMISecOnto/containsPackage> ;
                          owl:someValuesFrom :PackageLibrary
                        ] ;
        rdfs:comment "An abstraction that organizes a collection of packages corresponding to a specific academic domain or functionality."@en ;
        rdfs:label "Module"@en .


###  http://www.semanticweb.org/AMISecOnto#OperatingSystem
:OperatingSystem rdf:type owl:Class ;
                 rdfs:subClassOf :Entity ;
                 rdfs:comment "Operating system running on a host or computing device that manages hardware resources, system processes, and software execution."@en ;
                 rdfs:label "Operating System"@en .


###  http://www.semanticweb.org/AMISecOnto#Outcome
:Outcome rdf:type owl:Class ;
         rdfs:comment "Represents the result or final state of an activity, process, or event within the system."@en ;
         rdfs:label "Outcome"@en .


###  http://www.semanticweb.org/AMISecOnto#PackageLibrary
:PackageLibrary rdf:type owl:Class ;
                rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/SoftwareComponent> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasClass ;
                                  owl:someValuesFrom :ClassSource
                                ] ;
                rdfs:comment "Represents a container within a module that groups related classes based on functionality or purpose."@en ;
                rdfs:label "Package Library"@en .


###  http://www.semanticweb.org/AMISecOnto#PackageLog
:PackageLog rdf:type owl:Class ;
            rdfs:subClassOf :SystemLog ;
            rdfs:comment "Records events related to software package management, such as installation, updates, removals, and dependency handling."@en ;
            rdfs:label "Package Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Process
:Process rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :hasOutcome ;
                           owl:someValuesFrom :Outcome
                         ] ;
         rdfs:comment "Represents an executing instance of a program or application within a system, including its runtime state, resources, and behavior."@en ;
         rdfs:label "Process"@en .


###  http://www.semanticweb.org/AMISecOnto#Request
:Request rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :performedByUser ;
                           owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/User>
                         ] ;
         rdfs:comment "Describes a request issued by a user, application, or process to access or invoke a resource or service, capturing interactions that are relevant for monitoring, logging, and security analysis."@en ;
         rdfs:label "Request"@en .


###  http://www.semanticweb.org/AMISecOnto#Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2004/02/skos/core#affectsProduct> ;
                        owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Product>
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2004/02/skos/core#hasRiskLevel> ;
                        owl:someValuesFrom :Risk
                      ] ;
      rdfs:comment """A potential for loss, disruption, or damage resulting from the exploitation of vulnerabilities by threats affecting assets, systems, or services. Risk is typically characterized by the combination of likelihood and impact and serves as a central concept in cybersecurity risk management and decision-making.

In the context of NIS2 compliance, Risk represents the level of exposure that organizations must identify, assess, and mitigate through appropriate technical and organizational measures to ensure the security and resilience of network and information systems."""@en ;
      rdfs:label "Risk"@en .


###  http://www.semanticweb.org/AMISecOnto#RiskAssessment
:RiskAssessment rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :belongsToLog ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( :Log
                                                                     <http://www.semanticweb.org/AMISecOnto/LogEvent>
                                                                   )
                                                     ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :considers ;
                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( :Threat
                                                                     <http://www.semanticweb.org/AMISecOnto/Vulnerability>
                                                                   )
                                                     ]
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :identifies ;
                                  owl:someValuesFrom :Risk
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :producesRiskLevel ;
                                  owl:someValuesFrom :RiskLevel
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :recommends ;
                                  owl:someValuesFrom :SecurityControl
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :updatedBy ;
                                  owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/LogEvent>
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :usesEvidence ;
                                  owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/LogEvent>
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasAssessementDate ;
                                  owl:someValuesFrom xsd:dateTime
                                ] ;
                rdfs:comment """A structured process for identifying, analyzing, and evaluating cybersecurity risks affecting assets, systems, or services. It considers potential threats, vulnerabilities, likelihood, and impact to determine risk levels and support decision-making regarding appropriate mitigation measures.

In the context of NIS2 compliance, RiskAssessment supports continuous risk management practices, enabling organizations to implement proportionate technical and organizational measures, ensure accountability, and maintain resilience against cyber threats."""@en ;
                rdfs:label "Risk Assessment"@en .


###  http://www.semanticweb.org/AMISecOnto#RiskLevel
:RiskLevel rdf:type owl:Class ;
           rdfs:comment """A classification or categorization of the severity of a cybersecurity risk, typically derived from the combination of likelihood and impact. RiskLevel is used to support prioritization, decision-making, mitigation planning, and compliance reporting. 

In the context of NIS2 compliance, RiskLevel helps organizations determine whether identified risks require treatment through appropriate technical and organizational measures"""@en ;
           rdfs:label "Risk Level"@en .


###  http://www.semanticweb.org/AMISecOnto#SecurityControl
:SecurityControl rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty :mitigates ;
                                   owl:someValuesFrom :Risk
                                 ] ;
                 rdfs:comment """A technical, organizational, or procedural measure implemented to prevent, detect, reduce, or respond to cybersecurity risks affecting assets, systems, services, or organizational operations. SecurityControl supports risk treatment by reducing likelihood, limiting impact, improving resilience, or enabling recovery. In the context of 

NIS2 compliance, SecurityControl represents the appropriate and proportionate measures required to manage risks and protect network and information systems."""@en ;
                 rdfs:label "Security Control"@en .


###  http://www.semanticweb.org/AMISecOnto#SecurityLog
:SecurityLog rdf:type owl:Class ;
             rdfs:subClassOf :Log ;
             rdfs:comment "Represents a log that records security-relevant events within a system, application, or network environment."@en ;
             rdfs:label "Security Log"@en .


###  http://www.semanticweb.org/AMISecOnto#SshLog
:SshLog rdf:type owl:Class ;
        rdfs:subClassOf :AuthenticationLog ;
        rdfs:comment "Log source that stores records of SSH-related activities, including authentication attempts, session details, and remote connections to the system."@en ;
        rdfs:label "Ssh Log"@en .


###  http://www.semanticweb.org/AMISecOnto#SshLogEvent
:SshLogEvent rdf:type owl:Class ;
             rdfs:subClassOf :AuthenticationLogEvent ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasPort ;
                               owl:someValuesFrom xsd:integer
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasTargetUser ;
                               owl:someValuesFrom xsd:string
                             ] ;
             rdfs:comment "Log event corresponding to an activity recorded in SSH logs, including login attempts, session establishment, authentication outcomes, and remote access interactions."@en ;
             rdfs:label "Ssh Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#SuLog
:SuLog rdf:type owl:Class ;
       rdfs:subClassOf :AuthenticationLog ;
       rdfs:comment "Log source capturing events related to the use of the su command, documenting user switching activities and authentication outcomes."@en ;
       rdfs:label "Su Log"@en .


###  http://www.semanticweb.org/AMISecOnto#SuLogEvent
:SuLogEvent rdf:type owl:Class ;
            rdfs:subClassOf :AuthenticationLogEvent ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasAuthenticationMethod ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasFailureReason ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasSuStatus ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTTY ;
                              owl:someValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTargetUser ;
                              owl:someValuesFrom xsd:string
                            ] ;
            rdfs:comment "Log event describing user identity switching activities recorded via the su command, including successful and failed attempts to assume another user identity."@en ;
            rdfs:label "Su Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#Successful
:Successful rdf:type owl:Class ;
            rdfs:subClassOf :Outcome ;
            rdfs:comment "Represents an outcome where a process or action completes as intended without errors."@en ;
            rdfs:label "Successful"@en .


###  http://www.semanticweb.org/AMISecOnto#SudoLog
:SudoLog rdf:type owl:Class ;
         rdfs:subClassOf :AuthenticationLog ;
         rdfs:comment "Log source containing records of commands executed with elevated privileges via sudo, including user identity, executed commands, and timestamps."@en ;
         rdfs:label "Sudo Log"@en .


###  http://www.semanticweb.org/AMISecOnto#SudoLogEvent
:SudoLogEvent rdf:type owl:Class ;
              rdfs:subClassOf :AuthenticationLogEvent ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasCommand ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasRunAsUser ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasSudoStatus ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasTTY ;
                                owl:someValuesFrom xsd:string
                              ] ;
              rdfs:comment "Log event representing privilege escalation actions executed via the sudo command, including command execution with elevated permissions and associated authentication results."@en ;
              rdfs:label "Sudo Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#SuspiciousEvent
:SuspiciousEvent rdf:type owl:Class ;
                 rdfs:comment "A Log event that is considered suspicious due to its association with a known vulnerability, indicator, or anomalous behavior."@en ;
                 rdfs:label "Suspicious Event"@en .


###  http://www.semanticweb.org/AMISecOnto#SystemLog
:SystemLog rdf:type owl:Class ;
           rdfs:subClassOf :Log ;
           rdfs:comment "Represents a log generated by an operating system, host, or infrastructure component to record system-level events."@en ;
           rdfs:label "System Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Threat
:Threat rdf:type owl:Class ;
        rdfs:comment "A potential cause of an unwanted cybersecurity event that may exploit one or more vulnerabilities and negatively affect assets, systems, services, or organizational operations."@en ;
        rdfs:label "Threat"@en .


###  http://www.semanticweb.org/AMISecOnto#Transaction
:Transaction rdf:type owl:Class ;
             rdfs:comment "Represents a discrete exchange or operation involving data, resources, or actions between entities within a system."@en ;
             rdfs:label "Transaction"@en .


###  http://www.semanticweb.org/AMISecOnto/Application
<http://www.semanticweb.org/AMISecOnto/Application> rdf:type owl:Class ;
                                                    rdfs:subClassOf :Entity ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :declaresDependency ;
                                                                      owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Dependency>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :isObservedInProject ;
                                                                      owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Project>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.semanticweb.org/AMISecOnto/isSpecifiedBy> ;
                                                                      owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Project>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.semanticweb.org/AMISecOnto/managedBy> ;
                                                                      owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/DependencyManagementTool>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.semanticweb.org/AMISecOnto/runsOn> ;
                                                                      owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/System>
                                                                    ] ;
                                                    rdfs:comment "A software component or system that runs on a platform and is managed through dependency and build tools."@en ;
                                                    rdfs:label "Application"@en .


###  http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent
<http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/LogEvent> ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :belongsToRequest ;
                                                                              owl:someValuesFrom :Request
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :executedInEnvironment ;
                                                                              owl:someValuesFrom :Environment
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasNextLogEvent> ;
                                                                              owl:allValuesFrom <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent>
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasPreviousLogEvent> ;
                                                                              owl:allValuesFrom <http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent>
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasExceptionMessage ;
                                                                              owl:someValuesFrom xsd:string
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasExceptionType ;
                                                                              owl:someValuesFrom xsd:string
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasProcessID ;
                                                                              owl:someValuesFrom xsd:integer
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasProcessName ;
                                                                              owl:someValuesFrom xsd:string
                                                                            ] ;
                                                            rdfs:comment "Log event generated by an application during runtime, including access operations, execution errors, and container-related messages."@en ;
                                                            rdfs:label "Application Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto/Artifact
<http://www.semanticweb.org/AMISecOnto/Artifact> rdf:type owl:Class ;
                                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/belongsToPackage> ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/SystemPackage>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasDirectDependency> ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Artifact>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasTransitiveDependency> ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Artifact>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasVulnerability> ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Vulnerability>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/isGeneratedFrom> ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/BuildProcess>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/represents> ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Application>
                                                                 ] ;
                                                 rdfs:comment "A generated or consumed build output identified by coordinates or file form, such as a JAR, WAR, POM, or source package. In Maven, artifacts may represent deployable software units or reusable dependency libraries."@en ;
                                                 rdfs:label "Artifact"@en .


###  http://www.semanticweb.org/AMISecOnto/BuildConfiguration
<http://www.semanticweb.org/AMISecOnto/BuildConfiguration> rdf:type owl:Class ;
                                                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                             owl:onProperty :configuredFor ;
                                                                             owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/System>
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty :usedIn ;
                                                                             owl:someValuesFrom :Environment
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasVersion> ;
                                                                             owl:someValuesFrom xsd:string
                                                                           ] ;
                                                           rdfs:comment "A set of build settings and declarations that control how a project is compiled, tested, packaged, and resolved. In Maven, this includes dependency declarations, plugin configurations, repositories, profiles, and packaging options."@en ;
                                                           rdfs:label "Build Configuration"@en .


###  http://www.semanticweb.org/AMISecOnto/BuildProcess
<http://www.semanticweb.org/AMISecOnto/BuildProcess> rdf:type owl:Class ;
                                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.semanticweb.org/AMISecOnto/builds> ;
                                                                       owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Project>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.semanticweb.org/AMISecOnto/consistsOf> ;
                                                                       owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/BuildStep>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.semanticweb.org/AMISecOnto/produces> ;
                                                                       owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Artifact>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.semanticweb.org/AMISecOnto/usesConfiguration> ;
                                                                       owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/BuildConfiguration>
                                                                     ] ;
                                                     rdfs:comment "An execution instance of a build tool over a project and its configuration. It includes the sequence of phases and actions such as dependency resolution, compilation, testing, packaging, and installation."@en ;
                                                     rdfs:label "Build Process"@en .


###  http://www.semanticweb.org/AMISecOnto/BuildStep
<http://www.semanticweb.org/AMISecOnto/BuildStep> rdf:type owl:Class ;
                                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.semanticweb.org/AMISecOnto/uses> ;
                                                                    owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Dependency>
                                                                  ] ;
                                                  rdfs:comment "A distinct phase, goal, or action within a build process. In Maven, examples include validate, compile, test, package, install, deploy, and plugin goal executions."@en ;
                                                  rdfs:label "Build Step"@en .


###  http://www.semanticweb.org/AMISecOnto/CPE
<http://www.semanticweb.org/AMISecOnto/CPE> rdf:type owl:Class ;
                                            rdfs:subClassOf :Entity ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasProduct> ;
                                                              owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Product>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasVendor> ;
                                                              owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Vendor>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasVersionInterval> ;
                                                              owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/VersionInterval>
                                                            ] ;
                                            rdfs:comment "Represents a structured platform identifier describing an affected product in terms of vendor, product name, version constraints, and target hardware. CPE information is used to specify which platforms are affected by a vulnerability."@en ;
                                            rdfs:label "Common Platform Enumeration"@en .


###  http://www.semanticweb.org/AMISecOnto/CVSSMetric
<http://www.semanticweb.org/AMISecOnto/CVSSMetric> rdf:type owl:Class ;
                                                   rdfs:comment "Represents a Common Vulnerability Scoring System (CVSS) assessment associated with a vulnerability, including the CVSS version, base score, qualitative severity level, and vector string describing exploitability and impact characteristics."@en ;
                                                   rdfs:label "Common Vulnerability Scoring System Metric"@en .


###  http://www.semanticweb.org/AMISecOnto/Dependency
<http://www.semanticweb.org/AMISecOnto/Dependency> rdf:type owl:Class ;
                                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :belongsToModule ;
                                                                     owl:someValuesFrom :Module
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :mapsTo ;
                                                                     owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Product>
                                                                   ] ;
                                                   rdfs:comment "Represents an external or internal software component, library, or resource upon which another component, artifact, or build step relies to function, build, or execute correctly."@en ;
                                                   rdfs:label "Dependency"@en .


###  http://www.semanticweb.org/AMISecOnto/DependencyManagementTool
<http://www.semanticweb.org/AMISecOnto/DependencyManagementTool> rdf:type owl:Class ;
                                                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/executes> ;
                                                                                   owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/BuildProcess>
                                                                                 ] ;
                                                                 rdfs:comment "A software tool that manages dependencies, versions, and build configurations for applications, ensuring correct integration of libraries."@en ;
                                                                 rdfs:label "Dependency Management Tool"@en .


###  http://www.semanticweb.org/AMISecOnto/Indicator
<http://www.semanticweb.org/AMISecOnto/Indicator> rdf:type owl:Class ;
                                                  rdfs:comment "Represents an observable piece of information that signals the potential presence of malicious activity or a security-relevant condition."@en ;
                                                  rdfs:label "Indicator"@en .


###  http://www.semanticweb.org/AMISecOnto/LogEvent
<http://www.semanticweb.org/AMISecOnto/LogEvent> rdf:type owl:Class ;
                                                 rdfs:subClassOf :Activity ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :evidenceByLogEvent ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Vulnerability>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasSource ;
                                                                   owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                        owl:unionOf ( :ClassSource
                                                                                                      :Process
                                                                                                      <http://www.semanticweb.org/AMISecOnto/Dependency>
                                                                                                    )
                                                                                      ]
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasIndicator> ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Indicator>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasPackage> ;
