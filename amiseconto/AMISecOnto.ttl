                                                     amiseconto:Fenix_Error_Log_Event
                                                   )
                                     ] ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Specifies the name or identifier of the threat associated with the log event."@en ;
                         rdfs:label "has threat name"@en .


