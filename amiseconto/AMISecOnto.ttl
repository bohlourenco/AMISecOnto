                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( amiseconto:SshLogEvent
                                                     amiseconto:SuLog
                                                   )
                                     ] ;
                         rdfs:range xsd:string ;
                         rdfs:comment "User account that is the target or subject of the action recorded in the log message." ;
                         rdfs:label "has target user"@en .


###  http://www.semanticweb.org/AMISecOnto#hasTextMessage
amiseconto:hasTextMessage rdf:type owl:DatatypeProperty ;
                          rdfs:domain :LogEvent ;
                          rdfs:range xsd:string ;
                          rdfs:label "has text message"@en .


###  http://www.semanticweb.org/AMISecOnto#hasThreatName
amiseconto:hasThreatName rdf:type owl:DatatypeProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
