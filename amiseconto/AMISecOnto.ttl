                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasNextLogEvent> ;
                                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                   owl:onClass <http://www.semanticweb.org/AMISecOnto/LogEvent>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasPreviousLogEvent> ;
                                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                   owl:onClass <http://www.semanticweb.org/AMISecOnto/LogEvent>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasEventType ;
                                                                   owl:someValuesFrom xsd:string
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasHostname ;
                                                                   owl:someValuesFrom xsd:string
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasLogLevel ;
                                                                   owl:someValuesFrom xsd:string
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasPriorityValue ;
                                                                   owl:someValuesFrom xsd:integer
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasRawMessage ;
                                                                   owl:someValuesFrom xsd:string
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :has_syslog_timestamp ;
                                                                   owl:someValuesFrom xsd:dateTime
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasEventTimestamp> ;
                                                                   owl:someValuesFrom xsd:dateTime
                                                                 ] ;
                                                 rdfs:comment "A recorded event generated by a system, application, container platform, or security mechanism, describing operational activity, errors, access attempts, authentication, auditing, or package-management actions."@en ;
                                                 rdfs:label "LogEvent"@en .


###  http://www.semanticweb.org/AMISecOnto/Product
<http://www.semanticweb.org/AMISecOnto/Product> rdf:type owl:Class ;
                                                rdfs:comment "A software or hardware product that may be affected by a vulnerability or may generate operational and security logs. Products are typically identified through CPE information and associated with a vendor and one or more versions."@en ;
                                                rdfs:label "Product"@en .


###  http://www.semanticweb.org/AMISecOnto/Project
<http://www.semanticweb.org/AMISecOnto/Project> rdf:type owl:Class ;
                                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasConfiguration> ;
                                                                  owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/BuildConfiguration>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasRootArtifact> ;
                                                                  owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Artifact>
                                                                ] ;
                                                rdfs:comment "A buildable software project definition, typically corresponding to a Maven project described by a pom.xml file. It specifies dependencies, plugins, packaging, modules, and metadata required to produce artifacts."@en ;
                                                rdfs:label "Project"@en .


###  http://www.semanticweb.org/AMISecOnto/Reference
<http://www.semanticweb.org/AMISecOnto/Reference> rdf:type owl:Class ;
                                                  rdfs:comment "An external information source related to a vulnerability, such as a vendor advisory, source-code commit, patch, exploit discussion, issue tracker entry, or mailing list post. A reference may include a URL, source identifier, and semantic tags describing its role."@en ;
                                                  rdfs:label "Reference"@en .


###  http://www.semanticweb.org/AMISecOnto/SecurityLogEvent
<http://www.semanticweb.org/AMISecOnto/SecurityLogEvent> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/LogEvent> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasNextLogEvent> ;
                                                                           owl:allValuesFrom <http://www.semanticweb.org/AMISecOnto/SecurityLogEvent>
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasPreviousLogEvent> ;
                                                                           owl:allValuesFrom <http://www.semanticweb.org/AMISecOnto/SecurityLogEvent>
                                                                         ] ;
                                                         rdfs:comment "Log event related to security-relevant activity such as authentication, authorization, auditing, policy enforcement, or suspicious behavior detection."@en ;
                                                         rdfs:label "Security Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto/Severity
<http://www.semanticweb.org/AMISecOnto/Severity> rdf:type owl:Class ;
                                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasBaseScore> ;
                                                                   owl:someValuesFrom xsd:decimal
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasBaseSeverity> ;
                                                                   owl:someValuesFrom xsd:string
                                                                 ] ;
                                                 rdfs:comment "The level of impact or criticality associated with a vulnerability or issue."@en ;
                                                 rdfs:label "Severity"@en .


###  http://www.semanticweb.org/AMISecOnto/SeverityLevel
<http://www.semanticweb.org/AMISecOnto/SeverityLevel> rdf:type owl:Class ;
                                                      rdfs:comment "The qualitative severity classification assigned to a vulnerability or security event, such as LOW, MEDIUM, HIGH, or CRITICAL, typically derived from a scoring framework such as CVSS."@en ;
                                                      rdfs:label "Security Level"@en .


###  http://www.semanticweb.org/AMISecOnto/SoftwareBillsOfMaterial
<http://www.semanticweb.org/AMISecOnto/SoftwareBillsOfMaterial> rdf:type owl:Class ;
                                                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <http://www.semanticweb.org/AMISecOnto/describes> ;
                                                                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                       owl:unionOf ( <http://www.semanticweb.org/AMISecOnto/Application>
                                                                                                                     <http://www.semanticweb.org/AMISecOnto/SoftwareComponent>
                                                                                                                   )
                                                                                                     ]
                                                                                ] ;
                                                                rdfs:comment "A structured inventory of components, libraries, and dependencies that make up a software system."@en ;
                                                                rdfs:label "Software Bills of Material"@en .


###  http://www.semanticweb.org/AMISecOnto/SoftwareComponent
<http://www.semanticweb.org/AMISecOnto/SoftwareComponent> rdf:type owl:Class ;
                                                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.semanticweb.org/AMISecOnto/dependsOn> ;
                                                                            owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/SoftwareComponent>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.semanticweb.org/AMISecOnto/exposes> ;
                                                                            owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Vulnerability>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.semanticweb.org/AMISecOnto/isDescribedBySBOM> ;
                                                                            owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/SoftwareBillsOfMaterial>
                                                                          ] ;
                                                          rdfs:comment "A modular and reusable unit of software that forms part of a larger system."@en ;
                                                          rdfs:label "Software Component"@en .


###  http://www.semanticweb.org/AMISecOnto/System
<http://www.semanticweb.org/AMISecOnto/System> rdf:type owl:Class ;
                                               rdfs:subClassOf :Entity ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :hasOperatingSystem ;
                                                                 owl:someValuesFrom :OperatingSystem
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.semanticweb.org/AMISecOnto/registersLogEvent> ;
                                                                 owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/LogEvent>
                                                               ] ;
                                               rdfs:comment "The underlying computing environment or platform on which applications are executed."@en ;
                                               rdfs:label "System"@en .


###  http://www.semanticweb.org/AMISecOnto/SystemLogEvent
<http://www.semanticweb.org/AMISecOnto/SystemLogEvent> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/LogEvent> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasNextLogEvent> ;
                                                                         owl:allValuesFrom <http://www.semanticweb.org/AMISecOnto/SystemLogEvent>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasPreviousLogEvent> ;
                                                                         owl:allValuesFrom <http://www.semanticweb.org/AMISecOnto/SystemLogEvent>
                                                                       ] ;
                                                       rdfs:comment "Log event generated by the operating system or its core services, including package management, service execution, kernel activity, and host-level operational changes."@en ;
                                                       rdfs:label "System Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto/SystemPackage
<http://www.semanticweb.org/AMISecOnto/SystemPackage> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.semanticweb.org/AMISecOnto/SoftwareComponent> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :installedOn ;
                                                                        owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/System>
                                                                      ] ;
                                                      rdfs:comment "A System Package refers to a software package that is part of the core operating system environment or is installed and managed at the system level by the OS package manager (e.g., dpkg, apt, rpm, yum)."@en ;
                                                      rdfs:label "Package System"@en .


###  http://www.semanticweb.org/AMISecOnto/User
<http://www.semanticweb.org/AMISecOnto/User> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ,
                                                             <http://xmlns.com/foaf/0.1/Person> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasUserID> ;
                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasUsername> ;
                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                             ] ;
                                             rdfs:comment "A human or system entity performing actions in the system. Identified by username/ID for audit trail purposes. Aligned with PROV:Agent for provenance tracking and FOAF:Person for identity properties. Applications may also use FOAF properties (foaf:name, foaf:mbox) for extended identity information."@en ;
                                             rdfs:label "User"@en .


###  http://www.semanticweb.org/AMISecOnto/Vendor
<http://www.semanticweb.org/AMISecOnto/Vendor> rdf:type owl:Class ;
                                               rdfs:subClassOf :Entity ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasProduct> ;
                                                                 owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Product>
                                                               ] ;
                                               rdfs:comment "The organization, project, or distributor responsible for producing, maintaining, or distributing a product affected by a vulnerability."@en ;
                                               rdfs:label "Vendor"@en .


###  http://www.semanticweb.org/AMISecOnto/Version
<http://www.semanticweb.org/AMISecOnto/Version> rdf:type owl:Class ;
                                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasVersion> ;
                                                                  owl:someValuesFrom xsd:string
                                                                ] ;
                                                rdfs:comment "A specific product release or a bounded version range used to describe affected or unaffected product configurations in vulnerability records."@en ;
                                                rdfs:label "Version"@en .


###  http://www.semanticweb.org/AMISecOnto/VersionInterval
<http://www.semanticweb.org/AMISecOnto/VersionInterval> rdf:type owl:Class ;
                                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasVersionMaxIncluding> ;
                                                                          owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Version>
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasVersionMinIncluding> ;
                                                                          owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Version>
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasIntervalLabel> ;
                                                                          owl:someValuesFrom xsd:string
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasTargetHardware> ;
                                                                          owl:someValuesFrom xsd:string
                                                                        ] ;
                                                        rdfs:comment "A range of software versions defined by minimum and/or maximum boundaries, often used to describe affected versions."@en ;
                                                        rdfs:label "Version Interval"@en .


###  http://www.semanticweb.org/AMISecOnto/Vulnerability
<http://www.semanticweb.org/AMISecOnto/Vulnerability> rdf:type owl:Class ;
                                                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :relatedToProduct ;
                                                                        owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Product>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/AMISecOnto/affectsCPE> ;
                                                                        owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/CPE>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasCVSSMetric> ;
                                                                        owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/CVSSMetric>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasReference> ;
                                                                        owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Reference>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasWeakness> ;
                                                                        owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/Weakness>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/AMISecOnto/isObservedIn> ;
                                                                        owl:someValuesFrom <http://www.semanticweb.org/AMISecOnto/LogEvent>
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasDescription> ;
                                                                        owl:someValuesFrom xsd:string
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasPubDate> ;
                                                                        owl:someValuesFrom xsd:dateTime
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasReferenceURL> ;
                                                                        owl:someValuesFrom xsd:string
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/AMISecOnto/hasCVEId> ;
                                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                        owl:onDataRange xsd:string
                                                                      ] ;
                                                      rdfs:comment "A disclosed security flaw affecting one or more software or hardware products. A vulnerability may include a textual description, publication date, severity metrics, affected platform definitions, and external references to advisories, patches, exploits, or vendor information."@en ;
                                                      rdfs:label "Vulnerability"@en .


###  http://www.semanticweb.org/AMISecOnto/Weakness
<http://www.semanticweb.org/AMISecOnto/Weakness> rdf:type owl:Class ;
                                                 rdfs:comment "The underlying software or design weakness that gives rise to a vulnerability, typically aligned with a controlled taxonomy such as CWE."@en ;
                                                 rdfs:label "Weakness"@en .


###  http://www.w3.org/2000/10/swap/pim/contact#Person
<http://www.w3.org/2000/10/swap/pim/contact#Person> rdf:type owl:Class ;
                                                    rdfs:comment "Represents an individual human actor involved in system-related activities. This class is reused from the FOAF (Friend of a Friend) ontology and is used to model users, administrators, developers, or other stakeholders who interact with applications, systems, or security processes."@en ;
                                                    rdfs:label "Person"@en .


