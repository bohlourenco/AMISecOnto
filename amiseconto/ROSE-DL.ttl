@prefix : <http://rose.com/nis2/art21/riskassessment#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://rose.com/nis2/art21/riskassessment> .

<http://rose.com/nis2/art21/riskassessment> rdf:type owl:Ontology ;
                              owl:versionIRI <http://rose.com/nis2/art21/riskassessment/1.0.0> ;
                              rdfs:label "ROSE DL Subset"@en ;
                              rdfs:comment "Subset module of the ROSE NIS2 Article 21 ontology, restricted to the Risk Assessment branch: assessment relators, assessor/subject agents, assessed dispositions, resulting qualities, and the linked risk events."@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/nemo/gufo#categorizes
gufo:categorizes rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://rose.com#experienceRiskAssesmentHasThreatCapability
<http://rose.com#experienceRiskAssesmentHasThreatCapability> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <http://rose.com#ExperienceRiskAssesment> ;
                                                             rdfs:range <http://rose.com#ThreatCapability> ;
                                                             rdfs:subPropertyOf owl:topObjectProperty ;
                                                             rdfs:label "experience risk assessment has threat capability"@en .


###  http://rose.com#experienceRiskAssesmentHasVulnerability
<http://rose.com#experienceRiskAssesmentHasVulnerability> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <http://rose.com#ExperienceRiskAssesment> ;
                                                          rdfs:range <http://rose.com#Vulnerability> ;
                                                          rdfs:subPropertyOf owl:topObjectProperty ;
                                                          rdfs:label "experience risk assessment has vulnerability"@en .


###  http://rose.com#objectRiskAssesmentHasExperienceRiskAssesment
<http://rose.com#objectRiskAssesmentHasExperienceRiskAssesment> rdf:type owl:ObjectProperty ;
                                                                rdfs:domain <http://rose.com#ObjectRiskAssesment> ;
                                                                rdfs:range <http://rose.com#ExperienceRiskAssesment> ;
                                                                rdfs:subPropertyOf owl:topObjectProperty ;
                                                                rdfs:label "object risk assessment has experience risk assessment"@en .


###  http://rose.com#riskExperienceHasRiskEvent
<http://rose.com#riskExperienceHasRiskEvent> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://rose.com#RiskExperience> ;
                                             rdfs:range <http://rose.com#RiskEvent> ;
                                             rdfs:subPropertyOf owl:topObjectProperty ;
                                             rdfs:label "risk experience has risk event"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/nemo/gufo#ConcreteIndividualType
gufo:ConcreteIndividualType rdf:type owl:Class ;
                            rdfs:subClassOf owl:Thing .


###  http://purl.org/nemo/gufo#Event
gufo:Event rdf:type owl:Class ;
           rdfs:subClassOf owl:Thing .


###  http://purl.org/nemo/gufo#FunctionalComplex
gufo:FunctionalComplex rdf:type owl:Class ;
                       rdfs:subClassOf owl:Thing .


###  http://purl.org/nemo/gufo#IntrinsicMode
gufo:IntrinsicMode rdf:type owl:Class ;
                   rdfs:subClassOf owl:Thing .


###  http://purl.org/nemo/gufo#Quality
gufo:Quality rdf:type owl:Class ;
             rdfs:subClassOf owl:Thing .


###  http://purl.org/nemo/gufo#Relator
gufo:Relator rdf:type owl:Class ;
             rdfs:subClassOf owl:Thing .


###  http://rose.com#CausalLikelihood
<http://rose.com#CausalLikelihood> rdf:type owl:Class ;
                                   rdfs:subClassOf gufo:Quality ;
                                   rdfs:label "Causal Likelihood"@en .


###  http://rose.com#Disposition
<http://rose.com#Disposition> rdf:type owl:Class ;
                              rdfs:subClassOf gufo:IntrinsicMode ;
                              rdfs:label "Disposition"@en .


###  http://rose.com#ExperienceRiskAssesment
<http://rose.com#ExperienceRiskAssesment> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://rose.com#RiskAssessment> ;
                                          rdfs:label "Experience Risk Assesment"@en .


###  http://rose.com#ObjectRiskAssesment
<http://rose.com#ObjectRiskAssesment> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://rose.com#RiskAssessment> ;
                                      rdfs:label "Object Risk Assesment"@en .


###  http://rose.com#Risk
<http://rose.com#Risk> rdf:type owl:Class ;
                       rdfs:subClassOf gufo:Quality ;
                       rdfs:label "Risk"@en .


###  http://rose.com#RiskAssessment
<http://rose.com#RiskAssessment> rdf:type owl:Class ;
                                 rdfs:subClassOf gufo:Relator ;
                                 rdfs:label "Risk Assessment"@en .


###  http://rose.com#RiskAssessor
<http://rose.com#RiskAssessor> rdf:type owl:Class ;
                               rdfs:subClassOf <http://rose.com#UFOAgent> ;
                               rdfs:label "Risk Assessor"@en .


###  http://rose.com#RiskEvent
<http://rose.com#RiskEvent> rdf:type owl:Class ;
                            rdfs:subClassOf gufo:Event ;
                            rdfs:label "Risk Event"@en .


###  http://rose.com#RiskEventType
<http://rose.com#RiskEventType> rdf:type owl:Class ;
                                rdfs:subClassOf gufo:ConcreteIndividualType ;
                                gufo:categorizes <http://rose.com#RiskEvent> ;
                                rdfs:label "Risk Event Type"@en .


###  http://rose.com#RiskExperience
<http://rose.com#RiskExperience> rdf:type owl:Class ;
                                 rdfs:subClassOf gufo:Event ;
                                 rdfs:label "Risk Experience"@en .


###  http://rose.com#RiskSubject
<http://rose.com#RiskSubject> rdf:type owl:Class ;
                              rdfs:subClassOf <http://rose.com#UFOAgent> ;
                              rdfs:label "Risk Subject"@en .


###  http://rose.com#ThreatCapability
<http://rose.com#ThreatCapability> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://rose.com#Disposition> ;
                                   rdfs:label "Threat Capability"@en .


###  http://rose.com#ThreatCapabilityType
<http://rose.com#ThreatCapabilityType> rdf:type owl:Class ;
                                       rdfs:subClassOf gufo:ConcreteIndividualType ;
                                       gufo:categorizes <http://rose.com#ThreatCapability> ;
                                       rdfs:label "Threat Capability Type"@en .


###  http://rose.com#TriggeringLikelihood
<http://rose.com#TriggeringLikelihood> rdf:type owl:Class ;
                                       rdfs:subClassOf gufo:Quality ;
                                       rdfs:label "Triggering Likelihood"@en .


###  http://rose.com#UFOAgent
<http://rose.com#UFOAgent> rdf:type owl:Class ;
                           rdfs:subClassOf gufo:FunctionalComplex ;
                           rdfs:label "UFO::Agent"@en .


###  http://rose.com#Vulnerability
<http://rose.com#Vulnerability> rdf:type owl:Class ;
                                rdfs:subClassOf <http://rose.com#Disposition> ;
                                rdfs:label "Vulnerability"@en .


###  http://rose.com#VulnerabilityType
<http://rose.com#VulnerabilityType> rdf:type owl:Class ;
                                    rdfs:subClassOf gufo:ConcreteIndividualType ;
                                    gufo:categorizes <http://rose.com#Vulnerability> ;
                                    rdfs:label "Vulnerability Type"@en .


#################################################################
#    Data properties
#################################################################

#  NOTE: the source ROSE NIS2 Article 21 ontology (rose_nis2_art21_extracted.owl)
#  defines no owl:DatatypeProperty individuals. This subset therefore declares
#  none either, to stay faithful to the source. If you need literal-valued
#  attributes (e.g. a numeric/qualitative value for Risk, CausalLikelihood, or
#  TriggeringLikelihood, or a timestamp for a RiskAssessment), let me know and
#  I will add them explicitly rather than inferring them silently.


#################################################################
#    Hierarchy
#################################################################

#  gUFO anchors
gufo:Relator rdfs:subClassOf owl:Thing .
gufo:Event rdfs:subClassOf owl:Thing .
gufo:Quality rdfs:subClassOf owl:Thing .
gufo:FunctionalComplex rdfs:subClassOf owl:Thing .
gufo:IntrinsicMode rdfs:subClassOf owl:Thing .
gufo:ConcreteIndividualType rdfs:subClassOf owl:Thing .

#  Risk Assessment relator branch
<http://rose.com#RiskAssessment> rdfs:subClassOf gufo:Relator .
<http://rose.com#ExperienceRiskAssesment> rdfs:subClassOf <http://rose.com#RiskAssessment> .
<http://rose.com#ObjectRiskAssesment> rdfs:subClassOf <http://rose.com#RiskAssessment> .

#  Agents involved in assessment
<http://rose.com#UFOAgent> rdfs:subClassOf gufo:FunctionalComplex .
<http://rose.com#RiskAssessor> rdfs:subClassOf <http://rose.com#UFOAgent> .
<http://rose.com#RiskSubject> rdfs:subClassOf <http://rose.com#UFOAgent> .

#  Dispositions assessed (threat capability / vulnerability)
<http://rose.com#Disposition> rdfs:subClassOf gufo:IntrinsicMode .
<http://rose.com#ThreatCapability> rdfs:subClassOf <http://rose.com#Disposition> .
<http://rose.com#Vulnerability> rdfs:subClassOf <http://rose.com#Disposition> .

#  Types categorizing the dispositions and events
<http://rose.com#ThreatCapabilityType> rdfs:subClassOf gufo:ConcreteIndividualType .
<http://rose.com#VulnerabilityType> rdfs:subClassOf gufo:ConcreteIndividualType .
<http://rose.com#RiskEventType> rdfs:subClassOf gufo:ConcreteIndividualType .

#  Qualities resulting from assessment
<http://rose.com#Risk> rdfs:subClassOf gufo:Quality .
<http://rose.com#CausalLikelihood> rdfs:subClassOf gufo:Quality .
<http://rose.com#TriggeringLikelihood> rdfs:subClassOf gufo:Quality .

#  Events linked to the assessment
<http://rose.com#RiskExperience> rdfs:subClassOf gufo:Event .
<http://rose.com#RiskEvent> rdfs:subClassOf gufo:Event .
