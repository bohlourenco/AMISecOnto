                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasClientIp ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasEventTimestamp ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasIdentity ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasRequestLine ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasResponseSize ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasStatusCode ;
                                 owl:someValuesFrom xsd:string
                               ] ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Records the timestamp of the event, enabling temporal analysis, ordering of events, and correlation across logs."@en ;
                   rdfs:label "has event timestamp"@en .


###  http://www.semanticweb.org/AMISecOnto/hasIdentity
:hasIdentity rdf:type owl:DatatypeProperty ;
             rdfs:domain :AccessLogEvent ,
                         :ApplicationLogEvent ,
                         :LogEvent ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasNextLogEvent ;
                           owl:someValuesFrom :LogEvent
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasPreviousLogEvent ;
                           owl:someValuesFrom :LogEvent
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasAuthenticatedUser ;
                           owl:someValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasClientIp ;
                           owl:someValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasEventTimestamp ;
                           owl:someValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasIdentity ;
                           owl:someValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasRequestLine ;
                           owl:someValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasResponseSize ;
                           owl:someValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasStatusCode ;
                           owl:someValuesFrom xsd:string
                         ] ;
             rdfs:range xsd:string ;
             rdfs:comment "Associates the event with a specific identity, which may be authenticated or unauthenticated, depending on context."@en ;
             rdfs:label "has identity"@en .


###  http://www.semanticweb.org/AMISecOnto/hasIntervalLabel
:hasIntervalLabel rdf:type owl:DatatypeProperty ;
                  rdfs:domain :VersionInterval ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasVersionMaxIncluding ;
                                owl:someValuesFrom :Version
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasVersionMinIncluding ;
                                owl:someValuesFrom :Version
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasIntervalLabel ;
                                owl:someValuesFrom xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasTargetHardware ;
                                owl:someValuesFrom xsd:string
                              ] ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Indicates the qualitative severity category derived from the CVSS base score (e.g., Low, Medium, High, Critical)."@en ;
                  rdfs:label "has interval label"@en .


###  http://www.semanticweb.org/AMISecOnto/hasPubDate
:hasPubDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Vulnerability ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :affectsCPE ;
                          owl:someValuesFrom :CPE
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasDescription ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasPubDate ;
                          owl:someValuesFrom xsd:dateTime
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasReferenceURL ;
                          owl:someValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasCVEId ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ;
            rdfs:range xsd:dateTime ;
            rdfs:comment "Specifies the date on which the vulnerability entry was officially published in a vulnerability database such as the National Vulnerability Database (NVD)."@en ;
            rdfs:label "has publication date"@en .


###  http://www.semanticweb.org/AMISecOnto/hasReferenceURL
:hasReferenceURL rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Links to external resources related to the vulnerability, such as security advisories, vendor bulletins, patches, technical analyses, or vulnerability reports."@en ;
                 rdfs:label "has reference URL"@en .


###  http://www.semanticweb.org/AMISecOnto/hasRequestLine
:hasRequestLine rdf:type owl:DatatypeProperty ;
                rdfs:comment "Contains the complete request line, including HTTP method, requested resource, and protocol version, providing detailed request context."@en ;
                rdfs:label "has request line"@en .


###  http://www.semanticweb.org/AMISecOnto/hasResponseSize
:hasResponseSize rdf:type owl:DatatypeProperty ;
                 rdfs:domain :AccessLogEvent ,
                             :ApplicationLogEvent ,
                             :LogEvent ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasNextLogEvent ;
                               owl:someValuesFrom :LogEvent
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasPreviousLogEvent ;
                               owl:someValuesFrom :LogEvent
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasAuthenticatedUser ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasClientIp ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasEventTimestamp ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasIdentity ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasRequestLine ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasResponseSize ;
                               owl:someValuesFrom xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasStatusCode ;
                               owl:someValuesFrom xsd:string
                             ] ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Specifies the payload size of the server response, useful for performance monitoring and anomaly detection."@en ;
                 rdfs:label "has response size"@en .


###  http://www.semanticweb.org/AMISecOnto/hasSource
:hasSource rdf:type owl:DatatypeProperty ;
           rdfs:domain :Vulnerability ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :affectsCPE ;
                         owl:someValuesFrom :CPE
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasDescription ;
                         owl:someValuesFrom xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasPubDate ;
                         owl:someValuesFrom xsd:dateTime
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasReferenceURL ;
                         owl:someValuesFrom xsd:string
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasCVEId ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ;
           rdfs:range xsd:string ;
           rdfs:comment "Identifies the organization or entity that reported, published, or maintains the vulnerability information, such as NVD, MITRE, or a specific vendor."@en ;
           rdfs:label "has source"@en .


###  http://www.semanticweb.org/AMISecOnto/hasStatusCode
:hasStatusCode rdf:type owl:DatatypeProperty ;
               rdfs:comment "Encodes the outcome of the request using standard HTTP status codes (e.g., 200, 404, 500), supporting error analysis and monitoring."@en ;
               rdfs:label "has status code"@en .


###  http://www.semanticweb.org/AMISecOnto/hasTag
:hasTag rdf:type owl:DatatypeProperty ;
        rdfs:domain :Vulnerability ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :affectsCPE ;
                      owl:someValuesFrom :CPE
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasDescription ;
                      owl:someValuesFrom xsd:string
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasPubDate ;
                      owl:someValuesFrom xsd:dateTime
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasReferenceURL ;
                      owl:someValuesFrom xsd:string
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasCVEId ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onDataRange xsd:string
                    ] ;
        rdfs:range xsd:string ;
        rdfs:comment "Associates descriptive tags or keywords with the vulnerability to facilitate categorization, filtering, and analysis.  It serves as a shorthand method to provide contextual data regarding the CVE Record."@en ;
        rdfs:label "has tag"@en .


###  http://www.semanticweb.org/AMISecOnto/hasTargetHardware
:hasTargetHardware rdf:type owl:DatatypeProperty ;
                   rdfs:domain :VersionInterval ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasVersionMaxIncluding ;
                                 owl:someValuesFrom :Version
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasVersionMinIncluding ;
                                 owl:someValuesFrom :Version
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasIntervalLabel ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasTargetHardware ;
                                 owl:someValuesFrom xsd:string
                               ] ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Specifies the hardware platform, device type, or architecture affected by the vulnerability."@en ;
                   rdfs:label "has target hardware"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionName
:hasVersionName rdf:type owl:DatatypeProperty ;
                rdfs:comment "Identifies the name of the versioned component (e.g., application or API name) associated with the event."@en ;
                rdfs:label "has version name"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionValue
:hasVersionValue rdf:type owl:DatatypeProperty ;
                 rdfs:comment "Specifies the version identifier  corresponding to the associated system or component."@en ;
                 rdfs:label "has version value"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/AMISecOnto#SuspiciousEvent
amiseconto:SuspiciousEvent rdf:type owl:Class ;
                           rdfs:comment "Represents a Log Event that is considered suspicious due to its association with a known vulnerability, indicator, or anomalous behavior."@en .


###  http://www.semanticweb.org/AMISecOnto/AccessLogEvent
:AccessLogEvent rdf:type owl:Class ;
                rdfs:subClassOf :ApplicationLogEvent ,
                                :LogEvent ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasNextLogEvent ;
                                  owl:someValuesFrom :LogEvent
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasPreviousLogEvent ;
                                  owl:someValuesFrom :LogEvent
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasAuthenticatedUser ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasClientIp ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasEventTimestamp ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasIdentity ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasRequestLine ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasResponseSize ;
                                  owl:someValuesFrom xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasStatusCode ;
                                  owl:someValuesFrom xsd:string
                                ] ;
                rdfs:comment "An application-layer event representing an access/request to a service or resource (e.g., HTTP request), typically capturing source, target, and outcome."@en ;
                rdfs:label "Access log event"@en .


###  http://www.semanticweb.org/AMISecOnto/Application
:Application rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :managedBy ;
                               owl:someValuesFrom :DependencyManagementTool
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :runsOn ;
                               owl:someValuesFrom :System
                             ] ;
             rdfs:comment "A software component or system that runs on a platform and is managed through dependency and build tools."@en ;
             rdfs:label "Application"@en .


###  http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent
:ApplicationLogEvent rdf:type owl:Class ;
                     rdfs:subClassOf :LogEvent ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasNextLogEvent ;
                                       owl:someValuesFrom :LogEvent
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasPreviousLogEvent ;
                                       owl:someValuesFrom :LogEvent
                                     ] ;
                     rdfs:comment "Represents a log event generated by an application during runtime, including access operations, execution errors, and container-related messages."@en ;
                     rdfs:label "Application Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto/Artifact
:Artifact rdf:type owl:Class ;
          rdfs:comment "A generated or consumed build output identified by coordinates or file form, such as a JAR, WAR, POM, or source package. In Maven, artifacts may represent deployable software units or reusable dependency libraries."@en ;
          rdfs:label "Artifact"@en .


###  http://www.semanticweb.org/AMISecOnto/AuditLogEvent
:AuditLogEvent rdf:type owl:Class ;
               rdfs:subClassOf :LogEvent ,
                               :SecurityLogEvent ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasNextLogEvent ;
                                 owl:someValuesFrom :LogEvent
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasPreviousLogEvent ;
                                 owl:someValuesFrom :LogEvent
                               ] ;
               rdfs:comment "An event capturing a security-relevant action for traceability and compliance (who did what, when, and where)."@en ;
               rdfs:label "Audit log event"@en .


###  http://www.semanticweb.org/AMISecOnto/AuthLogEvent
:AuthLogEvent rdf:type owl:Class ;
              rdfs:subClassOf :LogEvent ,
                              :SecurityLogEvent ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasNextLogEvent ;
                                owl:someValuesFrom :LogEvent
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasPreviousLogEvent ;
                                owl:someValuesFrom :LogEvent
                              ] ;
              rdfs:comment "An identity and access event describing authentication/authorization actions, including successes and failures."@en ;
              rdfs:label "Auth log event"@en .


###  http://www.semanticweb.org/AMISecOnto/BuildConfiguration
:BuildConfiguration rdf:type owl:Class ;
                    rdfs:comment "A set of build settings and declarations that control how a project is compiled, tested, packaged, and resolved. In Maven, this includes dependency declarations, plugin configurations, repositories, profiles, and packaging options."@en ;
                    rdfs:label "Build Configuration"@en .


###  http://www.semanticweb.org/AMISecOnto/BuildProcess
:BuildProcess rdf:type owl:Class ;
              rdfs:comment "An execution instance of a build tool over a project and its configuration. It includes the sequence of phases and actions such as dependency resolution, compilation, testing, packaging, and installation."@en ;
              rdfs:label "Build Process"@en .


###  http://www.semanticweb.org/AMISecOnto/BuildStep
:BuildStep rdf:type owl:Class ;
           rdfs:comment "A distinct phase, goal, or action within a build process. In Maven, examples include validate, compile, test, package, install, deploy, and plugin goal executions."@en ;
           rdfs:label "Build Step"@en .


###  http://www.semanticweb.org/AMISecOnto/CPE
:CPE rdf:type owl:Class ;
     rdfs:subClassOf [ rdf:type owl:Class ;
                       owl:unionOf ( :CPE
                                     :Product
                                   )
                     ] ,
                     [ rdf:type owl:Class ;
                       owl:unionOf ( :CPE
                                     :Vendor
                                   )
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasVendor ;
                       owl:someValuesFrom :Vendor
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasVersionInterval ;
                       owl:someValuesFrom :VersionInterval
                     ] ;
     rdfs:comment "Represents a structured platform identifier describing an affected product in terms of vendor, product name, version constraints, and target hardware. CPE information is used to specify which platforms are affected by a vulnerability."@en ;
     rdfs:label "Common Platform Enumeration"@en .


###  http://www.semanticweb.org/AMISecOnto/CVSSMetric
:CVSSMetric rdf:type owl:Class ;
            rdfs:comment "Represents a Common Vulnerability Scoring System (CVSS) assessment associated with a vulnerability, including the CVSS version, base score, qualitative severity level, and vector string describing exploitability and impact characteristics."@en ;
            rdfs:label "Common Vulnerability Scoring System Metric"@en .


###  http://www.semanticweb.org/AMISecOnto/ContainerLogEvent
:ContainerLogEvent rdf:type owl:Class ;
                   rdfs:subClassOf :ApplicationLogEvent ,
                                   :LogEvent ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasNextLogEvent ;
                                     owl:someValuesFrom :LogEvent
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasPreviousLogEvent ;
                                     owl:someValuesFrom :LogEvent
                                   ] ;
                   rdfs:comment """An event related to containerized execution, produced by container runtimes or orchestrators:

FenixEdu Logs (Apache Tomcat)
catalina.out
Primary JVM/system log for the Tomcat instance. Captures standard output and error streams (stdout / stderr), uncaught exceptions, stack traces, and low-level system or JVM errors

catalina.<date>.log
Daily rotated Catalina container log. Records Tomcat startup and shutdown sequences, container lifecycle events, application deployment/undeployment actions, and internal status messages"""@en ;
                   rdfs:label "Container log event"@en .


###  http://www.semanticweb.org/AMISecOnto/Dependency
:Dependency rdf:type owl:Class ;
            rdfs:comment "Represents an external or internal software component, library, or resource upon which another component, artifact, or build step relies to function, build, or execute correctly."@en ;
            rdfs:label "Dependency"@en .


###  http://www.semanticweb.org/AMISecOnto/DependencyLibrary
:DependencyLibrary rdf:type owl:Class ;
                   rdfs:subClassOf :Library ,
                                   :SoftwareComponent ;
                   rdfs:comment "An external or internal reusable software library declared as a dependency in a Maven project and resolved during the build process."@en ;
                   rdfs:label "Dependency Library"@en .


###  http://www.semanticweb.org/AMISecOnto/DependencyManagementTool
:DependencyManagementTool rdf:type owl:Class ;
                          rdfs:comment "A software tool that manages dependencies, versions, and build configurations for applications, ensuring correct integration of libraries."@en ;
                          rdfs:label "Dependency Management Tool"@en .


###  http://www.semanticweb.org/AMISecOnto/ErrorLogEvent
:ErrorLogEvent rdf:type owl:Class ;
               rdfs:subClassOf :ApplicationLogEvent ,
                               :LogEvent ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasNextLogEvent ;
                                 owl:someValuesFrom :LogEvent
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasPreviousLogEvent ;
                                 owl:someValuesFrom :LogEvent
                               ] ;
               rdfs:comment "Represents an application- or service-level error event, including exceptions and failure conditions, as recorded in fenix.log, intended to support troubleshooting, root-cause analysis, and anomaly detection."@en ;
               rdfs:label "Error log event"@en .


###  http://www.semanticweb.org/AMISecOnto/FirewallLogEvent
:FirewallLogEvent rdf:type owl:Class ;
                  rdfs:subClassOf :LogEvent ,
                                  :SecurityLogEvent ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasNextLogEvent ;
                                    owl:someValuesFrom :LogEvent
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasPreviousLogEvent ;
                                    owl:someValuesFrom :LogEvent
                                  ] ;
                  rdfs:comment "A network enforcement event recorded by a firewall, representing allow/deny decisions and associated traffic metadata."@en ;
                  rdfs:label "Firewall log event"@en .


###  http://www.semanticweb.org/AMISecOnto/Indicator
:Indicator rdf:type owl:Class ;
           rdfs:comment "Represents an observable piece of information that signals the potential presence of malicious activity or a security-relevant condition."@en ;
           rdfs:label "Indicator"@en .


###  http://www.semanticweb.org/AMISecOnto/Library
:Library rdf:type owl:Class ;
         rdfs:subClassOf :SoftwareComponent ;
         rdfs:comment "A reusable collection of code that provides functionality to other software components or applications."@en ;
         rdfs:label "Library"@en .


###  http://www.semanticweb.org/AMISecOnto/LogEvent
:LogEvent rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasNextLogEvent ;
                            owl:someValuesFrom :LogEvent
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasPreviousLogEvent ;
                            owl:someValuesFrom :LogEvent
                          ] ;
          rdfs:comment "Represents a recorded event generated by a system, application, container platform, or security mechanism, describing operational activity, errors, access attempts, authentication, auditing, or package-management actions."@en ;
          rdfs:label "LogEvent"@en .


###  http://www.semanticweb.org/AMISecOnto/Package
:Package rdf:type owl:Class ;
         rdfs:subClassOf :SoftwareComponent ;
         rdfs:comment "A distributable unit of software, such as a library or module, identified by name and version."@en ;
         rdfs:label "Package"@en .


###  http://www.semanticweb.org/AMISecOnto/PackageLogEvent
:PackageLogEvent rdf:type owl:Class ;
                 rdfs:subClassOf :LogEvent ,
                                 :SystemLogEvent ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasNextLogEvent ;
                                   owl:someValuesFrom :LogEvent
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasPreviousLogEvent ;
                                   owl:someValuesFrom :LogEvent
                                 ] ;
                 rdfs:comment "An event recorded by the package management system describing an operation or state change involving a software package on a host."@en ;
                 rdfs:label "Package log event"@en .


###  http://www.semanticweb.org/AMISecOnto/Product
:Product rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Class ;
                           owl:unionOf ( :CPE
                                         :Product
                                       )
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasVendor ;
                           owl:someValuesFrom :Vendor
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasVersion ;
                           owl:someValuesFrom :Version
                         ] ;
         rdfs:comment "Represents a software or hardware product that may be affected by a vulnerability or may generate operational and security logs. Products are typically identified through CPE information and associated with a vendor and one or more versions."@en ;
         rdfs:label "Product"@en .


###  http://www.semanticweb.org/AMISecOnto/Project
:Project rdf:type owl:Class ;
         rdfs:comment "A buildable software project definition, typically corresponding to a Maven project described by a pom.xml file. It specifies dependencies, plugins, packaging, modules, and metadata required to produce artifacts."@en ;
         rdfs:label "Project"@en .


###  http://www.semanticweb.org/AMISecOnto/Reference
:Reference rdf:type owl:Class ;
           rdfs:comment "Represents an external information source related to a vulnerability, such as a vendor advisory, source-code commit, patch, exploit discussion, issue tracker entry, or mailing list post. A reference may include a URL, source identifier, and semantic tags describing its role."@en ;
           rdfs:label "Reference"@en .


###  http://www.semanticweb.org/AMISecOnto/SecurityLogEvent
:SecurityLogEvent rdf:type owl:Class ;
                  rdfs:subClassOf :LogEvent ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasNextLogEvent ;
                                    owl:someValuesFrom :LogEvent
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasPreviousLogEvent ;
                                    owl:someValuesFrom :LogEvent
                                  ] ;
                  rdfs:comment "Represents a log event related to security-relevant activity such as authentication, authorization, auditing, policy enforcement, or suspicious behavior detection."@en ;
                  rdfs:label "Security Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto/Severity
:Severity rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBaseScore ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBaseSeverity ;
                            owl:someValuesFrom xsd:string
                          ] ;
          rdfs:comment "The level of impact or criticality associated with a vulnerability or issue."@en ;
          rdfs:label "Severity"@en .


###  http://www.semanticweb.org/AMISecOnto/SeverityLevel
:SeverityLevel rdf:type owl:Class ;
               rdfs:comment "Represents the qualitative severity classification assigned to a vulnerability or security event, such as LOW, MEDIUM, HIGH, or CRITICAL, typically derived from a scoring framework such as CVSS."@en ;
               rdfs:label "Security Level"@en .


###  http://www.semanticweb.org/AMISecOnto/SoftwareBillsOfMaterial
:SoftwareBillsOfMaterial rdf:type owl:Class ;
                         rdfs:comment "A structured inventory of components, libraries, and dependencies that make up a software system."@en ;
                         rdfs:label "Software Bills of Material"@en .


###  http://www.semanticweb.org/AMISecOnto/SoftwareComponent
:SoftwareComponent rdf:type owl:Class ;
                   rdfs:comment "A modular and reusable unit of software that forms part of a larger system."@en ;
                   rdfs:label "Software Component"@en .


###  http://www.semanticweb.org/AMISecOnto/SoftwareSystem
:SoftwareSystem rdf:type owl:Class ;
                rdfs:comment "A software application, service, or platform that is implemented and delivered through one or more build projects. In the Maven context, it is the final system represented by generated artifacts and composed of internal modules and external dependency libraries."@en ;
                rdfs:label "Software System"@en .


###  http://www.semanticweb.org/AMISecOnto/System
:System rdf:type owl:Class ;
        rdfs:comment "The underlying computing environment or platform on which applications are executed."@en ;
        rdfs:label "System"@en .


###  http://www.semanticweb.org/AMISecOnto/SystemLogEvent
:SystemLogEvent rdf:type owl:Class ;
                rdfs:subClassOf :LogEvent ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasNextLogEvent ;
                                  owl:someValuesFrom :LogEvent
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasPreviousLogEvent ;
                                  owl:someValuesFrom :LogEvent
                                ] ;
                rdfs:comment "Represents an event generated by the operating system or its core services, including package management, service execution, kernel activity, and host-level operational changes."@en ;
                rdfs:label "System Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto/SystemPackage
:SystemPackage rdf:type owl:Class ;
               rdfs:subClassOf :Package ,
                               :SoftwareComponent ;
               rdfs:comment "Represents a software package that belongs to and is distributed with the system itself, forming part of its core functionality as opposed to external or third-party dependencies."@en ;
               rdfs:label "System Package"@en .


###  http://www.semanticweb.org/AMISecOnto/User
:User rdf:type owl:Class ;
      rdfs:comment "Represents a human or system entity that performs actions within a system and is linked to log events, indicating involvement in recorded activities."@en ;
      rdfs:label "User"@en .


###  http://www.semanticweb.org/AMISecOnto/Vendor
:Vendor rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Class ;
                          owl:unionOf ( :CPE
                                        :Vendor
                                      )
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasProduct ;
                          owl:someValuesFrom :Product
                        ] ;
        rdfs:comment "Represents the organization, project, or distributor responsible for producing, maintaining, or distributing a product affected by a vulnerability."@en ;
        rdfs:label "Vendor"@en .


###  http://www.semanticweb.org/AMISecOnto/Version
:Version rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :hasVersionName ;
                           owl:someValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasVersionValue ;
                           owl:someValuesFrom xsd:string
                         ] ;
         rdfs:comment "Represents a specific product release or a bounded version range used to describe affected or unaffected product configurations in vulnerability records."@en ;
         rdfs:label "Version"@en .


###  http://www.semanticweb.org/AMISecOnto/VersionInterval
:VersionInterval rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasVersionMaxIncluding ;
                                   owl:someValuesFrom :Version
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasVersionMinIncluding ;
                                   owl:someValuesFrom :Version
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasIntervalLabel ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTargetHardware ;
                                   owl:someValuesFrom xsd:string
                                 ] ;
                 rdfs:comment "A range of software versions defined by minimum and/or maximum boundaries, often used to describe affected versions."@en ;
                 rdfs:label "Version Interval"@en .


###  http://www.semanticweb.org/AMISecOnto/Vulnerability
:Vulnerability rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :affectsCPE ;
                                 owl:someValuesFrom :CPE
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasDescription ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasPubDate ;
                                 owl:someValuesFrom xsd:dateTime
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasReferenceURL ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasCVEId ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ;
               rdfs:comment "Represents a disclosed security flaw affecting one or more software or hardware products. A vulnerability may include a textual description, publication date, severity metrics, affected platform definitions, and external references to advisories, patches, exploits, or vendor information."@en ;
               rdfs:label "Vulnerability"@en .


###  http://www.semanticweb.org/AMISecOnto/Weakness
:Weakness rdf:type owl:Class ;
          rdfs:comment "Represents the underlying software or design weakness that gives rise to a vulnerability, typically aligned with a controlled taxonomy such as CWE."@en ;
          rdfs:label "Weakness"@en .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/AMISecOnto/Critical
:Critical rdf:type owl:NamedIndividual ,
                   :SeverityLevel .


###  http://www.semanticweb.org/AMISecOnto/High
:High rdf:type owl:NamedIndividual ,
               :SeverityLevel .


###  http://www.semanticweb.org/AMISecOnto/Low
:Low rdf:type owl:NamedIndividual ,
              :SeverityLevel .


###  http://www.semanticweb.org/AMISecOnto/Medium
:Medium rdf:type owl:NamedIndividual ,
                 :SeverityLevel .


#################################################################
#    Rules
#################################################################

:e rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:name rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:a rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:p rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:v rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:s rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:a1 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:a2 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:c rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:l rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:e1 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:e2 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:u rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Artifact direct dependency propagates vulnerability" ;
   rdfs:label "VA3" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Artifact ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :a1
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :Artifact ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :a2
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :Vulnerability ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :v
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasDirectDependency ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :a1 ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :a2
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasVulnerability ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :a2 ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument2> :v
                                                                                                 ] ;
                                                                                       rdf:rest rdf:nil
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasVulnerability ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :a1 ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :v
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "CPE alignment for product-level vulnerability reasoning" ;
   rdfs:label "VA7" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Vulnerability ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :v
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :CPE ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :c
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :Product ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :p
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :affectsCPE ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :v ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :c
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasProduct ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument2> :p
                                                                                                 ] ;
                                                                                       rdf:rest rdf:nil
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> amiseconto:relatedToProduct ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :v ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :p
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Package dependency exposure implies event-vulnerability relation" ;
   rdfs:label "VA1" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :LogEvent ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :e
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :Package ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :p
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :Library ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :l
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#classPredicate> :Vulnerability ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :v
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasPackage ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :e ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument2> :p
                                                                                                 ] ;
                                                                                       rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                  rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#propertyPredicate> :dependsOn ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument1> :p ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument2> :l
                                                                                                            ] ;
                                                                                                  rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                             rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#propertyPredicate> :exposes ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#argument1> :l ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#argument2> :v
                                                                                                                       ] ;
                                                                                                             rdf:rest rdf:nil
                                                                                                           ]
                                                                                                ]
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> amiseconto:relatedToVulnerability ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :e ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :v
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Observed vulnerability from related event" ;
   rdfs:label "VA2" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :LogEvent ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :e
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :Vulnerability ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :v
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> amiseconto:relatedToVulnerability ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :e ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :v
                                                                           ] ;
                                                                 rdf:rest rdf:nil
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :isObservedIn ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :v ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :e
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "vulnerability observed in event implies threat evidence" ;
   rdfs:label "TA1" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Vulnerability ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :v
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :LogEvent ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :e
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :isObservedIn ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :v ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :e
                                                                           ] ;
                                                                 rdf:rest rdf:nil
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> amiseconto:SuspiciousEvent ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :e
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Same package, adjacent events are correlated" ;
   rdfs:label "LT4" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :LogEvent ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :e1
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :LogEvent ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :e2
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :Package ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :p
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasNextLogEvent ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :e1 ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :e2
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasPackage ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :e1 ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument2> :p
                                                                                                 ] ;
                                                                                       rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                  rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasPackage ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument1> :e2 ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument2> :p
                                                                                                            ] ;
                                                                                                  rdf:rest rdf:nil
                                                                                                ]
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> amiseconto:correlatedWith ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :e1 ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :e2
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Same system, consecutive events are correlated" ;
   rdfs:label "LT5" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :LogEvent ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :e1
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :LogEvent ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :e2
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#classPredicate> :System ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :s
