@prefix : <http://www.semanticweb.org/AMISecOnto/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix amiseconto: <http://www.semanticweb.org/AMISecOnto#> .
@base <http://www.semanticweb.org/AMISecOnto/> .

<http://www.semanticweb.org/AMISecOnto> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/AMISecOnto#affectsSystem
amiseconto:affectsSystem rdf:type owl:ObjectProperty ;
                         rdfs:domain :Vulnerability ;
                         rdfs:comment "Relates a Vulnerability to a Software System that it affects, based on vulnerabilities identified in artifacts that represent the system."@en ;
                         rdfs:label "affects system"@en .


###  http://www.semanticweb.org/AMISecOnto#belongsToModule
amiseconto:belongsToModule rdf:type owl:ObjectProperty ;
                           rdfs:domain :Dependency ;
                           rdfs:range amiseconto:Module ;
                           rdfs:comment "Relates a dependency (e.g., package, library, or component) to the module it is part of."@en ;
                           rdfs:label "belongs to module"@en .


###  http://www.semanticweb.org/AMISecOnto#belongsToRequest
amiseconto:belongsToRequest rdf:type owl:ObjectProperty ;
                            rdfs:domain :ApplicationLogEvent ;
                            rdfs:range amiseconto:Request ;
                            rdfs:label "belongs to request"@en .


###  http://www.semanticweb.org/AMISecOnto#containsEvent
amiseconto:containsEvent rdf:type owl:ObjectProperty ;
                         rdfs:domain amiseconto:Log ;
                         rdfs:range :LogEvent ;
                         rdfs:comment "Indicates that a log includes one or more log events, representing recorded activities or occurrences within a system for monitoring, auditing, and analysis."@en ;
                         rdfs:label "contains event"@en .


###  http://www.semanticweb.org/AMISecOnto#correlatedWith
amiseconto:correlatedWith rdf:type owl:ObjectProperty ;
                          rdfs:domain :LogEvent ;
                          rdfs:range :LogEvent ;
                          rdfs:comment "Relates a Log Event to another Log Event that is contextually, temporally, or causally associated with it."@en ;
                          rdfs:label "correlated with" .


###  http://www.semanticweb.org/AMISecOnto#declaresDependency
amiseconto:declaresDependency rdf:type owl:ObjectProperty ;
                              rdfs:domain :Application ;
                              rdfs:range :Dependency ;
                              rdfs:comment "Relates an application to a dependency that it explicitly declares as required for its execution, build, or functionality."@en ;
                              rdfs:label "declares dependency"@en .


###  http://www.semanticweb.org/AMISecOnto#evidenceByLogEvent
amiseconto:evidenceByLogEvent rdf:type owl:ObjectProperty ;
                              rdfs:domain :LogEvent ;
                              rdfs:range :Vulnerability ;
                              rdfs:comment "This property links a LogEvent to a Vulnerability when the log event provides evidence that the vulnerability exists, was exploited, or is related to suspicious behavior."@en ;
                              rdfs:label "has evidence by log event"@en .


###  http://www.semanticweb.org/AMISecOnto#executedInEnvironment
amiseconto:executedInEnvironment rdf:type owl:ObjectProperty ;
                                 rdfs:domain :ApplicationLogEvent ;
                                 rdfs:range amiseconto:Environment ;
                                 rdfs:label "executed in environment"@en .


###  http://www.semanticweb.org/AMISecOnto#generates
amiseconto:generates rdf:type owl:ObjectProperty ;
                     rdfs:domain amiseconto:Logger ;
                     rdfs:range :LogEvent ;
                     rdfs:comment "Relates a Logger to the LogEvent instances it produces during system execution. This property captures the generation of log records as a result of logging activities"@en ;
                     rdfs:label "generates"@en .


###  http://www.semanticweb.org/AMISecOnto#hasClass
amiseconto:hasClass rdf:type owl:ObjectProperty ;
                    rdfs:domain amiseconto:PackageLibrary ;
                    rdfs:range amiseconto:ClassSource ;
                    rdfs:comment "Relates a package or software entity to its classification category within the ontology."@en ;
                    rdfs:label "has class"@en .


###  http://www.semanticweb.org/AMISecOnto#hasLogger
amiseconto:hasLogger rdf:type owl:ObjectProperty ;
                     rdfs:domain amiseconto:ClassSource ;
                     rdfs:range amiseconto:Logger ;
                     rdfs:comment "Relates a software/system entity to the logger it uses to generate or manage log records"@en ;
                     rdfs:label "has logger"@en .


###  http://www.semanticweb.org/AMISecOnto#hasOperatingSystem
amiseconto:hasOperatingSystem rdf:type owl:ObjectProperty ;
                              rdfs:domain :System ;
                              rdfs:range amiseconto:OperatingSystem ;
                              rdfs:comment "Relates a system to the operating system it runs on or is configured with."@en ;
                              rdfs:label "has operating system"@en .


###  http://www.semanticweb.org/AMISecOnto#hasSource
amiseconto:hasSource rdf:type owl:ObjectProperty ;
                     rdfs:domain :LogEvent ;
                     rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( amiseconto:ClassSource
                                                amiseconto:Process
                                                :Dependency
                                              )
                                ] ;
                     rdfs:label "has source"@en .


###  http://www.semanticweb.org/AMISecOnto#installedOn
amiseconto:installedOn rdf:type owl:ObjectProperty ;
                       rdfs:domain :SystemPackage ;
                       rdfs:range :System ;
                       rdfs:comment "Indicates that a software component, package, or application is installed on a specific system or host, supporting analysis of deployment context and vulnerability exposure."@en ;
                       rdfs:label "installed on"@en .


###  http://www.semanticweb.org/AMISecOnto#mapsTo
amiseconto:mapsTo rdf:type owl:ObjectProperty ;
                  rdfs:domain :Dependency ;
                  rdfs:range :Product ;
                  rdfs:comment "Relates a dependency entity to the product it corresponds to or is resolved as, indicating that the dependency maps to a specific product representation."@en ;
                  rdfs:label "maps to"@en .


###  http://www.semanticweb.org/AMISecOnto#performedByUSer
amiseconto:performedByUSer rdf:type owl:ObjectProperty ;
                           rdfs:domain amiseconto:Request ;
                           rdfs:range :User ;
                           rdfs:comment "Identifies the user responsible for initiating a request, enabling attribution of actions for auditing, monitoring, and security analysis."@en ;
                           rdfs:label "performed by user"@en .


###  http://www.semanticweb.org/AMISecOnto#relatedToProduct
amiseconto:relatedToProduct rdf:type owl:ObjectProperty ;
                            rdfs:domain :Vulnerability ;
                            rdfs:range :Product ;
                            rdfs:comment "Associates a Vulnerability with a Product that it impacts, derived from CPE information that specifies the affected platforms, software, or configurations."@en ;
                            rdfs:label "related to product"@en .


###  http://www.semanticweb.org/AMISecOnto#relatedToVulnerability
amiseconto:relatedToVulnerability rdf:type owl:ObjectProperty ;
                                  rdfs:domain owl:Thing ;
                                  rdfs:range :Vulnerability ;
                                  rdfs:comment "Relates an entity such as a Log Event, Package, Artifact, or Software System to a Vulnerability that it is associated with, affected by, or provides evidence for."@en ;
                                  rdfs:label "related to vulnerability"@en .


###  http://www.semanticweb.org/AMISecOnto/affectsCPE
:affectsCPE rdf:type owl:ObjectProperty ;
            rdfs:domain :Vulnerability ;
            rdfs:range :CPE ;
            rdfs:comment "Links a vulnerability to a Common Platform Enumeration (CPE) entry that identifies an affected platform, including vendor, product, and applicable version scope." ;
            rdfs:label "affects CPE"@en .


###  http://www.semanticweb.org/AMISecOnto/belongsToPackage
:belongsToPackage rdf:type owl:ObjectProperty ;
                  rdfs:domain :Artifact ;
                  rdfs:range :SystemPackage ;
                  rdfs:comment "Associates an Artifact with a Package that groups or contains it, representing its packaging or distribution context."@en ;
                  rdfs:label "belongs to package"@en .


###  http://www.semanticweb.org/AMISecOnto/builds
:builds rdf:type owl:ObjectProperty ;
        rdfs:domain :BuildProcess ;
        rdfs:range :Project ;
        rdfs:comment "Relates a build process to the project that is being processed and transformed into one or more artifacts."@en ;
        rdfs:label "builds"@en .


###  http://www.semanticweb.org/AMISecOnto/consistsOf
:consistsOf rdf:type owl:ObjectProperty ;
            rdfs:domain :BuildProcess ;
            rdfs:range :BuildStep ;
            rdfs:comment "Relates a build process to the build steps that compose it. These steps represent the ordered or logical activities carried out during the lifecycle."@en ;
            rdfs:label "consists of"@en .


###  http://www.semanticweb.org/AMISecOnto/containsPackage
:containsPackage rdf:type owl:ObjectProperty ;
                 rdfs:domain amiseconto:Module ;
                 rdfs:range amiseconto:PackageLibrary ;
                 rdfs:comment "Relates a Software Bill of Material to a Package that it includes as part of its listed components."@en ;
                 rdfs:label "contains package"@en .


###  http://www.semanticweb.org/AMISecOnto/dependsOn
:dependsOn rdf:type owl:ObjectProperty ;
           rdfs:domain :SoftwareComponent ;
           rdfs:range :SoftwareComponent ;
           rdfs:comment "Associates a Package with a Library on which it relies, representing a dependency relationship necessary for its operation or implementation."@en ;
           rdfs:label "depends on"@en .


###  http://www.semanticweb.org/AMISecOnto/describes
:describes rdf:type owl:ObjectProperty ;
           rdfs:domain :SoftwareBillsOfMaterial ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Application
                                      :SoftwareComponent
                                    )
                      ] ;
           rdfs:comment "Relates a Software Bill of Material to a Software System that it describes by enumerating its constituent software elements."@en ;
           rdfs:label "describes"@en .


###  http://www.semanticweb.org/AMISecOnto/executes
:executes rdf:type owl:ObjectProperty ;
          rdfs:domain :DependencyManagementTool ;
          rdfs:range :BuildProcess ;
          rdfs:comment "Relates a build tool to the build process it performs. For example, Maven executes a build process based on the project’s pom.xml and associated settings."@en ;
          rdfs:label "executes"@en .


###  http://www.semanticweb.org/AMISecOnto/exposes
:exposes rdf:type owl:ObjectProperty ;
         rdfs:domain :SoftwareComponent ;
         rdfs:range :Vulnerability ;
         rdfs:comment "Associates a Software Component with a Vulnerability that is present in, affects, or can be exploited through the component."@en ;
         rdfs:label "exposes"@en .


###  http://www.semanticweb.org/AMISecOnto/hasCVSSMetric
:hasCVSSMetric rdf:type owl:ObjectProperty ;
               rdfs:domain :Vulnerability ;
               rdfs:range :CVSSMetric ;
               rdfs:comment "Relates a vulnerability instance to its corresponding CVSS metric."@en ;
               rdfs:label "has CVSS metric"@en .


###  http://www.semanticweb.org/AMISecOnto/hasConfiguration
:hasConfiguration rdf:type owl:ObjectProperty ;
                  rdfs:domain :Project ;
                  rdfs:range :BuildConfiguration ;
                  rdfs:comment "Associates a Project with a Build Configuration that defines how the project is structured, built, or managed through configuration settings and parameters."@en ,
                               "Relates a project to the build configuration that specifies how it should be built, including dependencies, plugins, repositories, profiles, and packaging instructions."@en ;
                  rdfs:label "has configuration"@en .


###  http://www.semanticweb.org/AMISecOnto/hasDirectDependency
:hasDirectDependency rdf:type owl:ObjectProperty ;
                     rdfs:domain :Artifact ;
                     rdfs:range :Artifact ;
                     rdfs:comment "Relates an Artifact to another Artifact on which it directly depends, representing an immediate dependency without intermediate components."@en ;
                     rdfs:label "has direct dependency"@en .


###  http://www.semanticweb.org/AMISecOnto/hasIndicator
:hasIndicator rdf:type owl:ObjectProperty ;
              rdfs:domain :LogEvent ;
              rdfs:range :Indicator ;
              rdfs:comment "Associates a Security Log Event with an Indicator, such as a pattern, signature, or observable attribute, that helps identify, describe, or detect the event."@en ;
              rdfs:label "has indicator"@en .


###  http://www.semanticweb.org/AMISecOnto/hasNextLogEvent
:hasNextLogEvent rdf:type owl:ObjectProperty ;
                 rdfs:domain :LogEvent ;
                 rdfs:range :LogEvent ;
                 rdfs:comment "Relates a Log Event to the Log Event that occurs immediately after it in a sequence."@en ;
                 rdfs:label "has next log event"@en .


###  http://www.semanticweb.org/AMISecOnto/hasPackage
:hasPackage rdf:type owl:ObjectProperty ;
            rdfs:domain :LogEvent ;
            rdfs:range :SoftwareComponent ;
            rdfs:comment "Relates a Security Log Event to a Package that is involved in, referenced by, or affected by the event."@en ;
            rdfs:label "has package"@en .


###  http://www.semanticweb.org/AMISecOnto/hasPreviousLogEvent
:hasPreviousLogEvent rdf:type owl:ObjectProperty ;
                     rdfs:domain :LogEvent ;
                     rdfs:range :LogEvent ;
                     rdfs:comment "Relates a Log Event to the Log Event that occurred immediately before it in a sequence."@en ;
                     rdfs:label "has previous log event"@en .


###  http://www.semanticweb.org/AMISecOnto/hasProduct
:hasProduct rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :CPE
                                        :Vendor
                                      )
                        ] ;
            rdfs:range :Product ;
            rdfs:comment "Associates a Vendor with a Product that it creates, maintains, or makes available as part of its offerings."@en ,
                         "Links a CPE entry or affected platform description to the product that is impacted by a vulnerability."@en ;
            rdfs:label "has product"@en .


###  http://www.semanticweb.org/AMISecOnto/hasReference
:hasReference rdf:type owl:ObjectProperty ;
              rdfs:domain :Vulnerability ;
              rdfs:range :Reference ;
              rdfs:comment "Relates a Vulnerability to an external Reference that provides additional information, such as advisories, reports, or documentation."@en ;
              rdfs:label "has reference"@en .


###  http://www.semanticweb.org/AMISecOnto/hasRootArtifact
:hasRootArtifact rdf:type owl:ObjectProperty ;
                 rdfs:domain :Project ;
                 rdfs:range :Artifact ;
                 rdfs:comment "Relates an Application to its primary Artifact that serves as the main or entry-point component of the application."@en ;
                 rdfs:label "has root artifact"@en .


###  http://www.semanticweb.org/AMISecOnto/hasTransitiveDependency
:hasTransitiveDependency rdf:type owl:ObjectProperty ;
                         rdfs:domain :Artifact ;
                         rdfs:range :Artifact ;
                         rdfs:comment "Relates an Artifact to another Artifact on which it depends indirectly through one or more intermediate dependencies."@en ;
                         rdfs:label "has transitive dependency"@en .


###  http://www.semanticweb.org/AMISecOnto/hasUser
:hasUser rdf:type owl:ObjectProperty ;
         rdfs:domain :LogEvent ;
         rdfs:range :User ;
         rdfs:comment "Relates a LogEvent to a User associated with or involved in that event."@en ;
         rdfs:label "has user"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVendor
:hasVendor rdf:type owl:ObjectProperty ;
           rdfs:domain :CPE ;
           rdfs:range :Vendor ;
           rdfs:comment "Links a product or CPE entry to the vendor, organization, or project responsible for developing, maintaining, or distributing it."@en ;
           rdfs:label "has vendor"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionInterval
:hasVersionInterval rdf:type owl:ObjectProperty ;
                    rdfs:domain :CPE ;
                    rdfs:range :VersionInterval ;
                    rdfs:comment "Links a CPE or affected platform entry to a version interval describing the bounded range of versions affected by a vulnerability."@en ;
                    rdfs:label "has version interval"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionMaxIncluding
:hasVersionMaxIncluding rdf:type owl:ObjectProperty ;
                        rdfs:domain :VersionInterval ;
                        rdfs:range :Version ;
                        rdfs:comment "Relates a VersionInterval to the Version that represents the upper bound of the interval. The referenced version is included in the affected version range."@en ;
                        rdfs:label "has version max including"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionMinIncluding
:hasVersionMinIncluding rdf:type owl:ObjectProperty ;
                        rdfs:domain :VersionInterval ;
                        rdfs:range :Version ;
                        rdfs:comment "Relates a VersionInterval to the Version that represents the lower bound of the interval. The referenced version is included in the affected version range."@en ;
                        rdfs:label "has version min including"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVulnerability
:hasVulnerability rdf:type owl:ObjectProperty ;
                  rdfs:domain :Artifact ;
                  rdfs:range :Vulnerability ;
                  rdfs:comment "Associates an Artifact with a Vulnerability that is identified in or impacts the artifact, representing known security issues affecting it."@en ;
                  rdfs:label "has vulnerability"@en .


###  http://www.semanticweb.org/AMISecOnto/hasWeakness
:hasWeakness rdf:type owl:ObjectProperty ;
             rdfs:domain :Vulnerability ;
             rdfs:range :Weakness ;
             rdfs:comment "Links a vulnerability to the underlying software or design weakness that caused it, typically represented using a taxonomy such as CWE."@en ;
             rdfs:label "has weakness"@en .


###  http://www.semanticweb.org/AMISecOnto/isDescribedBySBOM
:isDescribedBySBOM rdf:type owl:ObjectProperty ;
                   rdfs:domain :SoftwareComponent ;
                   rdfs:range :SoftwareBillsOfMaterial ;
                   rdfs:comment "Relates a software system to the project that defines, organizes, or documents how that system is built and structured. In Maven, a software system is typically described by one or more project definitions."@en ;
                   rdfs:label "is described by SBOM"@en .


###  http://www.semanticweb.org/AMISecOnto/isGeneratedFrom
:isGeneratedFrom rdf:type owl:ObjectProperty ;
                 rdfs:domain :Artifact ;
                 rdfs:range :BuildProcess ;
                 rdfs:comment "Associates an Artifact with the Build Process that produced it, indicating the origin of the artifact within the build workflow."@en ;
                 rdfs:label "is generated from"@en .


###  http://www.semanticweb.org/AMISecOnto/isObservedIn
:isObservedIn rdf:type owl:ObjectProperty ,
                       owl:SymmetricProperty ;
              rdfs:domain :Application ;
              rdfs:range :LogEvent ;
              rdfs:comment "Associates a Vulnerability with a Log Event that provides evidence of its presence, exploitation, or detection within a system."@en ;
              rdfs:label "is observed in"@en .


###  http://www.semanticweb.org/AMISecOnto/isSpecifiedBy
:isSpecifiedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :Application ;
               rdfs:range :Project ;
               rdfs:comment "Relates a Software System with a Project that provides its specification, implementation, or structural definition."@en ;
               rdfs:label "is specified by"@en .


###  http://www.semanticweb.org/AMISecOnto/managedBy
:managedBy rdf:type owl:ObjectProperty ;
           rdfs:domain :Application ;
           rdfs:range :DependencyManagementTool ;
           rdfs:comment "Relates an application or software component to the dependency management tool that controls its dependencies, versions, and build configuration, influencing its exposure to vulnerable libraries."@en ;
           rdfs:label "managed by"@en .


###  http://www.semanticweb.org/AMISecOnto/produces
:produces rdf:type owl:ObjectProperty ;
          rdfs:domain :BuildProcess ;
          rdfs:range :Artifact ;
          rdfs:comment "Relates a build process to the artifacts generated as outputs, such as compiled libraries, packaged applications, or metadata files."@en ;
          rdfs:label "produces"@en .


###  http://www.semanticweb.org/AMISecOnto/registersLogEvent
:registersLogEvent rdf:type owl:ObjectProperty ;
                   rdfs:domain :System ;
                   rdfs:range :LogEvent ;
                   rdfs:comment "Associates a System with a Log Event that it produces, capturing events recorded during execution, monitoring, or auditing activities."@en ;
                   rdfs:label "registers log event"@en .


###  http://www.semanticweb.org/AMISecOnto/represents
:represents rdf:type owl:ObjectProperty ;
            rdfs:domain :Artifact ;
            rdfs:range :Application ;
            rdfs:comment "Relates an Artifact to a Software System that it represents as a concrete implementation or instance."@en ,
                         "Relates an artifact to the software system it implements, packages, or delivers. For example, a generated JAR artifact may represent a module or the whole software system."@en ;
            rdfs:label "represents"@en .


###  http://www.semanticweb.org/AMISecOnto/runsOn
:runsOn rdf:type owl:ObjectProperty ;
        rdfs:domain :Application ;
        rdfs:range :System ;
        rdfs:comment "Relates an application to the system on which it runs."@en ;
        rdfs:label "runs on"@en .


###  http://www.semanticweb.org/AMISecOnto/uses
:uses rdf:type owl:ObjectProperty ;
      rdfs:domain :BuildStep ;
      rdfs:range :Dependency ;
      rdfs:comment "Associates a Build Step with a Dependency required or consumed during the execution of that step, representing the dependency utilized in the build workflow."@en ;
      rdfs:label "uses"@en .


###  http://www.semanticweb.org/AMISecOnto/usesConfiguration
:usesConfiguration rdf:type owl:ObjectProperty ;
                   rdfs:domain :BuildProcess ;
                   rdfs:range :BuildConfiguration ;
                   rdfs:comment "Relates a Build Process to a Build Configuration that defines the parameters, settings, and environment used during its execution."@en ;
                   rdfs:label "uses configuration"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/AMISecOnto#hasAliveStatus
amiseconto:hasAliveStatus rdf:type owl:DatatypeProperty ;
                          rdfs:comment "interpreted liveness state of a cluster member referenced in a Catalina log event, indicating whether the member is alive, suspected, or has disappeared during cluster membership monitoring."@en ;
                          rdfs:label "has alive status"@en .


###  http://www.semanticweb.org/AMISecOnto#hasAuthenticationMethod
amiseconto:hasAuthenticationMethod rdf:type owl:DatatypeProperty ;
                                   rdfs:domain amiseconto:SuLogEvent ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "The mechanism or module used to authenticate the su operation, such as \"su\", \"pam_unix\", or other PAM modules. Useful for cross-log correlation or detailed forensic analysis."@en ;
                                   rdfs:label "has authentication method"@en .


###  http://www.semanticweb.org/AMISecOnto#hasCategory
amiseconto:hasCategory rdf:type owl:DatatypeProperty ;
                       rdfs:domain :LogEvent ;
                       rdfs:range xsd:string ;
                       rdfs:label "has category"@en .


###  http://www.semanticweb.org/AMISecOnto#hasCommand
amiseconto:hasCommand rdf:type owl:DatatypeProperty ;
                      rdfs:domain amiseconto:SudoLogEvent ;
                      rdfs:range xsd:string ;
                      rdfs:comment "The full command invoked using sudo, including arguments if present."@en ;
                      rdfs:label "has command"@en .


###  http://www.semanticweb.org/AMISecOnto#hasCreationDate
amiseconto:hasCreationDate rdf:type owl:DatatypeProperty ;
                           rdfs:domain amiseconto:Log ;
                           rdfs:range xsd:string ;
                           rdfs:comment "When log file was created."@en ;
                           rdfs:label "has creation date"@en .


###  http://www.semanticweb.org/AMISecOnto#hasEncoding
amiseconto:hasEncoding rdf:type owl:DatatypeProperty ;
                       rdfs:domain amiseconto:Log ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Character encoding format used in the log file."@en ;
                       rdfs:label "has encoding"@en .


###  http://www.semanticweb.org/AMISecOnto#hasEventType
amiseconto:hasEventType rdf:type owl:DatatypeProperty ;
                        rdfs:domain :LogEvent ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Normalized or inferred category describing the nature of the Catalina log event, such as lifecycle, cluster, or exception-related activity."@en ;
                        rdfs:label "has event type"@en .


###  http://www.semanticweb.org/AMISecOnto#hasExceptionMessage
amiseconto:hasExceptionMessage rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:string ;
                               rdfs:label "has exception message"@en .


###  http://www.semanticweb.org/AMISecOnto#hasExceptionType
amiseconto:hasExceptionType rdf:type owl:DatatypeProperty ;
                            rdfs:domain :ApplicationLogEvent ;
                            rdfs:range xsd:string ;
                            rdfs:label "has exception type"@en .


###  http://www.semanticweb.org/AMISecOnto#hasExecutable
amiseconto:hasExecutable rdf:type owl:DatatypeProperty ;
                         rdfs:domain amiseconto:Audit_Log_Event ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Path or name of the executable file responsible for generating the audited event."@en ;
                         rdfs:label "has executable"@en .


###  http://www.semanticweb.org/AMISecOnto#hasFaiulureReason
amiseconto:hasFaiulureReason rdf:type owl:DatatypeProperty ;
                             rdfs:domain amiseconto:SuLogEvent ;
                             rdfs:range xsd:string ;
                             rdfs:comment "The result state of the su operation, such as \"success\", \"failure\", \"session opened\", or \"session closed\". Essential for interpreting whether the identity switch was attempted, granted, or terminated."@en ;
                             rdfs:label "has failure reason"@en .


###  http://www.semanticweb.org/AMISecOnto#hasFileName
amiseconto:hasFileName rdf:type owl:DatatypeProperty ;
                       rdfs:domain amiseconto:Log ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Specifies the name of the log file."@en ;
                       rdfs:label "has file name"@en .


###  http://www.semanticweb.org/AMISecOnto#hasFilePath
