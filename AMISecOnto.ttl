amiseconto:has_user_agent rdf:type owl:DatatypeProperty ;
                          rdfs:label "has user agent"@en .


###  http://www.semanticweb.org/AMISecOnto#haslogger
amiseconto:haslogger rdf:type owl:DatatypeProperty ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Stores the fully qualified logger, class, or source identifier that emitted the event."@en ;
                     rdfs:label "has logger"@en .


###  http://www.semanticweb.org/AMISecOnto/hasAuthenticatedUser
:hasAuthenticatedUser rdf:type owl:DatatypeProperty ;
                      rdfs:domain :ApplicationLogEvent ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Links a request or session to the identity of an authenticated user, if authentication has occurred."@en ;
                      rdfs:label "has authenticated user"@en .


###  http://www.semanticweb.org/AMISecOnto/hasBaseScore
:hasBaseScore rdf:type owl:DatatypeProperty ;
              rdfs:domain :Severity ;
              rdfs:range xsd:string ;
              rdfs:comment "Represents the numerical CVSS base score indicating the intrinsic severity of a vulnerability, typically ranging from 0.0 to 10.0."@en ;
              rdfs:label "has base score"@en .


###  http://www.semanticweb.org/AMISecOnto/hasBaseSeverity
:hasBaseSeverity rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Severity ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Indicates the qualitative severity level of a vulnerability derived from its CVSS Base Score. Typical values include None, Low, Medium, High, and Critical, representing the intrinsic impact of the vulnerability under standard conditions."@en ;
                 rdfs:label "has base severity"@en .


###  http://www.semanticweb.org/AMISecOnto/hasCVEId
:hasCVEId rdf:type owl:DatatypeProperty ;
          rdfs:domain :Vulnerability ;
          rdfs:range xsd:string ;
          rdfs:comment "Identifies the unique Common Vulnerabilities and Exposures (CVE) identifier assigned to a vulnerability record. The identifier follows the standard CVE naming format (e.g., CVE-2025-12345) and is used to uniquely reference a vulnerability in public vulnerability databases."@en ;
          rdfs:label "has CVE identifier"@en .


###  http://www.semanticweb.org/AMISecOnto/hasCVSSVersion
:hasCVSSVersion rdf:type owl:DatatypeProperty ;
                rdfs:domain :Vulnerability ;
                rdfs:range xsd:string ;
                rdfs:comment "Specifies the version of the Common Vulnerability Scoring System (CVSS) used to calculate the vulnerability score (e.g., 2.0, 3.0, 3.1, 4.0)."@en ;
                rdfs:label "has CVSS version"@en .


###  http://www.semanticweb.org/AMISecOnto/hasCVSScode
:hasCVSScode rdf:type owl:DatatypeProperty ;
             rdfs:domain :Vulnerability ;
             rdfs:range xsd:string ;
             rdfs:comment "Stores the CVSS vector string representing the detailed metrics used to calculate the vulnerability score."@en ;
             rdfs:label "has CVSS code"@en .


###  http://www.semanticweb.org/AMISecOnto/hasClientIp
:hasClientIp rdf:type owl:DatatypeProperty ;
             rdfs:domain amiseconto:AccessLogEvent ;
             rdfs:range xsd:string ;
             rdfs:comment "Captures the source IP address from which the request originated, useful for tracking, auditing, and intrusion detection."@en ;
             rdfs:label "has client ip"@en .


###  http://www.semanticweb.org/AMISecOnto/hasDescription
:hasDescription rdf:type owl:DatatypeProperty ;
                rdfs:domain :Vulnerability ;
                rdfs:range xsd:string ;
                rdfs:comment "Provides a textual description of the vulnerability, explaining the nature of the security issue, the affected components, and potential impacts such as unauthorized access, denial of service, or privilege escalation."@en ;
                rdfs:label "has description"@en .


###  http://www.semanticweb.org/AMISecOnto/hasEventTimestamp
:hasEventTimestamp rdf:type owl:DatatypeProperty ;
                   rdfs:domain :LogEvent ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Records the timestamp of the event, enabling temporal analysis, ordering of events, and correlation across logs."@en ;
                   rdfs:label "has event timestamp"@en .


###  http://www.semanticweb.org/AMISecOnto/hasIdentity
:hasIdentity rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:string ;
             rdfs:comment "Associates the event with a specific identity, which may be authenticated or unauthenticated, depending on context."@en ;
             rdfs:label "has identity"@en .


###  http://www.semanticweb.org/AMISecOnto/hasIntervalLabel
:hasIntervalLabel rdf:type owl:DatatypeProperty ;
                  rdfs:domain :VersionInterval ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Indicates the qualitative severity category derived from the CVSS base score (e.g., Low, Medium, High, Critical)."@en ;
                  rdfs:label "has interval label"@en .


###  http://www.semanticweb.org/AMISecOnto/hasPubDate
:hasPubDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Vulnerability ;
            rdfs:range xsd:dateTime ;
            rdfs:comment "Specifies the date on which the vulnerability entry was officially published in a vulnerability database such as the National Vulnerability Database (NVD)."@en ;
            rdfs:label "has publication date"@en .


###  http://www.semanticweb.org/AMISecOnto/hasReferenceURL
:hasReferenceURL rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Links to external resources related to the vulnerability, such as security advisories, vendor bulletins, patches, technical analyses, or vulnerability reports."@en ;
                 rdfs:label "has reference URL"@en .


###  http://www.semanticweb.org/AMISecOnto/hasRequestLine
:hasRequestLine rdf:type owl:DatatypeProperty ;
                rdfs:comment "Contains the complete request line, including HTTP method, requested resource, and protocol version, providing detailed request context."@en ;
                rdfs:label "has request line"@en .


###  http://www.semanticweb.org/AMISecOnto/hasResponseSize
:hasResponseSize rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Specifies the payload size of the server response, useful for performance monitoring and anomaly detection."@en ;
                 rdfs:label "has response size"@en .


###  http://www.semanticweb.org/AMISecOnto/hasSource
:hasSource rdf:type owl:DatatypeProperty ;
           rdfs:domain :Vulnerability ;
           rdfs:range xsd:string ;
           rdfs:comment "Identifies the organization or entity that reported, published, or maintains the vulnerability information, such as NVD, MITRE, or a specific vendor."@en ;
           rdfs:label "has source"@en .


###  http://www.semanticweb.org/AMISecOnto/hasStatusCode
:hasStatusCode rdf:type owl:DatatypeProperty ;
               rdfs:comment "Encodes the outcome of the request using standard HTTP status codes (e.g., 200, 404, 500), supporting error analysis and monitoring."@en ;
               rdfs:label "has status code"@en .


###  http://www.semanticweb.org/AMISecOnto/hasTag
:hasTag rdf:type owl:DatatypeProperty ;
        rdfs:domain :Vulnerability ;
        rdfs:range xsd:string ;
        rdfs:comment "Associates descriptive tags or keywords with the vulnerability to facilitate categorization, filtering, and analysis.  It serves as a shorthand method to provide contextual data regarding the CVE Record."@en ;
        rdfs:label "has tag"@en .


###  http://www.semanticweb.org/AMISecOnto/hasTargetHardware
:hasTargetHardware rdf:type owl:DatatypeProperty ;
                   rdfs:domain :VersionInterval ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Specifies the hardware platform, device type, or architecture affected by the vulnerability."@en ;
                   rdfs:label "has target hardware"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionName
:hasVersionName rdf:type owl:DatatypeProperty ;
                rdfs:comment "Identifies the name of the versioned component (e.g., application or API name) associated with the event."@en ;
                rdfs:label "has version name"@en .


###  http://www.semanticweb.org/AMISecOnto/hasVersionValue
:hasVersionValue rdf:type owl:DatatypeProperty ;
                 rdfs:comment "Specifies the version identifier  corresponding to the associated system or component."@en ;
                 rdfs:label "has version value"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/AMISecOnto#AccessLog
amiseconto:AccessLog rdf:type owl:Class ;
                     rdfs:subClassOf amiseconto:ApplicationLog ;
                     rdfs:label "Access Log"@en .


###  http://www.semanticweb.org/AMISecOnto#AccessLogEvent
amiseconto:AccessLogEvent rdf:type owl:Class ;
                          rdfs:subClassOf :ApplicationLogEvent ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:hasExceptionType ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:hasHttpSatusCode ;
                                            owl:someValuesFrom xsd:integer
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:hasHttpVersion ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:hasRawMessage ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:hasRequestURI ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:hasResponseSizeBytes ;
                                            owl:someValuesFrom xsd:integer
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:has_http_method ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:has_referer ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:has_user_agent ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasClientIp ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasRequestLine ;
                                            owl:someValuesFrom xsd:string
                                          ] ;
                          rdfs:label "Acess Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#ApplicationLog
amiseconto:ApplicationLog rdf:type owl:Class ;
                          rdfs:subClassOf amiseconto:Log ;
                          rdfs:label "Application Log"@en .


###  http://www.semanticweb.org/AMISecOnto#AuditLog
amiseconto:AuditLog rdf:type owl:Class ;
                    rdfs:subClassOf amiseconto:SecurityLog ;
                    rdfs:label "Audit Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Audit_Log_Event
amiseconto:Audit_Log_Event rdf:type owl:Class ;
                           rdfs:subClassOf :SecurityLogEvent ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty amiseconto:hasExecutable ;
                                             owl:someValuesFrom xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty amiseconto:hasFilePath ;
                                             owl:someValuesFrom xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty amiseconto:hasSessionID ;
                                             owl:someValuesFrom xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty amiseconto:hasSuccessStatus ;
                                             owl:someValuesFrom xsd:boolean
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty amiseconto:hasSyscallNumber ;
                                             owl:someValuesFrom xsd:integer
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty amiseconto:hasUserID ;
                                             owl:someValuesFrom xsd:integer
                                           ] ;
                           rdfs:label "Audit Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#AuthenticationLog
amiseconto:AuthenticationLog rdf:type owl:Class ;
                             rdfs:subClassOf amiseconto:SecurityLog ;
                             rdfs:label "Authentication Log"@en .


###  http://www.semanticweb.org/AMISecOnto#AuthenticationLogEvent
amiseconto:AuthenticationLogEvent rdf:type owl:Class ;
                                  rdfs:subClassOf :SecurityLogEvent ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty amiseconto:hasSessionStatus ;
                                                    owl:someValuesFrom xsd:string
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty amiseconto:hasUserName ;
                                                    owl:someValuesFrom xsd:string
                                                  ] ;
                                  rdfs:label "Authentication Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#CatalinaLog
amiseconto:CatalinaLog rdf:type owl:Class ;
                       rdfs:subClassOf amiseconto:ContainerLog ;
                       rdfs:comment "Represents container-level logging information produced by Tomcat's Catalina engine."@en ;
                       rdfs:label "Catalina Log"@en .


###  http://www.semanticweb.org/AMISecOnto#CatalinaLogEvent
amiseconto:CatalinaLogEvent rdf:type owl:Class ;
                            rdfs:subClassOf amiseconto:ContainerLogEvent ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty amiseconto:hasEventType ;
                                              owl:someValuesFrom xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty amiseconto:hasMembershipStatus ;
                                              owl:someValuesFrom xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty amiseconto:hasMessage ;
                                              owl:someValuesFrom xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty amiseconto:hasServeletName ;
                                              owl:someValuesFrom xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty amiseconto:hasSourceClass ;
                                              owl:someValuesFrom xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty amiseconto:hasThreatName ;
                                              owl:someValuesFrom xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty amiseconto:has_class_method ;
                                              owl:someValuesFrom xsd:string
                                            ] ;
                            rdfs:comment "An event generated by the Apache Tomcat Catalina engine, capturing runtime information, warnings, or errors during servlet container execution."@en ;
                            rdfs:label "Calalina Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#ClassSource
amiseconto:ClassSource rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty amiseconto:hasLogger ;
                                         owl:someValuesFrom amiseconto:Logger
                                       ] ;
                       rdfs:comment "An implementation unit within a package that encapsulates attributes and methods and can generate runtime events."@en ;
                       rdfs:label "Class Source"@en .


###  http://www.semanticweb.org/AMISecOnto#ContainerLog
amiseconto:ContainerLog rdf:type owl:Class ;
                        rdfs:subClassOf amiseconto:ApplicationLog ;
                        rdfs:label "Container Log"@en .


###  http://www.semanticweb.org/AMISecOnto#ContainerLogEvent
amiseconto:ContainerLogEvent rdf:type owl:Class ;
                             rdfs:subClassOf :ApplicationLogEvent ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasExceptionMessage ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasExceptionType ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasLineNumber ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasLogFileName ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasLogFilePath ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasLoggerName ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasMemberIP ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasMemberId ;
                                               owl:someValuesFrom xsd:integer
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasMembershipStatus ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasOSLogType ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasOriginClass ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasOriginFile ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasOriginLineNumber ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasOriginMethod ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasRawMessage ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasSecurePort ;
                                               owl:someValuesFrom xsd:integer
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasServlet ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasSeverityCode ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasSourceFile ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasTopStackFrame ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasUdpPort ;
                                               owl:someValuesFrom xsd:integer
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty amiseconto:hasVerificationStatus ;
                                               owl:someValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :hasEventTimestamp ;
                                               owl:someValuesFrom xsd:string
                                             ] ;
                             rdfs:label "Container Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#Environment
amiseconto:Environment rdf:type owl:Class ;
                       rdfs:comment "Represents the context or setting in which a system, application, or component is deployed and operates, including its underlying infrastructure, software stack, and configuration."@en ;
                       rdfs:label "Environment"@en .


###  http://www.semanticweb.org/AMISecOnto#ErrorLogEvent
amiseconto:ErrorLogEvent rdf:type owl:Class ;
                         rdfs:subClassOf :ApplicationLogEvent ;
                         rdfs:label "Error Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#Error_Log
amiseconto:Error_Log rdf:type owl:Class ;
                     rdfs:subClassOf amiseconto:ApplicationLog ;
                     rdfs:label "Error Log"@en .


###  http://www.semanticweb.org/AMISecOnto#FenixErrorLog
amiseconto:FenixErrorLog rdf:type owl:Class ;
                         rdfs:subClassOf amiseconto:Error_Log ;
                         rdfs:comment "Log source containing records of errors and exceptions generated by the Fenix system, used for debugging, monitoring, and incident analysis."@en ;
                         rdfs:label "Fenix Error Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Fenix_Error_Log_Event
amiseconto:Fenix_Error_Log_Event rdf:type owl:Class ;
                                 rdfs:subClassOf amiseconto:ErrorLogEvent ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty amiseconto:hasThreatName ;
                                                   owl:someValuesFrom xsd:string
                                                 ] ;
                                 rdfs:comment "Event representing an error occurrence recorded by the Fenix system, capturing failures, exceptions, or abnormal behaviors during system operation."@en ;
                                 rdfs:label "Fenix Error Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#FirewallLog
amiseconto:FirewallLog rdf:type owl:Class ;
                       rdfs:subClassOf amiseconto:SecurityLog ;
                       rdfs:label "Firewall Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Firewall_Log
amiseconto:Firewall_Log rdf:type owl:Class ;
                        rdfs:subClassOf :SecurityLogEvent ;
                        rdfs:label "Firewall Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Log
amiseconto:Log rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty amiseconto:containsEvent ;
                                 owl:someValuesFrom :LogEvent
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty amiseconto:hasCreationDate ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty amiseconto:hasEncoding ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty amiseconto:hasFileName ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty amiseconto:hasFilePath ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty amiseconto:hasFileSize ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty amiseconto:hasLastModified ;
                                 owl:someValuesFrom xsd:string
                               ] ;
               rdfs:comment "A Log is a structured or unstructured record generated by systems, applications, or devices that captures events, activities, or states over time."@en ;
               rdfs:label "Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Logger
amiseconto:Logger rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty amiseconto:generates ;
                                    owl:someValuesFrom :LogEvent
                                  ] ;
                  rdfs:comment "Represents a logging component responsible for recording events generated by classes during system execution."@en ;
                  rdfs:label "Logger"@en .


###  http://www.semanticweb.org/AMISecOnto#Module
amiseconto:Module rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :containsPackage ;
                                    owl:someValuesFrom amiseconto:PackageLibrary
                                  ] ;
                  rdfs:comment "An abstraction that organizes a collection of packages corresponding to a specific academic domain or functionality."@en ;
                  rdfs:label "Module"@en .


###  http://www.semanticweb.org/AMISecOnto#OperatingSystem
amiseconto:OperatingSystem rdf:type owl:Class ;
                           rdfs:label "Operating System"@en .


###  http://www.semanticweb.org/AMISecOnto#PackageLibrary
amiseconto:PackageLibrary rdf:type owl:Class ;
                          rdfs:subClassOf :SoftwareComponent ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty amiseconto:hasClass ;
                                            owl:someValuesFrom amiseconto:ClassSource
                                          ] ;
                          rdfs:comment "Represents a container within a module that groups related classes based on functionality or purpose."@en ;
                          rdfs:label "Package Library"@en .


###  http://www.semanticweb.org/AMISecOnto#PackageLogEvent
amiseconto:PackageLogEvent rdf:type owl:Class ;
                           rdfs:subClassOf amiseconto:SystemLog ;
                           rdfs:label "Package Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#Package_Log_Event
amiseconto:Package_Log_Event rdf:type owl:Class ;
                             rdfs:subClassOf :SystemLogEvent ;
                             rdfs:label "Package log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#Process
amiseconto:Process rdf:type owl:Class ;
                   rdfs:comment "Represents an executing instance of a program or application within a system, including its runtime state, resources, and behavior."@en ;
                   rdfs:label "Process"@en .


###  http://www.semanticweb.org/AMISecOnto#Request
amiseconto:Request rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty amiseconto:performedByUSer ;
                                     owl:someValuesFrom :User
                                   ] ;
                   rdfs:comment "Describes a request issued by a user, application, or process to access or invoke a resource or service, capturing interactions that are relevant for monitoring, logging, and security analysis."@en ;
                   rdfs:label "Request"@en .


###  http://www.semanticweb.org/AMISecOnto#SecurityLog
amiseconto:SecurityLog rdf:type owl:Class ;
                       rdfs:subClassOf amiseconto:Log ;
                       rdfs:label "Securtiy Log"@en .


###  http://www.semanticweb.org/AMISecOnto#SshLog
amiseconto:SshLog rdf:type owl:Class ;
                  rdfs:subClassOf amiseconto:AuthenticationLog ;
                  rdfs:comment "Log source that stores records of SSH-related activities, including authentication attempts, session details, and remote connections to the system."@en ;
                  rdfs:label "Ssh Log"@en .


###  http://www.semanticweb.org/AMISecOnto#SshLogEvent
amiseconto:SshLogEvent rdf:type owl:Class ;
                       rdfs:subClassOf amiseconto:AuthenticationLogEvent ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty amiseconto:hasPort ;
                                         owl:someValuesFrom xsd:integer
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty amiseconto:hasTargetUser ;
                                         owl:someValuesFrom xsd:string
                                       ] ;
                       rdfs:comment "Event corresponding to an activity recorded in SSH logs, including login attempts, session establishment, authentication outcomes, and remote access interactions."@en ;
                       rdfs:label "Ssh Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#SuLog
amiseconto:SuLog rdf:type owl:Class ;
                 rdfs:subClassOf amiseconto:AuthenticationLog ;
                 rdfs:comment "Log source capturing events related to the use of the su command, documenting user switching activities and authentication outcomes."@en ;
                 rdfs:label "Su Log"@en .


###  http://www.semanticweb.org/AMISecOnto#SuLogEvent
amiseconto:SuLogEvent rdf:type owl:Class ;
                      rdfs:subClassOf amiseconto:AuthenticationLogEvent ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty amiseconto:hasAuthenticationMethod ;
                                        owl:someValuesFrom xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty amiseconto:hasFaiulureReason ;
                                        owl:someValuesFrom xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty amiseconto:hasSuStatus ;
                                        owl:someValuesFrom xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty amiseconto:hasTTY ;
                                        owl:someValuesFrom xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty amiseconto:hasTargetUser ;
                                        owl:someValuesFrom xsd:string
                                      ] ;
                      rdfs:comment "Event describing user identity switching activities recorded via the su command, including successful and failed attempts to assume another user identity."@en ;
                      rdfs:label "Su Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#SudoLog
amiseconto:SudoLog rdf:type owl:Class ;
                   rdfs:subClassOf amiseconto:AuthenticationLog ;
                   rdfs:comment "Log source containing records of commands executed with elevated privileges via sudo, including user identity, executed commands, and timestamps."@en ;
                   rdfs:label "Sudo Log"@en .


###  http://www.semanticweb.org/AMISecOnto#SudoLogEvent
amiseconto:SudoLogEvent rdf:type owl:Class ;
                        rdfs:subClassOf amiseconto:AuthenticationLogEvent ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty amiseconto:hasCommand ;
                                          owl:someValuesFrom xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty amiseconto:hasRunAsUser ;
                                          owl:someValuesFrom xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty amiseconto:hasSudoStatus ;
                                          owl:someValuesFrom xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty amiseconto:hasTTY ;
                                          owl:someValuesFrom xsd:string
                                        ] ;
                        rdfs:comment "Event representing privilege escalation actions executed via the sudo command, including command execution with elevated permissions and associated authentication results."@en ;
                        rdfs:label "Sudo Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto#SuspiciousEvent
amiseconto:SuspiciousEvent rdf:type owl:Class ;
                           rdfs:comment "Represents a Log Event that is considered suspicious due to its association with a known vulnerability, indicator, or anomalous behavior."@en ;
                           rdfs:label "Suspicious Event"@en .


###  http://www.semanticweb.org/AMISecOnto#SystemLog
amiseconto:SystemLog rdf:type owl:Class ;
                     rdfs:subClassOf amiseconto:Log ;
                     rdfs:label "System Log"@en .


###  http://www.semanticweb.org/AMISecOnto#Transanction
amiseconto:Transanction rdf:type owl:Class ;
                        rdfs:label "Transaction"@en .


###  http://www.semanticweb.org/AMISecOnto/Application
:Application rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty amiseconto:declaresDependency ;
                               owl:someValuesFrom :Dependency
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isObservedIn ;
                               owl:someValuesFrom :Project
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isSpecifiedBy ;
                               owl:someValuesFrom :Project
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :managedBy ;
                               owl:someValuesFrom :DependencyManagementTool
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :runsOn ;
                               owl:someValuesFrom :System
                             ] ;
             rdfs:comment "A software component or system that runs on a platform and is managed through dependency and build tools."@en ;
             rdfs:label "Application"@en .


###  http://www.semanticweb.org/AMISecOnto/ApplicationLogEvent
:ApplicationLogEvent rdf:type owl:Class ;
                     rdfs:subClassOf :LogEvent ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty amiseconto:belongsToRequest ;
                                       owl:someValuesFrom amiseconto:Request
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty amiseconto:executedInEnvironment ;
                                       owl:someValuesFrom amiseconto:Environment
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasNextLogEvent ;
                                       owl:someValuesFrom :LogEvent
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasPreviousLogEvent ;
                                       owl:someValuesFrom :LogEvent
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty amiseconto:hasProcessID ;
                                       owl:someValuesFrom xsd:integer
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty amiseconto:hasProcessName ;
                                       owl:someValuesFrom xsd:string
                                     ] ;
                     rdfs:comment "Represents a log event generated by an application during runtime, including access operations, execution errors, and container-related messages."@en ;
                     rdfs:label "Application Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto/Artifact
:Artifact rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :belongsToPackage ;
                            owl:someValuesFrom :SystemPackage
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasDirectDependency ;
                            owl:someValuesFrom :Artifact
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasTransitiveDependency ;
                            owl:someValuesFrom :Artifact
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasVulnerability ;
                            owl:someValuesFrom :Vulnerability
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :isGeneratedFrom ;
                            owl:someValuesFrom :BuildProcess
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :represents ;
                            owl:someValuesFrom :Application
                          ] ;
          rdfs:comment "A generated or consumed build output identified by coordinates or file form, such as a JAR, WAR, POM, or source package. In Maven, artifacts may represent deployable software units or reusable dependency libraries."@en ;
          rdfs:label "Artifact"@en .


###  http://www.semanticweb.org/AMISecOnto/BuildConfiguration
:BuildConfiguration rdf:type owl:Class ;
                    rdfs:comment "A set of build settings and declarations that control how a project is compiled, tested, packaged, and resolved. In Maven, this includes dependency declarations, plugin configurations, repositories, profiles, and packaging options."@en ;
                    rdfs:label "Build Configuration"@en .


###  http://www.semanticweb.org/AMISecOnto/BuildProcess
:BuildProcess rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :builds ;
                                owl:someValuesFrom :Project
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :consistsOf ;
                                owl:someValuesFrom :BuildStep
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :produces ;
                                owl:someValuesFrom :Artifact
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :usesConfiguration ;
                                owl:someValuesFrom :BuildConfiguration
                              ] ;
              rdfs:comment "An execution instance of a build tool over a project and its configuration. It includes the sequence of phases and actions such as dependency resolution, compilation, testing, packaging, and installation."@en ;
              rdfs:label "Build Process"@en .


###  http://www.semanticweb.org/AMISecOnto/BuildStep
:BuildStep rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :uses ;
                             owl:someValuesFrom :Dependency
                           ] ;
           rdfs:comment "A distinct phase, goal, or action within a build process. In Maven, examples include validate, compile, test, package, install, deploy, and plugin goal executions."@en ;
           rdfs:label "Build Step"@en .


###  http://www.semanticweb.org/AMISecOnto/CPE
:CPE rdf:type owl:Class ;
     rdfs:subClassOf [ rdf:type owl:Restriction ;
                       owl:onProperty :hasProduct ;
                       owl:someValuesFrom :Product
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasVendor ;
                       owl:someValuesFrom :Vendor
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasVersionInterval ;
                       owl:someValuesFrom :VersionInterval
                     ] ;
     rdfs:comment "Represents a structured platform identifier describing an affected product in terms of vendor, product name, version constraints, and target hardware. CPE information is used to specify which platforms are affected by a vulnerability."@en ;
     rdfs:label "Common Platform Enumeration"@en .


###  http://www.semanticweb.org/AMISecOnto/CVSSMetric
:CVSSMetric rdf:type owl:Class ;
            rdfs:comment "Represents a Common Vulnerability Scoring System (CVSS) assessment associated with a vulnerability, including the CVSS version, base score, qualitative severity level, and vector string describing exploitability and impact characteristics."@en ;
            rdfs:label "Common Vulnerability Scoring System Metric"@en .


###  http://www.semanticweb.org/AMISecOnto/Dependency
:Dependency rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty amiseconto:belongsToModule ;
                              owl:someValuesFrom amiseconto:Module
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty amiseconto:mapsTo ;
                              owl:someValuesFrom :Product
                            ] ;
            rdfs:comment "Represents an external or internal software component, library, or resource upon which another component, artifact, or build step relies to function, build, or execute correctly."@en ;
            rdfs:label "Dependency"@en .


###  http://www.semanticweb.org/AMISecOnto/DependencyManagementTool
:DependencyManagementTool rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :executes ;
                                            owl:someValuesFrom :BuildProcess
                                          ] ;
                          rdfs:comment "A software tool that manages dependencies, versions, and build configurations for applications, ensuring correct integration of libraries."@en ;
                          rdfs:label "Dependency Management Tool"@en .


###  http://www.semanticweb.org/AMISecOnto/Indicator
:Indicator rdf:type owl:Class ;
           rdfs:comment "Represents an observable piece of information that signals the potential presence of malicious activity or a security-relevant condition."@en ;
           rdfs:label "Indicator"@en .


###  http://www.semanticweb.org/AMISecOnto/LogEvent
:LogEvent rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty amiseconto:correlatedWith ;
                            owl:someValuesFrom :LogEvent
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty amiseconto:evidenceByLogEvent ;
                            owl:someValuesFrom :Vulnerability
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty amiseconto:hasSource ;
                            owl:someValuesFrom [ rdf:type owl:Class ;
                                                 owl:unionOf ( amiseconto:ClassSource
                                                               amiseconto:Process
                                                               :Dependency
                                                             )
                                               ]
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasIndicator ;
                            owl:someValuesFrom :Indicator
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasNextLogEvent ;
                            owl:someValuesFrom :LogEvent
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasPackage ;
                            owl:someValuesFrom :SoftwareComponent
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasPreviousLogEvent ;
                            owl:someValuesFrom :LogEvent
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty amiseconto:hasEventType ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty amiseconto:hasHostname ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty amiseconto:hasLogLevel ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty amiseconto:hasRawMessage ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasEventTimestamp ;
                            owl:someValuesFrom xsd:string
                          ] ;
          rdfs:comment "Represents a recorded event generated by a system, application, container platform, or security mechanism, describing operational activity, errors, access attempts, authentication, auditing, or package-management actions."@en ;
          rdfs:label "LogEvent"@en .


###  http://www.semanticweb.org/AMISecOnto/Product
:Product rdf:type owl:Class ;
         rdfs:comment "Represents a software or hardware product that may be affected by a vulnerability or may generate operational and security logs. Products are typically identified through CPE information and associated with a vendor and one or more versions."@en ;
         rdfs:label "Product"@en .


###  http://www.semanticweb.org/AMISecOnto/Project
:Project rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :hasConfiguration ;
                           owl:someValuesFrom :BuildConfiguration
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasRootArtifact ;
                           owl:someValuesFrom :Artifact
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isSpecifiedBy ;
                           owl:someValuesFrom :Project
                         ] ;
         rdfs:comment "A buildable software project definition, typically corresponding to a Maven project described by a pom.xml file. It specifies dependencies, plugins, packaging, modules, and metadata required to produce artifacts."@en ;
         rdfs:label "Project"@en .


###  http://www.semanticweb.org/AMISecOnto/Reference
:Reference rdf:type owl:Class ;
           rdfs:comment "Represents an external information source related to a vulnerability, such as a vendor advisory, source-code commit, patch, exploit discussion, issue tracker entry, or mailing list post. A reference may include a URL, source identifier, and semantic tags describing its role."@en ;
           rdfs:label "Reference"@en .


###  http://www.semanticweb.org/AMISecOnto/SecurityLogEvent
:SecurityLogEvent rdf:type owl:Class ;
                  rdfs:subClassOf :LogEvent ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasNextLogEvent ;
                                    owl:someValuesFrom :LogEvent
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasPreviousLogEvent ;
                                    owl:someValuesFrom :LogEvent
                                  ] ;
                  rdfs:comment "Represents a log event related to security-relevant activity such as authentication, authorization, auditing, policy enforcement, or suspicious behavior detection."@en ;
                  rdfs:label "Security Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto/Severity
:Severity rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBaseScore ;
                            owl:someValuesFrom xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBaseSeverity ;
                            owl:someValuesFrom xsd:string
                          ] ;
          rdfs:comment "The level of impact or criticality associated with a vulnerability or issue."@en ;
          rdfs:label "Severity"@en .


###  http://www.semanticweb.org/AMISecOnto/SeverityLevel
:SeverityLevel rdf:type owl:Class ;
               rdfs:comment "Represents the qualitative severity classification assigned to a vulnerability or security event, such as LOW, MEDIUM, HIGH, or CRITICAL, typically derived from a scoring framework such as CVSS."@en ;
               rdfs:label "Security Level"@en .


###  http://www.semanticweb.org/AMISecOnto/SoftwareBillsOfMaterial
:SoftwareBillsOfMaterial rdf:type owl:Class ;
                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty :describes ;
                                           owl:someValuesFrom [ rdf:type owl:Class ;
                                                                owl:unionOf ( :Application
                                                                              :SoftwareComponent
                                                                            )
                                                              ]
                                         ] ;
                         rdfs:comment "A structured inventory of components, libraries, and dependencies that make up a software system."@en ;
                         rdfs:label "Software Bills of Material"@en .


###  http://www.semanticweb.org/AMISecOnto/SoftwareComponent
:SoftwareComponent rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :dependsOn ;
                                     owl:someValuesFrom :SoftwareComponent
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :exposes ;
                                     owl:someValuesFrom :Vulnerability
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :isDescribedBySBOM ;
                                     owl:someValuesFrom :SoftwareBillsOfMaterial
                                   ] ;
                   rdfs:comment "A modular and reusable unit of software that forms part of a larger system."@en ;
                   rdfs:label "Software Component"@en .


###  http://www.semanticweb.org/AMISecOnto/System
:System rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty amiseconto:hasOperatingSystem ;
                          owl:someValuesFrom amiseconto:OperatingSystem
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :registersLogEvent ;
                          owl:someValuesFrom :LogEvent
                        ] ;
        rdfs:comment "The underlying computing environment or platform on which applications are executed."@en ;
        rdfs:label "System"@en .


###  http://www.semanticweb.org/AMISecOnto/SystemLogEvent
:SystemLogEvent rdf:type owl:Class ;
                rdfs:subClassOf :LogEvent ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasNextLogEvent ;
                                  owl:someValuesFrom :LogEvent
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasPreviousLogEvent ;
                                  owl:someValuesFrom :LogEvent
                                ] ;
                rdfs:comment "Represents an event generated by the operating system or its core services, including package management, service execution, kernel activity, and host-level operational changes."@en ;
                rdfs:label "System Log Event"@en .


###  http://www.semanticweb.org/AMISecOnto/SystemPackage
:SystemPackage rdf:type owl:Class ;
               rdfs:subClassOf :SoftwareComponent ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty amiseconto:installedOn ;
                                 owl:someValuesFrom :System
                               ] ;
               rdfs:comment "A System Package refers to a software package that is part of the core operating system environment or is installed and managed at the system level by the OS package manager (e.g., dpkg, apt, rpm, yum)."@en ;
               rdfs:label "Package System"@en .


###  http://www.semanticweb.org/AMISecOnto/User
:User rdf:type owl:Class ;
      rdfs:comment "Represents a human or system entity that performs actions within a system and is linked to log events, indicating involvement in recorded activities."@en ;
      rdfs:label "User"@en .


###  http://www.semanticweb.org/AMISecOnto/Vendor
:Vendor rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :hasProduct ;
                          owl:someValuesFrom :Product
                        ] ;
        rdfs:comment "Represents the organization, project, or distributor responsible for producing, maintaining, or distributing a product affected by a vulnerability."@en ;
        rdfs:label "Vendor"@en .


###  http://www.semanticweb.org/AMISecOnto/Version
:Version rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :hasVersionName ;
                           owl:someValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasVersionValue ;
                           owl:someValuesFrom xsd:string
                         ] ;
         rdfs:comment "Represents a specific product release or a bounded version range used to describe affected or unaffected product configurations in vulnerability records."@en ;
         rdfs:label "Version"@en .


###  http://www.semanticweb.org/AMISecOnto/VersionInterval
:VersionInterval rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasVersionMaxIncluding ;
                                   owl:someValuesFrom :Version
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasVersionMinIncluding ;
                                   owl:someValuesFrom :Version
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasIntervalLabel ;
                                   owl:someValuesFrom xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTargetHardware ;
                                   owl:someValuesFrom xsd:string
                                 ] ;
                 rdfs:comment "A range of software versions defined by minimum and/or maximum boundaries, often used to describe affected versions."@en ;
                 rdfs:label "Version Interval"@en .


###  http://www.semanticweb.org/AMISecOnto/Vulnerability
:Vulnerability rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty amiseconto:relatedToProduct ;
                                 owl:someValuesFrom :Product
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :affectsCPE ;
                                 owl:someValuesFrom :CPE
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasCVSSMetric ;
                                 owl:someValuesFrom :CVSSMetric
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasReference ;
                                 owl:someValuesFrom :Reference
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasWeakness ;
                                 owl:someValuesFrom :Weakness
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :isObservedIn ;
                                 owl:someValuesFrom :LogEvent
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasDescription ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasPubDate ;
                                 owl:someValuesFrom xsd:dateTime
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasReferenceURL ;
                                 owl:someValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasCVEId ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ;
               rdfs:comment "Represents a disclosed security flaw affecting one or more software or hardware products. A vulnerability may include a textual description, publication date, severity metrics, affected platform definitions, and external references to advisories, patches, exploits, or vendor information."@en ;
               rdfs:label "Vulnerability"@en .


###  http://www.semanticweb.org/AMISecOnto/Weakness
:Weakness rdf:type owl:Class ;
          rdfs:comment "Represents the underlying software or design weakness that gives rise to a vulnerability, typically aligned with a controlled taxonomy such as CWE."@en ;
          rdfs:label "Weakness"@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty amiseconto:relatedToVulnerability ;
                            owl:someValuesFrom :Vulnerability
                          ] .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/AMISecOnto/Critical
:Critical rdf:type owl:NamedIndividual ,
                   :SeverityLevel .


###  http://www.semanticweb.org/AMISecOnto/High
:High rdf:type owl:NamedIndividual ,
               :SeverityLevel .


###  http://www.semanticweb.org/AMISecOnto/Low
:Low rdf:type owl:NamedIndividual ,
              :SeverityLevel .


###  http://www.semanticweb.org/AMISecOnto/Medium
:Medium rdf:type owl:NamedIndividual ,
                 :SeverityLevel .


